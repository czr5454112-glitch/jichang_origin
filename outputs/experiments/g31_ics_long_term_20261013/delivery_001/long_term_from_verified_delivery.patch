+"""Exercise whether unrelated private transport changes a local traversal version."""
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).absolute().parents[3]
+sys.path.insert(0, str(ROOT))
+from scripts.experiments.g31_ics_circulation.native_host import load_native, prepare_input, tiny_cycle
+
+
+def inputs():
+    plain = tiny_cycle()
+    plain["transfers"] = []
+    plain["jobs"] = [plain["jobs"][0]]
+    plain["jobs"][0]["arrival"] = 1
+    plain["node_records"] += [(7, 1, .01, 7, 0, [8]), (8, 1, .01, 8, 0, [7])]
+    plain["edge_records"] += [(7, 8, .01, 1), (8, 7, .01, 1)]
+    plain["node_contracts"] += [dict(node=n, zone="C", capacity=1) for n in (7, 8)]
+    plain["edge_contracts"] += [dict(zip(("from", "to", "capacity", "entry_headway"), (u, v, 1, .01)))
+                                for u, v in ((7, 8), (8, 7))]
+    plain["trays"].append(dict(tray_id="private-C-tray", node=7))
+    plain = prepare_input(plain)
+    private = deepcopy(plain)
+    private["jobs"].append(dict(business_bag_id="private-C-job", origin=7, destination=8, arrival=0,
+                                deadline=40, unload_seconds=.01, hold_seconds=0, load_seconds=.01))
+    return plain, private
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--binary", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--require-fixed", action="store_true")
+    args = p.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    result = {"schema": "g31.private_traversal_counter_probe.v1", "binary": str(args.binary.absolute()),
+              "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(), "variants": []}
+    try:
+        native = load_native(args.binary)
+        for private_transport, data in zip((False, True), inputs()):
+            s = native.NativeSession(data)
+            s.advance_to(.5)
+            before = s.observe("A")
+            s.advance_to(1.2)
+            result["variants"].append({"private_C_transport": private_transport, "input": data,
+                                       "A_before": before, "A_after": s.observe("A")})
+        a, b = result["variants"]
+        result["before_equal"] = a["A_before"] == b["A_before"]
+        result["after_equal"] = a["A_after"] == b["A_after"]
+        result["fixed"] = result["before_equal"] and result["after_equal"]
+        result["status"] = "passed" if result["fixed"] else "reproduced_private_traversal_counter_leak"
+    except Exception as error:
+        result["status"] = "execution_error"
+        result["exception"] = repr(error)
+        raise
+    finally:
+        (args.output / "receipt.json").write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps({k: result[k] for k in ("status", "before_equal", "after_equal")}))
+    return int(args.require_fixed and not result["fixed"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/regional_control.py b/scripts/experiments/g31_ics_circulation/regional_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/regional_control.py
@@ -0,0 +1,172 @@
+"""Owner-local on-demand routing and a versioned system A* intent codec.
+
+Only public observations are consumed. The packet is a replaceable preference,
+never a reservation, inventory record or permission to undo an entered edge.
+"""
+from __future__ import annotations
+from dataclasses import asdict, dataclass
+import heapq
+import json
+import math
+import time
+from typing import Any
+
+
+@dataclass(frozen=True)
+class RoutePacket:
+    schema: str
+    business_bag_id: str
+    tray_id: str
+    owner_id: str
+    generation: int
+    traversal_id: int
+    stage: str
+    stage_goal: int
+    committed_prefix: tuple[int, ...]
+    replaceable_suffix: tuple[int, ...]
+    observed_at: float
+
+
+def encode_route(packet: RoutePacket) -> str:
+    if packet.schema != "g31.route_intent.v1" or not packet.replaceable_suffix or not packet.committed_prefix:
+        raise ValueError("route_codec:invalid_packet")
+    if packet.committed_prefix[-1] != packet.replaceable_suffix[0] or packet.replaceable_suffix[-1] != packet.stage_goal:
+        raise ValueError("route_codec:prefix_or_stage_mismatch")
+    return json.dumps(asdict(packet),sort_keys=True,separators=(",",":"),allow_nan=False)
+
+
+def decode_route(payload: str) -> RoutePacket:
+    data=json.loads(payload)
+    data["committed_prefix"]=tuple(data["committed_prefix"])
+    data["replaceable_suffix"]=tuple(data["replaceable_suffix"])
+    packet=RoutePacket(**data)
+    encode_route(packet)
+    return packet
+
+
+def public_astar(observation: dict[str, Any], source: int, goal: int) -> tuple[int, ...]:
+    """A* with exact static lower bound and declared local berth penalty.
+
+    Dynamic penalties use local occupancy only. Remote live queues do not exist
+    in this projection. This is a deterministic strong baseline, not novelty.
+    """
+    contracts={n["node"]:n for n in observation["node_contracts"]}
+    service={n[0]:max(n[2],.001) for n in observation["node_records"]}
+    closed={(e["from"],e["to"]) for e in observation["edge_contracts"] if e["capacity"]==0}
+    closed.update((f["from"],f["to"]) for f in observation.get("known_faults",[]) if f["active"])
+    outgoing={n:[] for n in contracts}; incoming={n:[] for n in contracts}
+    for u,v,length,speed in observation["edge_records"]:
+        if (u,v) in closed: continue
+        cost=service[u]+max(length/speed,.001)
+        outgoing[u].append((v,cost));incoming[v].append((u,cost))
+    h={goal:0.};queue=[(0.,goal)]
+    while queue:
+        cost,node=heapq.heappop(queue)
+        if cost!=h[node]:continue
+        for predecessor,weight in incoming[node]:
+            new=cost+weight
+            if new<h.get(predecessor,math.inf):
+                h[predecessor]=new;heapq.heappush(queue,(new,predecessor))
+    if source not in h:return ()
+    queue=[(h[source],0.,(source,),source)];best={source:0.}
+    while queue:
+        _,cost,path,node=heapq.heappop(queue)
+        if cost!=best[node]:continue
+        if node==goal:return path
+        for successor,weight in outgoing[node]:
+            if successor not in h:continue
+            local=contracts[successor]
+            penalty=max(0,local.get("occupancy",0))*service[successor]
+            new=cost+weight+penalty
+            if new<best.get(successor,math.inf):
+                best[successor]=new
+                heapq.heappush(queue,(new+h[successor],new,path+(successor,),successor))
+    return ()
+
+
+def make_route_packet(observation: dict[str, Any], tray_id: str) -> RoutePacket:
+    tray=next((t for t in observation["trays"] if t["tray_id"]==tray_id),None)
+    if tray is None:raise ValueError("route:tray_not_visible")
+    if tray["edge_to"]>=0:raise ValueError("route:committed_edge_cannot_be_replaced")
+    job=next((j for j in observation["jobs"] if j["business_bag_id"]==tray["business_bag_id"]),None)
+    if job is None or not job["allow_suffix_reroute"]:raise ValueError("route:service_obligation_disallows_reroute")
+    if tray["mode"]!="loaded":raise ValueError("route:no_active_route_stage")
+    storage=job.get("storage_node",-1)
+    before_storage=storage>=0 and job.get("storage_released_at",-1)<0
+    goal=storage if before_storage else job["destination"]
+    path=public_astar(observation,tray["node"],goal)
+    if len(path)<2:raise ValueError("route:no_safe_public_continuation")
+    return RoutePacket("g31.route_intent.v1",job["business_bag_id"],tray_id,observation["owner_id"],
+                       tray["generation"],tray["traversal_id"],"storage_in" if before_storage else "storage_out_or_direct",
+                       goal,tuple(tray.get("committed_prefix",[tray["node"]])),path,observation["now"])
+
+
+def submit_on_demand(session, owner_id: str, tray_id: str, request_id: str, *,
+                     message_delay: float=0., logical_compute_delay: float=0., lease_seconds: float=5.) -> dict[str, Any]:
+    """Queue completion at a native event time; delayed state can invalidate it.
+
+    Measured CPU/wall compute is distinct from declared deterministic processing
+    delay. Owner delivery/revalidation must be measured separately for a full
+    100ms claim; this routine deliberately does not make that claim.
+    """
+    if not all(math.isfinite(x) and x>=0 for x in (message_delay,logical_compute_delay,lease_seconds)):
+        raise ValueError("route:invalid_delay")
+    start=time.perf_counter();cpu=time.process_time()
+    observation=session.observe(owner_id)
+    try:
+        packet=make_route_packet(observation,tray_id)
+        decoded=decode_route(encode_route(packet))
+        request={"request_id":request_id,"owner_id":owner_id,"business_bag_id":decoded.business_bag_id,
+                 "tray_id":tray_id,"from":decoded.replaceable_suffix[0],"next":decoded.replaceable_suffix[1],
+                 "expected_generation":decoded.generation,"expected_traversal":decoded.traversal_id,
+                 "expiry":observation["now"]+lease_seconds,"message_delay":message_delay+logical_compute_delay}
+        response=session.submit_route_intent(request)
+        payload=encode_route(packet)
+    except ValueError as exc:
+        response={"status":"rejected","reason":str(exc)};request=None;payload=None
+    return {"response":response,"request":request,"encoded_route":payload,
+            "submission_compute_ms":(time.perf_counter()-start)*1000,
+            "submission_cpu_ms":(time.process_time()-cpu)*1000,
+            "logical_compute_delay":logical_compute_delay,"message_delay":message_delay,
+            "timing_scope":"observe+conversion+candidate A*+codec+submit; delivery owner compute excluded",
+            "complete_100ms_requirement_certified":False}
+
+
+def complete_on_demand(session, owner_id: str, tray_id: str, request_id: str, *,
+                       message_delay: float=0., logical_compute_delay: float=0.,
+                       lease_seconds: float=5., event_budget: int=100000) -> dict[str, Any]:
+    """Measure one complete synchronous *simulation experiment* request chain.
+
+    This drives the existing native session only to the declared completion
+    message time, then reads the actual owner response. All simulated physical
+    event work in that interval is charged too: measured wall/CPU is therefore
+    a conservative compute scope, not a pure policy timing or deployment SLA.
+    It must not be nested in an external controller without preserving that
+    controller's intervening ticks. Network delay is logical and separately
+    recorded; no claim is made that wall-clock physical equipment was running.
+    """
+    start=time.perf_counter();cpu=time.process_time();physical_start=session.physical_time
+    submitted=submit_on_demand(session,owner_id,tray_id,request_id,
+        message_delay=message_delay,logical_compute_delay=logical_compute_delay,lease_seconds=lease_seconds)
+    progress=None
+    if submitted["response"]["status"]=="pending":
+        progress=session.advance_to(physical_start+logical_compute_delay+message_delay,max_events=event_budget)
+        actual=next((r for r in session.observe(owner_id)["route_requests"] if r["request_id"]==request_id),None)
+        if actual is None or actual["status"]=="pending":
+            final={"status":"timeout_unknown","reason":"owner_completion_not_observed"}
+        else:
+            final=actual
+    else:
+        final=submitted["response"]
+    # Include response serialization/deserialization in the measured path.
+    final=json.loads(json.dumps(final,allow_nan=False))
+    wall_ms=(time.perf_counter()-start)*1000;cpu_ms=(time.process_time()-cpu)*1000
+    return {"submission":submitted,"final_response":final,"advance":progress,
+            "compute_wall_ms":wall_ms,"compute_cpu_ms":cpu_ms,
+            "meets_measured_100ms":wall_ms<=100.,"overrun_is_failure":wall_ms>100.,
+            "physical_started_at":physical_start,"physical_finished_at":session.physical_time,
+            "logical_network_delay_seconds":message_delay,
+            "logical_processing_delay_seconds":logical_compute_delay,
+            "timing_scope":"observe+conversion+A*+codec+submit+all intervening native events including owner revalidation+confirmation+response codec",
+            "hard_realtime_guarantee":False,"complete_100ms_requirement_certified":False,
+            "limits":"single-process synthetic/request sample; modeled network wait; external controller ticks not automatically replayed"}
diff --git a/scripts/experiments/g31_ics_circulation/run_original_control.py b/scripts/experiments/g31_ics_circulation/run_original_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/run_original_control.py
@@ -0,0 +1,146 @@
+"""Budgeted original-map R2 controls through one persistent native G31 host.
+
+This uses the existing same-information analytic baseline without manufacturing
+return requests. The source denominator never changes; disk/wall/event budgets
+produce explicit censoring, not completion or physical-infeasibility claims.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import gzip
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .native_host import audit_result, load_native
+from .original_workload import (
+    DEFAULT_MAP, ProxyContract, build_input, digest, return_contract_diagnostics,
+    source_map, static_diagnostics, summarize_execution, verify_source_map, write_json,
+)
+from .validate_analytic_control import replay_input
+
+
+def execute(args) -> dict:
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("original_workload.py")]
+    receipt = {"schema": "g31.original_online_control.v1", "status": "running",
+        "source_before": {str(p): digest(p) for p in paths},
+        "binary_sha256": digest(args.binary), "predictive": args.predictive,
+        "respect_service_forecasts": args.service_forecasts,
+        "control_period": args.control_period, "horizon": args.horizon,
+        "wall_budget_seconds": args.wall_budget, "max_events": args.max_events,
+        "scope": "same native original-map input and lawful owner observations; analytic R2 baseline, no R1 protection certificate or main-method innovation",
+        "complete_100ms_requirement_certified": False}
+    write_json(args.output/"receipt.json", receipt)
+    started = time.perf_counter()
+    try:
+        contract = ProxyContract(f"nanning-on-carrier-proxy-v1-n4-s{args.storage_berths}-t2",
+                                4, args.storage_berths, 2, 1., 1., 0.,
+                                "finite_berth_waiting_research_proxy")
+        data, manifest, crosswalk = build_input(scale=args.scale, contract=contract,
+            horizon=args.horizon, max_events=args.max_events, trace_limit=0)
+        write_json(args.output/"input_manifest.json", manifest)
+        profile = json.loads(DEFAULT_MAP.read_text(encoding="utf-8"))
+        write_json(args.output/"source_workbooks.json", verify_source_map(profile, source_map.default_source_dir()))
+        write_json(args.output/"static_diagnostics.json", static_diagnostics(data))
+        write_json(args.output/"return_contract_diagnostics.json", return_contract_diagnostics(data))
+        with gzip.open(args.output/"business_crosswalk.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for row in crosswalk:
+                stream.write(json.dumps(row, sort_keys=True)+"\n")
+        owners = sorted({n["resource_owner"] for n in data["node_contracts"]})
+        session = load_native(args.binary).NativeSession(data)
+        state, submitted, compute_ms = None, [], []
+        tick = 0
+        reason = "common_horizon_reached"
+        with (args.output/"control_steps.jsonl").open("w", encoding="utf-8") as stream:
+            while True:
+                target = min(tick*args.control_period, args.horizon)
+                chunk_started = time.perf_counter()
+                run = run_online_matching(session, owners, horizon=target,
+                    predictive=args.predictive, control_period=args.control_period,
+                    message_delay=args.message_delay, demand_delay=args.demand_delay,
+                    respect_service_forecasts=args.service_forecasts, controller_state=state)
+                state = run["controller_state"]
+                submitted.extend(run["submitted"])
+                rows = []
+                for record in run["control_records"]:
+                    decision = record["decision"]
+                    compute_ms.append(record["compute_ms"])
+                    rows.append({"owner_id": record["owner_id"], "compute_ms": record["compute_ms"],
+                        "compute_parts_ms": record.get("compute_parts_ms", {}),
+                        "candidate_pairs": len(decision["pool"]), "supplies": len(decision["supplies"]),
+                        "demands": len(decision["demands"]), "intents": len(decision["intents"]),
+                        "forecast_ledgers": dict(Counter(f["ledger"] for f in decision["forecasts"])),
+                        "reply_statuses": dict(Counter(r["status"] for r in record["replies"]))})
+                result = run["result"]
+                summary = summarize_execution(data, result)
+                stream.write(json.dumps({"tick": tick, "target": target, "status": run["status"],
+                    "actual_clock": session.physical_time, "event_count": summary["native_summary"]["event_count"],
+                    "observed": summary["observed"], "completed": summary["completed"], "loaded": summary["loaded"],
+                    "chunk_wall_seconds": time.perf_counter()-chunk_started,
+                    "owner_computations": rows, "submitted": run["submitted"]})+"\n")
+                stream.flush()
+                if run["status"] != "reached":
+                    reason = "native_event_budget_censored"
+                    break
+                if target == args.horizon:
+                    break
+                if time.perf_counter()-started >= args.wall_budget:
+                    reason = "wall_budget_censored_at_completed_control_boundary"
+                    break
+                tick += 1
+        receipt["stop_reason"] = reason
+        receipt["status"] = "reached" if summary["horizon_reached"] else "censored"
+        receipt["offline_final_state_sha256"] = session.offline_state_sha256()
+        receipt["control_compute_ms"] = {"count": len(compute_ms), "max": max(compute_ms, default=0.),
+            "sum": sum(compute_ms), "scope": run["timing_scope"]}
+        write_json(args.output/"summary.json", summary)
+        write_json(args.output/"event_audit.json", audit_result(replay_input(data, submitted), result))
+        write_json(args.output/"submitted_requests.json", submitted)
+        with gzip.open(args.output/"controller_state.json.gz", "wt", encoding="utf-8") as stream:
+            json.dump(state, stream)
+        with gzip.open(args.output/"business_results.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for job in result["jobs"]:
+                stream.write(json.dumps(job)+"\n")
+        with gzip.open(args.output/"physical_events.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for event in result["receipts"]:
+                stream.write(json.dumps(event)+"\n")
+        # Native checkpoints remain process-bound; never label the controller
+        # JSON as an independently restorable physical checkpoint.
+        receipt["continuation_boundary"] = {"physical_time": session.physical_time,
+            "native_session_persisted": False, "rerun_required_after_process_exit": True}
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["wall_seconds"] = time.perf_counter()-started
+    receipt["source_changed"] = [str(p) for p in paths if digest(p) != receipt["source_before"][str(p)]]
+    write_json(args.output/"receipt.json", receipt)
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--scale", type=int, choices=(1, 2), default=1)
+    parser.add_argument("--horizon", type=float, default=86400.)
+    parser.add_argument("--control-period", type=float, default=300.)
+    parser.add_argument("--message-delay", type=float, default=2.)
+    parser.add_argument("--demand-delay", type=float, default=.5)
+    parser.add_argument("--max-events", type=int, default=100000)
+    parser.add_argument("--storage-berths", type=int, default=4)
+    parser.add_argument("--wall-budget", type=float, default=120.)
+    parser.add_argument("--predictive", action="store_true")
+    parser.add_argument("--service-forecasts", action="store_true")
+    args = parser.parse_args()
+    receipt = execute(args)
+    print(json.dumps(receipt, indent=2))
+    return int(receipt["status"] == "failed" or bool(receipt["source_changed"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/single_tray_lower_bound.py b/scripts/experiments/g31_ics_circulation/single_tray_lower_bound.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/single_tray_lower_bound.py
@@ -0,0 +1,235 @@
+"""Offline optimistic lower bound for one tray, one FIFO loading origin.
+
+This is a relaxation of the declared on-carrier native contract, not another
+physical simulator, an executable schedule, an online feature, or a new method.
+"""
+from __future__ import annotations
+import argparse
+from collections import defaultdict
+import gzip
+import hashlib
+import heapq
+import json
+import math
+from pathlib import Path
+
+from .native_host import audit_result
+from .finite_reference import outcome_cost
+from .validate_analytic_control import replay_input, write
+
+
+def fifo_travel_bound(data: dict, horizon: float) -> dict:
+    """Inductive bound on a fixed, physically forced one-tray FIFO sequence.
+
+    C_i >= unload_i + d(S_i,D_i) +
+      max(release_i, max(arrival_i,C_(i-1)+hold_(i-1)+d(D_(i-1),O))
+          + load_i + d(O,S_i) + min_dwell_i).
+    Direct jobs omit Storage. For job 1 the initial empty tray is at O at t=0.
+    Node service, congestion, receiving/headway waits and message delays are
+    all omitted; adding any unforced wait would invalidate a lower bound.
+    """
+    if not math.isfinite(horizon) or horizon < 0:
+        raise ValueError("single_tray_bound:invalid_horizon")
+    jobs = data["jobs"]
+    if len(data["trays"]) != 1 or not jobs:
+        raise ValueError("single_tray_bound:requires_one_tray_nonempty_jobs")
+    origin_set = {j["origin"] for j in jobs}
+    if len(origin_set) != 1:
+        raise ValueError("single_tray_bound:requires_one_fifo_origin")
+    origin = next(iter(origin_set))
+    tray = data["trays"][0]
+    if tray["node"] != origin or tray.get("mode", "empty") != "empty":
+        raise ValueError("single_tray_bound:requires_initial_empty_tray_at_loader")
+    if len({j["business_bag_id"] for j in jobs}) != len(jobs):
+        raise ValueError("single_tray_bound:duplicate_business_identity")
+    # A simultaneous arrival can be loaded before another same-time arrival
+    # event is observed. This narrow bound declines that ambiguity rather than
+    # asserting a lexical priority unsupported by the event processing order.
+    if len({j["arrival"] for j in jobs}) != len(jobs):
+        raise ValueError("single_tray_bound:simultaneous_arrivals_outside_proven_scope")
+    if data.get("options", {}).get("queue_discipline", "fifo") != "fifo":
+        raise ValueError("single_tray_bound:non_fifo_contract")
+    if data.get("options", {}).get("complete_on_goal_arrival", False):
+        raise ValueError("single_tray_bound:unsupported_completion_contract")
+    if any(not math.isfinite(j["arrival"]) or j["arrival"] < 0 or j["arrival"] > horizon for j in jobs):
+        raise ValueError("single_tray_bound:all_jobs_must_be_offered_by_horizon")
+    ordered = sorted(jobs, key=lambda j: (j["arrival"], j["business_bag_id"]))
+    capacities = {(int(e["from"]), int(e["to"])): int(e["capacity"]) for e in data["edge_contracts"]}
+    nodes = {int(n["node"]): n for n in data["node_contracts"]}
+    if any(int(n["capacity"]) <= 0 for n in nodes.values()):
+        raise ValueError("single_tray_bound:zero_node_capacity_outside_proven_scope")
+    graph = defaultdict(list)
+    for u, v, length, speed in data["edge_records"]:
+        if not all(math.isfinite(x) for x in (length, speed)) or length < 0 or speed <= 0:
+            raise ValueError("single_tray_bound:invalid_edge_travel")
+        if (u, v) not in capacities:
+            raise ValueError("single_tray_bound:missing_edge_capacity_contract")
+        if capacities[u, v] > 0:
+            # Native minimum-travel rounding is nonnegative and may safely be
+            # relaxed; use the original length/speed rather than inventing it.
+            graph[u].append((v, float(length)/float(speed)))
+    cache = {}
+    def shortest(source, target):
+        key = source, target
+        if key in cache:
+            return cache[key]
+        queue = [(0., source, (source,))]
+        best = {source: 0.}
+        while queue:
+            value, node, path = heapq.heappop(queue)
+            if value > best[node]:
+                continue
+            if node == target:
+                cache[key] = value, list(path)
+                return cache[key]
+            for next_node, travel in graph[node]:
+                cost = value + travel
+                if cost < best.get(next_node, math.inf):
+                    best[next_node] = cost
+                    heapq.heappush(queue, (cost, next_node, path+(next_node,)))
+        raise ValueError(f"single_tray_bound:no_positive_capacity_directed_path:{source}:{target}")
+
+    rows, ready = [], 0.
+    for index, job in enumerate(ordered):
+        for field in ("load_seconds", "unload_seconds", "hold_seconds", "storage_min_dwell", "storage_release_at"):
+            value = job.get(field, 0.)
+            if not isinstance(value, (float, int)) or not math.isfinite(value) or value < 0:
+                raise ValueError("single_tray_bound:invalid_physical_duration_or_release")
+        start = max(float(job["arrival"]), ready)
+        loaded = start + job.get("load_seconds", 0.)
+        destination = int(job["destination"])
+        storage = int(job.get("storage_node", -1))
+        storage_arrival, release = None, None
+        if storage >= 0:
+            first_time, first_path = shortest(origin, storage)
+            last_time, last_path = shortest(storage, destination)
+            storage_arrival = loaded + first_time
+            release = max(storage_arrival + job.get("storage_min_dwell", 0.), job.get("storage_release_at", 0.))
+            finish = release + last_time + job.get("unload_seconds", 0.)
+            paths = {"loaded_to_storage": first_path, "storage_to_destination": last_path}
+        else:
+            last_time, last_path = shortest(origin, destination)
+            finish = loaded + last_time + job.get("unload_seconds", 0.)
+            paths = {"loaded_direct": last_path}
+        return_time, return_path = shortest(destination, origin) if index+1 < len(ordered) else (0., [])
+        # No return is required after the final business completion. Do not
+        # label its terminal hold completion as arrival back at the loader.
+        ready = finish + job.get("hold_seconds", 0.) + return_time if index+1 < len(ordered) else None
+        deadline = float(job.get("deadline", -1.))
+        rows.append({"sequence": index+1, "business_bag_id": job["business_bag_id"], "tray_id": tray["tray_id"],
+            "arrival": job["arrival"], "deadline": deadline, "origin": origin, "destination": destination,
+            "load_start_lower_bound": start, "load_complete_lower_bound": loaded,
+            "storage_entry_lower_bound": storage_arrival, "storage_release_lower_bound": release,
+            "completion_lower_bound": finish, "next_loader_ready_lower_bound": ready,
+            "hold_seconds": job.get("hold_seconds", 0.), "return_travel_lower_bound": return_time,
+            "positive_capacity_directed_paths": dict(paths, return_to_loader=return_path),
+            "restricted_sojourn_lower_bound": min(horizon, finish)-job["arrival"],
+            "unavoidable_deadline_miss": deadline >= 0 and finish > deadline+1e-8})
+    return {"schema": "g31.single_tray_fifo_travel_lower_bound.v1", "status": "bounded_relaxation",
+        "scope": "one initially empty tray at one FIFO loader; distinct arrivals; on-carrier Storage; all specified jobs",
+        "horizon": horizon, "offered": len(rows), "rows": rows,
+        "restricted_sojourn_lower_bound": sum(r["restricted_sojourn_lower_bound"] for r in rows),
+        "minimum_deadline_misses": sum(r["unavoidable_deadline_miss"] for r in rows),
+        "deadline_count_scope": "necessary eventual deadline misses; also by-H violations only when all declared deadlines are at or before H",
+        "all_declared_deadlines_at_or_before_horizon": all(r["deadline"] < 0 or r["deadline"] <= horizon for r in rows),
+        "relaxed_nonnegative_terms": ["node service", "receiving/congestion/headway waits", "control compute and message delays", "fault waiting"],
+        "not_claimed": ["feasible schedule", "attainable optimum", "multi-tray bound", "full mother-stream bound", "online score", "method novelty"]}
+
+
+def check_actual(bound: dict, result: dict, data: dict) -> dict:
+    expected = [r["business_bag_id"] for r in bound["rows"]]
+    loading = [r for r in result["receipts"] if r["event"] == "LOAD_START"]
+    if [r["business_bag_id"] for r in loading] != expected:
+        raise ValueError("single_tray_bound:actual_loading_sequence_does_not_match_proven_fifo_scope")
+    tray_id = data["trays"][0]["tray_id"]
+    if any(r["tray_id"] != tray_id for r in loading):
+        raise ValueError("single_tray_bound:actual_second_tray")
+    completed = {j["business_bag_id"]: j for j in result["jobs"]}
+    gaps = []
+    for row in bound["rows"]:
+        job = completed[row["business_bag_id"]]
+        actual = job["completed_at"]
+        if actual < 0:
+            raise ValueError("single_tray_bound:actual_comparison_requires_all_jobs_completed")
+        if actual+1e-7 < row["completion_lower_bound"]:
+            raise ValueError("single_tray_bound:bound_exceeds_actual_completion")
+        gaps.append({"business_bag_id": row["business_bag_id"], "completion_at": actual,
+                     "completion_lower_bound": row["completion_lower_bound"],
+                     "completion_gap_seconds": actual-row["completion_lower_bound"]})
+    metrics = outcome_cost(result, data["jobs"], bound["horizon"])
+    return {"metrics": metrics, "actual_fifo_order_verified": True,
+            "all_jobs_at_or_after_lower_bound": True, "rows": gaps,
+            "restricted_sojourn_gap_to_lower_bound": metrics["cost"]-bound["restricted_sojourn_lower_bound"],
+            "relative_gap_of_actual_cost": (metrics["cost"]-bound["restricted_sojourn_lower_bound"])/metrics["cost"],
+            "actual_deadline_misses": metrics["deadline_violations"]}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--mechanism", required=True, type=Path)
+    parser.add_argument("--reference", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    load = lambda p: json.loads(p.read_text(encoding="utf-8"))
+    data = load(args.mechanism/"input.json")
+    if data != load(args.reference/"input.json"):
+        raise ValueError("single_tray_bound:reference_physical_input_differs")
+    horizon = float(data["options"]["max_simulation_time"])
+    bound = fifo_travel_bound(data, horizon)
+    crosswalk_path = args.mechanism/"mother_crosswalk_selection.jsonl.gz"
+    with gzip.open(crosswalk_path, "rt", encoding="utf-8") as source:
+        crosswalk = [json.loads(line) for line in source]
+    selected = {r["business_bag_id"]: r for r in crosswalk if r["selected_for_witness"]}
+    if set(selected) != {r["business_bag_id"] for r in bound["rows"]}:
+        raise ValueError("single_tray_bound:selected_crosswalk_does_not_cover_exact_input")
+    for row in bound["rows"]:
+        row["mother_crosswalk"] = selected[row["business_bag_id"]]
+    comparisons, audits = {}, {}
+    event_table = load(args.mechanism/"actual_same_tray_event_table.json")
+    artifacts = [args.mechanism/"input.json", args.mechanism/"selection.json", crosswalk_path,
+                 args.mechanism/"actual_same_tray_event_table.json", args.reference/"input.json",
+                 args.reference/"finite_reference_raw.json.gz", args.reference/"public_boundary_and_domain.json",
+                 Path(__file__), Path("cpp/ics_core/runtime/circulation_runtime_impl.hpp")]
+    for policy in ("reactive", "predictive"):
+        path = args.mechanism/f"{policy}_raw.json.gz"; artifacts.append(path)
+        with gzip.open(path, "rt", encoding="utf-8") as source:
+            run = json.load(source)
+        if hashlib.sha256(path.read_bytes()).hexdigest() != event_table["source_hashes"][path.name]:
+            raise ValueError("single_tray_bound:actual_event_table_source_hash_mismatch")
+        result = run["result"]
+        comparisons[policy] = check_actual(bound, result, data)
+        table_rows = event_table["policies"][policy]["rows"]
+        if [r["business_bag_id"] for r in table_rows] != [r["business_bag_id"] for r in bound["rows"]]:
+            raise ValueError("single_tray_bound:actual_event_table_order_mismatch")
+        outcomes = {j["business_bag_id"]: j for j in result["jobs"]}
+        if any(abs(r["unload_complete_at"]-outcomes[r["business_bag_id"]]["completed_at"]) > 1e-8 for r in table_rows):
+            raise ValueError("single_tray_bound:actual_event_table_time_mismatch")
+        audits[policy] = audit_result(replay_input(data, run["submitted"]), result)
+    with gzip.open(args.reference/"finite_reference_raw.json.gz", "rt", encoding="utf-8") as source:
+        reference = json.load(source)
+    original_boundary = load(args.reference/"public_boundary_and_domain.json")
+    for row in reference["rows"]:
+        result, action = row["result"], row["action"]
+        if result["advance"].get("horizon_complete") is not True or result["physical_clock"] != horizon:
+            raise ValueError("single_tray_bound:reference_horizon_incomplete")
+        name = "native006_first_return_reference:"+action["action_id"]
+        comparisons[name] = check_actual(bound, result, data)
+        submitted = original_boundary["prefix_submitted"]+result["offline_continuation_submitted"]
+        if action["kind"] == "transfer":
+            submitted += [{"request": action["request"], "reply": {"status": "pending"}}]
+        audits[name] = audit_result(replay_input(data, submitted), result)
+    receipt = {"schema": "g31.single_tray_lower_bound_audit.v1", "status": "passed", "bound": bound,
+        "comparisons": comparisons, "independent_physical_audits": audits,
+        "source_sha256": {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in artifacts},
+        "mother_crosswalk_rows_preserved_by_reference": len(crosswalk),
+        "proof": "Unique physical tray remains loaded through Storage until unloading. Automatic loader grants oldest observed arrival before discretionary export. Distinct arrivals and common loader force the sorted sequence; every observed actual LOAD_START matches it. Induction: every actual nonnegative travel/wait is at least the positive-capacity directed free-travel bound; mandatory load, unload, hold, Storage absolute release and dwell remain.",
+        "claim_boundary": "Offline bound for all 24 jobs of this separate one-tray mechanism factor only. It neither excuses deadline misses nor changes requirements; optimistic gap is not certified achievable headroom or global optimality."}
+    write(args.output/"receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "offered": bound["offered"],
+        "lower_bound": bound["restricted_sojourn_lower_bound"], "minimum_deadline_misses": bound["minimum_deadline_misses"],
+        "actual_costs": {k:v["metrics"]["cost"] for k,v in comparisons.items()}}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/summarize_original_evidence.py b/scripts/experiments/g31_ics_circulation/summarize_original_evidence.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/summarize_original_evidence.py
@@ -0,0 +1,74 @@
+"""Derive reviewable same-tray event rows from saved native receipts."""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+from pathlib import Path
+
+from .original_workload import digest, write_json
+
+
+def summarize(folder: Path) -> dict:
+    data = json.loads((folder / "input.json").read_text(encoding="utf-8"))
+    jobs = {job["business_bag_id"]: job for job in data["jobs"]}
+    result = {"schema": "g31.original_actual_event_table.v1", "source_hashes": {},
+              "time_unit": "seconds on original source simulation clock",
+              "scope": "same-source mechanism witness; full-flow negative is separate", "policies": {}}
+    for policy in ("reactive", "predictive"):
+        path = folder / f"{policy}_raw.json.gz"
+        result["source_hashes"][path.name] = digest(path)
+        with gzip.open(path, "rt", encoding="utf-8") as stream:
+            run = json.load(stream)
+        events = run["result"]["receipts"]
+        rows = []
+        for load in (event for event in events if event["event"] == "LOAD_START"):
+            bag, tray, start = load["business_bag_id"], load["tray_id"], load["time"]
+            relevant = [event for event in events if event["business_bag_id"] == bag
+                        and event["tray_id"] == tray]
+            times = {name: next((event["time"] for event in relevant if event["event"] == name), None)
+                     for name in ("STORAGE_ENTER", "STORAGE_RELEASE", "UNLOAD_COMPLETE", "HOLD_COMPLETE")}
+            incoming = [event for event in events if event["event"] == "EMPTY_RECEIVED"
+                        and event["tray_id"] == tray and event["time"] <= start + 1e-8]
+            received = incoming[-1] if incoming else None
+            exported = next((event for event in events if event["event"] == "EXPORT_GRANTED"
+                             and received and event["reason"] == received["reason"]), None)
+            rows.append({"sequence": len(rows) + 1, "business_bag_id": bag, "tray_id": tray,
+                         "source_arrival": jobs[bag]["arrival"], "source_deadline": jobs[bag]["deadline"],
+                         "origin": jobs[bag]["origin"], "destination": jobs[bag]["destination"],
+                         "preceding_export_at": exported["time"] if exported else None,
+                         "preceding_empty_received_at": received["time"] if received else None,
+                         "preceding_return_transport_leg_id": received["transport_leg_id"] if received else None,
+                         "load_at": start, **{name.lower() + "_at": value for name, value in times.items()},
+                         "on_time": times["UNLOAD_COMPLETE"] is not None and
+                                    times["UNLOAD_COMPLETE"] <= jobs[bag]["deadline"] + 1e-8})
+        result["policies"][policy] = {"offered": len(jobs), "loaded": len(rows), "rows": rows,
+            "completed": sum(row["unload_complete_at"] is not None for row in rows),
+            "on_time": sum(row["on_time"] for row in rows),
+            "empty_received": sum(event["event"] == "EMPTY_RECEIVED" for event in events)}
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("folder", type=Path)
+    args = parser.parse_args()
+    result = summarize(args.folder)
+    write_json(args.folder / "actual_same_tray_event_table.json", result)
+    text = ["# 原图同盘实际事件账", "", "时刻单位：原来源模拟时钟秒。全部数值由 native receipts 提取，完整业务身份和返程 leg ID 见同名 JSON。单盘独立机制组不能替代完整流负例。", ""]
+    fmt = lambda value: "—" if value is None else f"{value:.3f}"
+    for policy, summary in result["policies"].items():
+        text += [f"## {policy}", "", f"{summary['completed']}/{summary['offered']} 完成，{summary['on_time']} 按时；真实返供 {summary['empty_received']} 次。托盘身份始终为 initial:26:0。", "",
+                 "| 次序/源袋 | 前次导出 | 空盘实际接收 | 本次装载 | 入 Storage | 实际释放 | 实际卸载 | 截止 | 按时 |",
+                 "|---|---:|---:|---:|---:|---:|---:|---:|---|"]
+        for row in summary["rows"]:
+            values = [row[name] for name in ("preceding_export_at", "preceding_empty_received_at", "load_at", "storage_enter_at", "storage_release_at", "unload_complete_at", "source_deadline")]
+            text.append(f"| {row['sequence']} / {row['business_bag_id']} | " + " | ".join(map(fmt, values)) + f" | {'是' if row['on_time'] else '否'} |")
+        text.append("")
+    (args.folder / "actual_same_tray_event_table.md").write_text("\n".join(text), encoding="utf-8")
+    print(json.dumps({policy: {k: v for k, v in summary.items() if k != "rows"}
+                      for policy, summary in result["policies"].items()}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_all_native.py b/scripts/experiments/g31_ics_circulation/validate_all_native.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_all_native.py
@@ -0,0 +1,64 @@
+"""Clean-build all registered native CTest programs; no pybind or legacy overwrite."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import time
+
+ROOT=Path(__file__).absolute().parents[3]
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output",type=Path,required=True)
+    parser.add_argument("--vcvars",type=Path,required=True)
+    parser.add_argument("--ninja",type=Path,required=True)
+    args=parser.parse_args()
+    out=args.output.absolute();out.mkdir(parents=True,exist_ok=False)
+    build=ROOT/"build_lt_native_compat"/out.name;build.mkdir(parents=True,exist_ok=False)
+    files=sorted([ROOT/"CMakeLists.txt",*(p for p in ROOT.glob("cpp/**/*.hpp") if "bindings" not in p.parts),
+                  *(p for p in ROOT.glob("cpp/**/*.cpp") if "bindings" not in p.parts)])
+    snapshot=lambda:{p.relative_to(ROOT).as_posix():sha(p) for p in files}
+    receipt={"schema":"g31.circulation.all_native_validation.v1","status":"started",
+             "source_before":snapshot(),"commands":[],"build_root":str(build),"clean_first":True}
+    cmake=shutil.which("cmake");ctest=shutil.which("ctest")
+    commands=[[cmake,"-S",str(ROOT),"-B",str(build),"-G","Ninja",
+               "-DCMAKE_BUILD_TYPE=Release","-DCMAKE_TRY_COMPILE_CONFIGURATION=Release",
+               "-DCZR005_BUILD_PYBIND=OFF","-DCMAKE_MAKE_PROGRAM="+str(args.ninja.absolute())],
+              [cmake,"--build",str(build),"--clean-first","--parallel","2"],
+              [ctest,"--test-dir",str(build),"--output-on-failure","--output-junit",str(out/"junit.xml")]]
+    started=time.perf_counter()
+    try:
+        for i,command in enumerate(commands):
+            script=out/f"command_{i:02}.cmd"
+            script.write_text('@echo off\ncall "'+str(args.vcvars.absolute())+'"\n'
+                              'if errorlevel 1 exit /b %errorlevel%\n'+subprocess.list2cmdline(command)+
+                              '\nexit /b %errorlevel%\n',encoding="utf-8")
+            actual=["cmd.exe","/c",str(script)]
+            with (out/f"command_{i:02}.stdout.log").open("wb") as stdout,(out/f"command_{i:02}.stderr.log").open("wb") as stderr:
+                result=subprocess.run(actual,cwd=ROOT,stdout=stdout,stderr=stderr,check=False)
+            receipt["commands"].append({"argv":command,"actual_argv":actual,"exit_code":result.returncode})
+            if result.returncode: raise RuntimeError(f"command {i} failed: {result.returncode}")
+        receipt["source_after"]=snapshot()
+        receipt["source_changed"]=[p for p,h in receipt["source_before"].items() if receipt["source_after"].get(p)!=h]
+        receipt["binary_sha256"]={str(p):sha(p) for p in build.glob("*.exe")}
+        if receipt["source_changed"]: raise RuntimeError("source changed during build/verification")
+        receipt["status"]="passed"
+    except Exception as exc:
+        receipt["status"]="failed";receipt["error"]=str(exc)
+    receipt["wall_seconds"]=time.perf_counter()-started
+    (out/"receipt.json").write_text(json.dumps(receipt,indent=2),encoding="utf-8")
+    print(json.dumps({k:receipt[k] for k in ("status","wall_seconds")},indent=2))
+    return 0 if receipt["status"]=="passed" else 1
+
+
+if __name__=="__main__":
+    raise SystemExit(main())
