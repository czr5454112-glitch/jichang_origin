@@ -0,0 +1,84 @@
+"""Compare saved complete-denominator controller runs without rerunning physics."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import gzip
+import json
+from pathlib import Path
+
+from .original_workload import digest, json_digest, write_json
+
+
+def read_json(path):
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def read_lines(path):
+    with gzip.open(path, "rt", encoding="utf-8") as stream:
+        return [json.loads(line) for line in stream]
+
+
+def compare(folders, historical_root=None):
+    rows, populations = [], {}
+    for folder in folders:
+        receipt, summary = read_json(folder / "receipt.json"), read_json(folder / "summary.json")
+        jobs = read_lines(folder / "business_results.jsonl.gz")
+        events = read_lines(folder / "physical_events.jsonl.gz")
+        offered = summary["offered"]
+        policy = "predictive" if receipt["predictive"] else "reactive"
+        key = offered, policy
+        if key in populations:
+            raise ValueError("duplicate population/policy; filename is not policy evidence")
+        populations[key] = jobs
+        event_counts = Counter(event["event"] for event in events)
+        source = {Path(name).name: value for name, value in receipt["source_before"].items()}
+        row = {"path": str(folder), "receipt_sha256": digest(folder / "receipt.json"),
+               "policy": policy, "binary_sha256": receipt["binary_sha256"], "source": source,
+               "status": receipt["status"], "source_changed": receipt["source_changed"],
+               "horizon": receipt["horizon"], "summary": summary,
+               "audit_status": read_json(folder / "event_audit.json")["status"],
+               "actual_exports": event_counts["EXPORT_GRANTED"], "actual_received": event_counts["EMPTY_RECEIVED"],
+               "transfer_rejections": event_counts["TRANSFER_REJECTED"],
+               "control_compute_ms": receipt["control_compute_ms"],
+               "all_business_rows_sha256": json_digest(jobs), "all_physical_rows_sha256": json_digest(events)}
+        if historical_root:
+            scale = 1 if offered == 28506 else 2 if offered == 57012 else None
+            older = historical_root / f"p2_original_{scale}x_{policy}_H21600_001"
+            if older.exists():
+                old_jobs = read_lines(older / "business_results.jsonl.gz")
+                old_events = read_lines(older / "physical_events.jsonl.gz")
+                row["build004_comparison"] = {"path": str(older),
+                    "all_business_fields_equal": old_jobs == jobs, "all_physical_fields_equal": old_events == events,
+                    "business_mismatch_count": sum(a != b for a, b in zip(old_jobs, jobs)) + abs(len(old_jobs)-len(jobs))}
+        rows.append(row)
+    pairs = []
+    for offered in sorted({key[0] for key in populations}):
+        a, b = populations[(offered, "reactive")], populations[(offered, "predictive")]
+        pair = [row for row in rows if row["summary"]["offered"] == offered]
+        pairs.append({"offered": offered, "all_business_fields_equal": a == b,
+                      "all_business_ids_equal": [r["business_bag_id"] for r in a] == [r["business_bag_id"] for r in b],
+                      "same_horizon": len({row["horizon"] for row in pair}) == 1,
+                      "same_binary": len({row["binary_sha256"] for row in pair}) == 1,
+                      "same_sources": pair[0]["source"] == pair[1]["source"],
+                      "cost_predictive_minus_reactive": next(row["summary"]["restricted_sojourn_sum_seconds_at_actual_clock"] for row in pair if row["policy"] == "predictive") - next(row["summary"]["restricted_sojourn_sum_seconds_at_actual_clock"] for row in pair if row["policy"] == "reactive")})
+    return {"schema": "g31.original_control_comparison.v2", "rows": rows, "pairs": pairs,
+            "all_sources_same": all(row["source"] == rows[0]["source"] for row in rows),
+            "all_binary_same": len({row["binary_sha256"] for row in rows}) == 1,
+            "complete_100ms_requirement_certified": False,
+            "claim": "all offered source rows preserved; common observation horizon is not full-day completion; wall owner compute excludes still-unmeasured complete request components"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run", type=Path, action="append", required=True)
+    parser.add_argument("--historical-root", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = compare(args.run, args.historical_root)
+    write_json(args.output, result)
+    print(json.dumps({key: value for key, value in result.items() if key != "rows"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/diagnose_original_native.py b/scripts/experiments/g31_ics_circulation/diagnose_original_native.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/diagnose_original_native.py
@@ -0,0 +1,42 @@
+"""Run the preserved full original model and export exact offline wait/queue state."""
+import argparse
+import gzip
+import json
+import time
+
+from .native_host import audit_result, load_native
+from .original_workload import ProxyContract, build_input, digest, summarize_execution, write_json
+
+
+def main():
+    from pathlib import Path
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary",type=Path,required=True)
+    parser.add_argument("--output",type=Path,required=True)
+    args=parser.parse_args()
+    args.output.mkdir(parents=True,exist_ok=False)
+    data,manifest,_=build_input(scale=1,contract=ProxyContract(
+        "nanning-on-carrier-proxy-v1-n4-s4-t2",4,4,2,1.,1.,0.,"finite_berth_waiting_research_proxy"))
+    receipt={"binary_sha256":digest(args.binary),"input_sha256":manifest["input_sha256"],
+             "scope":"offline diagnostic export; never passed to online controllers","status":"running"}
+    write_json(args.output/"receipt.json",receipt)
+    started=time.perf_counter()
+    session=load_native(args.binary).NativeSession(data)
+    while session.physical_time<86400:
+        progress=session.advance_to(86400,max_events=10000)
+        if not progress["processed_events"]:break
+    result=session.result_at(session.physical_time)
+    write_json(args.output/"native_offline_diagnostics.json",session.offline_diagnostics())
+    write_json(args.output/"summary.json",summarize_execution(data,result))
+    write_json(args.output/"event_audit.json",audit_result(data,result))
+    write_json(args.output/"input_manifest.json",manifest)
+    with gzip.open(args.output/"physical_events.jsonl.gz","wt",encoding="utf-8") as stream:
+        for event in result["receipts"]:stream.write(json.dumps(event)+"\n")
+    receipt.update(status="reached" if session.physical_time==86400 else "censored",
+                   physical_time=session.physical_time,wall_seconds=time.perf_counter()-started,
+                   final_state_sha256=session.offline_state_sha256())
+    write_json(args.output/"receipt.json",receipt)
+    print(json.dumps(receipt,indent=2))
+
+
+if __name__=="__main__":main()
diff --git a/scripts/experiments/g31_ics_circulation/diagnose_original_waits.py b/scripts/experiments/g31_ics_circulation/diagnose_original_waits.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/diagnose_original_waits.py
@@ -0,0 +1,123 @@
+"""Reconstruct final physical blocking from executed receipts, without inventing queues.
+
+The last RESOURCE_WAIT identifies an actually attempted native head. Candidate
+capacity checks below are derived offline; exact pending indexes and complete
+native FIFO queue order are deliberately not claimed by this reconstruction.
+"""
+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import gzip
+import json
+from pathlib import Path
+
+from .original_workload import ProxyContract, build_input, write_json
+
+
+def diagnose(folder: Path) -> dict:
+    manifest = json.loads((folder/"input_manifest.json").read_text(encoding="utf-8"))
+    # Reconstruct the frozen source contract, never changing its capacities.
+    proxy = manifest.get("physical_proxy_contract", manifest.get("proxy_contract"))
+    if proxy is None:
+        raise ValueError("no source proxy contract in manifest")
+    contract = ProxyContract(**proxy)
+    scale = manifest["scale"]
+    data, _, _ = build_input(scale=scale, contract=contract)
+    events = [json.loads(row) for row in gzip.open(folder/"physical_events.jsonl.gz", "rt", encoding="utf-8")]
+    summary = json.loads((folder/"summary.json").read_text(encoding="utf-8"))
+    if summary["trays_with_receiving_lease"] or any(e["event"] == "EXPORT_GRANTED" for e in events):
+        raise ValueError("this no-transfer reconstruction does not model reception lease deduplication")
+    jobs = {j["business_bag_id"]: j for j in data["jobs"]}
+    trays = {t["tray_id"]: dict(t, mode="empty", job_id="", stage="", edge_to=-1) for t in data["trays"]}
+    last_physical, last_wait, storage_releases = {}, {}, []
+    lifecycle = {"LOAD_COMPLETE", "EDGE_ENTER", "EDGE_EXIT", "STORAGE_ENTER", "STORAGE_RELEASE",
+                 "UNLOAD_START", "UNLOAD_COMPLETE", "HOLD_COMPLETE", "LEG_FAILED"}
+    for event in events:
+        tid, kind = event["tray_id"], event["event"]
+        if kind == "RESOURCE_WAIT":
+            last_wait[event["node"]] = event
+        if not tid or kind not in lifecycle:
+            continue
+        tray = trays[tid]
+        last_physical[tid] = event
+        if kind == "LOAD_COMPLETE":
+            tray.update(node=event["node"], mode="loaded", job_id=event["business_bag_id"], stage="loaded")
+        elif kind == "EDGE_ENTER":
+            tray["edge_to"] = event["to"]
+        elif kind == "EDGE_EXIT":
+            tray.update(node=event["node"], edge_to=-1)
+        elif kind == "STORAGE_ENTER":
+            tray["mode"] = "storage"
+        elif kind == "STORAGE_RELEASE":
+            tray.update(mode="loaded", stage="storage_out")
+            storage_releases.append(event)
+        elif kind == "UNLOAD_START":
+            tray["mode"] = "unloading"
+        elif kind == "UNLOAD_COMPLETE":
+            tray["mode"] = "hold"
+        elif kind == "HOLD_COMPLETE":
+            tray.update(mode="empty", job_id="")
+        elif kind == "LEG_FAILED":
+            tray["mode"] = "quarantined"
+    nodes = {n["node"]: n for n in data["node_contracts"]}
+    occupancy = Counter(t["edge_to"] if t["edge_to"] >= 0 else t["node"] for t in trays.values())
+    adjacency = defaultdict(list)
+    for edge in data["edge_contracts"]:
+        if edge["capacity"] > 0:
+            adjacency[edge["from"]].append(edge["to"])
+    reachable = {}
+    for node in nodes:
+        seen, pending = {node}, [node]
+        while pending:
+            for nxt in adjacency[pending.pop()]:
+                if nxt not in seen:
+                    seen.add(nxt); pending.append(nxt)
+        reachable[node] = seen
+    rows, dependency_edges = [], []
+    for node, event in sorted(last_wait.items()):
+        tray = trays[event["tray_id"]]
+        # Only report a wait whose actual physical tray has not moved away.
+        if tray["node"] != node or tray["edge_to"] >= 0 or tray["mode"] != "loaded":
+            continue
+        job = jobs[tray["job_id"]]
+        goal = job["destination"] if tray["stage"] == "storage_out" or job["storage_node"] < 0 else job["storage_node"]
+        candidates = []
+        for edge in data["edge_contracts"]:
+            if edge["from"] != node:
+                continue
+            target = edge["to"]
+            if edge["capacity"] == 0:
+                reason = "closed_edge"
+            elif goal not in reachable[target]:
+                reason = "no_static_legal_suffix"
+            elif occupancy[target] >= nodes[target]["capacity"]:
+                reason = "receiving_full"
+                dependency_edges.append((node, target))
+            else:
+                reason = "physically_available_in_final_snapshot_not_proof_policy_selects_it"
+            candidates.append({"next": target, "reason": reason,
+                "occupancy": occupancy[target], "capacity": nodes[target]["capacity"],
+                "occupant_trays": [t["tray_id"] for t in trays.values()
+                    if (t["edge_to"] if t["edge_to"] >= 0 else t["node"]) == target]})
+        rows.append({"node": node, "last_actual_wait_event": event, "stage_goal": goal,
+            "offline_candidate_capacity_checks": candidates,
+            "co_located_loaded_trays": [t["tray_id"] for t in trays.values() if t["node"] == node and t["mode"] == "loaded"]})
+    result = {"schema": "g31.original_receipt_blocking_reconstruction.v1", "physical_clock": summary["physical_clock"],
+        "complete_offered": summary["offered"], "completed": summary["completed"],
+        "scope": "executed identities and physical position plus offline full candidate capacity checks; exact pending wait indexes and full native FIFO queue order unavailable",
+        "storage_release_events": storage_releases, "trays": [{**t, "last_physical_event": last_physical.get(t["tray_id"])} for t in trays.values()],
+        "actual_last_waiting_heads": rows,
+        "candidate_receiving_dependency_edges": sorted(set(dependency_edges)),
+        "static_unreachable_head_count": sum(all(c["reason"] in ("closed_edge", "no_static_legal_suffix") for c in r["offline_candidate_capacity_checks"]) for r in rows),
+        "business_or_physical_state_modified": False, "optimality": "unknown"}
+    write_json(folder/"blocking_diagnosis.json", result)
+    return result
+
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("folder", type=Path)
+    args = parser.parse_args()
+    result = diagnose(args.folder)
+    print(json.dumps({k: v for k, v in result.items() if k not in ("trays", "actual_last_waiting_heads", "storage_release_events")}, indent=2))
diff --git a/scripts/experiments/g31_ics_circulation/export_long_term_delivery.py b/scripts/experiments/g31_ics_circulation/export_long_term_delivery.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/export_long_term_delivery.py
@@ -0,0 +1,77 @@
+"""Export a reviewable delta from the verified prior delivery, without Git writes."""
+from __future__ import annotations
+
+import argparse
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import zipfile
+
+ROOT = Path(__file__).absolute().parents[3]
+BASE = ROOT / "outputs/experiments/g31_ics_circulation_20261013/delivery_001/implementation_and_diffs.zip"
+BASE_SHA = "bce9c6c9e4954439d157a7bc00610ec691a0668076b9bb70e75a5b1140b96f86"
+
+
+def sha(content: bytes) -> str:
+    return hashlib.sha256(content).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    if sha(BASE.read_bytes()) != BASE_SHA:
+        raise RuntimeError("prior delivery identity mismatch; do not derive a delta from it")
+    with zipfile.ZipFile(BASE) as archive:
+        old = {name.removeprefix("working_source/"): archive.read(name)
+               for name in archive.namelist() if name.startswith("working_source/")}
+    paths = {ROOT / name for name in old}
+    for pattern in ("cpp/ics_core/runtime/circulation*.hpp", "cpp/ics_core/bindings/circulation*",
+                    "cpp/tests/test_circulation*", "cpp/tests/g31_legacy_replay_fixture.cpp",
+                    "scripts/experiments/g31_ics_circulation/*.py",
+                    "tests/test_g31_circulation_*.py", "tests/test_g31_fixed_blocking_certificate.py",
+                    "tests/test_g31_original_mechanism.py", "docs/g31_ics_circulation/*"):
+        paths.update(p for p in ROOT.glob(pattern) if p.is_file())
+    patch = []; changed = {}; current = {}
+    for path in sorted(paths):
+        name = path.relative_to(ROOT).as_posix()
+        data = path.read_bytes(); previous = old.get(name, b""); current[name] = sha(data)
+        if data == previous:
+            continue
+        # Normalize text line endings for a portable patch; raw file SHA256
+        # and exact current bytes are still included in the source ZIP.
+        before = previous.decode("utf-8-sig").replace("\r\n", "\n")
+        after = data.decode("utf-8-sig").replace("\r\n", "\n")
+        delta = list(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
+                     fromfile="a/" + name if name in old else "/dev/null", tofile="b/" + name))
+        if delta:
+            patch.append("diff --git a/" + name + " b/" + name + "\n")
+            patch.extend(delta)
+        changed[name] = {"before_sha256": sha(previous) if name in old else None,
+                         "after_sha256": sha(data), "text_changed": bool(delta)}
+    patch_file = args.output / "long_term_from_verified_delivery.patch"
+    patch_file.write_text("".join(patch), encoding="utf-8", newline="\n")
+    check = subprocess.run(["git", "apply", "--reverse", "--check", str(patch_file.absolute())],
+                           cwd=ROOT, capture_output=True, check=False)
+    (args.output / "patch_reverse_check.stdout.log").write_bytes(check.stdout)
+    (args.output / "patch_reverse_check.stderr.log").write_bytes(check.stderr)
+    manifest = {"schema": "g31.long_term_delta.v1", "baseline_zip": str(BASE),
+                "baseline_zip_sha256": BASE_SHA, "changed_files": changed, "current_source_sha256": current,
+                "patch_sha256": sha(patch_file.read_bytes()), "patch_reverse_check_exit_code": check.returncode,
+                "scope": "incremental local source and progress delta; not full repo, raw experiments or binaries",
+                "committed": False, "pushed": False}
+    manifest_file = args.output / "manifest.json"
+    manifest_file.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+    with zipfile.ZipFile(args.output / "long_term_source_delta.zip", "w", zipfile.ZIP_DEFLATED) as archive:
+        for name in changed:
+            archive.write(ROOT / name, "working_source/" + name)
+        archive.write(patch_file, patch_file.name); archive.write(manifest_file, manifest_file.name)
+    print(json.dumps({"changed_files": len(changed), "reverse_check_exit_code": check.returncode,
+                      "zip_sha256": sha((args.output / "long_term_source_delta.zip").read_bytes())}))
+    return check.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/finite_reference.py b/scripts/experiments/g31_ics_circulation/finite_reference.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/finite_reference.py
@@ -0,0 +1,258 @@
+"""Finite intervention reference on genuine native checkpoint continuations.
+
+This tool is offline: continuation may see the real common future, whereas
+candidate construction must consume only the public observation. Results must
+never be used as online policy features. Optimality refers only to a fully
+enumerated supplied action domain at this one boundary, under one fixed future
+and continuation policy. It is not an optimal continuous circulation solution.
+"""
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable
+from dataclasses import asdict, dataclass
+import copy
+import hashlib
+import json
+import math
+import time
+from typing import Any, Protocol
+
+
+class NativeBranch(Protocol):
+    physical_time: float
+    def fork(self) -> "NativeBranch": ...
+    def submit_transfer_intent(self, request: dict[str, Any]) -> dict[str, Any]: ...
+    def submit_route_intent(self, request: dict[str, Any]) -> dict[str, Any]: ...
+    def result_at(self, horizon: float) -> dict[str, Any]: ...
+    def observe(self, owner_id: str) -> dict[str, Any]: ...
+
+
+@dataclass(frozen=True)
+class Intervention:
+    action_id: str
+    kind: str
+    request: dict[str, Any] | None = None
+
+
+def outcome_cost(result: dict[str, Any], job_contracts: list[dict[str, Any]],
+                 horizon: float) -> dict[str, Any]:
+    """All offered arrivals by H; unfinished jobs contribute restricted time.
+
+    The transparent objective is sum of arrival-to-unload time truncated at H.
+    Failed and unfinished tasks remain in the denominator; deadline and failure
+    counts are separate, never silently priced as a small successful latency.
+    """
+    outcomes = {j["business_bag_id"]: j for j in result["jobs"]}
+    if len(outcomes) != len(result["jobs"]):
+        raise ValueError("finite_reference:duplicate_job_result")
+    offered = [j for j in job_contracts if j["arrival"] <= horizon]
+    if not {j["business_bag_id"] for j in offered} <= outcomes.keys():
+        raise ValueError("finite_reference:missing_offered_job")
+    restricted, completed, late, failed, pending, per_job = 0.0, 0, 0, 0, 0, []
+    for contract in offered:
+        job = outcomes[contract["business_bag_id"]]
+        finish = float(job["completed_at"])
+        done = 0 <= finish <= horizon
+        cost = (finish if done else horizon) - float(contract["arrival"])
+        if cost < -1e-8:
+            raise ValueError("finite_reference:completion_before_arrival")
+        restricted += max(0, cost)
+        completed += done
+        failed += job["status"] in ("failed", "quarantined")
+        pending += not done
+        deadline = float(contract.get("deadline", -1))
+        violated = deadline >= 0 and ((done and finish > deadline + 1e-8) or
+                                      (not done and horizon > deadline + 1e-8))
+        late += violated
+        per_job.append({"business_bag_id": contract["business_bag_id"],
+                        "restricted_time": max(0, cost), "completed": done,
+                        "completed_at": finish if done else None,
+                        "deadline_violated_by_horizon": violated, "status": job["status"]})
+    return {"objective": "sum_restricted_arrival_to_unload_time", "horizon": horizon,
+            "cost": restricted, "offered": len(offered), "completed": completed,
+            "unfinished": pending, "failed": failed, "deadline_violations": late,
+            "per_job": per_job}
+
+
+def service_dominates(candidate: dict[str, Any], baseline: dict[str, Any]) -> bool:
+    """Post-run strict paired protection on the same offered population.
+
+    It is evidence under this future, not an advance guarantee for all futures.
+    """
+    a = {j["business_bag_id"]: j for j in candidate["per_job"]}
+    b = {j["business_bag_id"]: j for j in baseline["per_job"]}
+    if a.keys() != b.keys():
+        raise ValueError("finite_reference:incomparable_population")
+    return all(a[k]["restricted_time"] <= b[k]["restricted_time"] + 1e-8
+               and not (a[k]["deadline_violated_by_horizon"] and not b[k]["deadline_violated_by_horizon"])
+               and not (a[k]["status"] in ("failed", "quarantined")
+                        and b[k]["status"] not in ("failed", "quarantined"))
+               for k in a)
+
+
+def _horizon_completion(result: dict[str, Any], branch: NativeBranch, horizon: float,
+                        outer_status: str | None = None) -> dict[str, Any]:
+    """Fail closed before pricing a prefix as a complete common-horizon result."""
+    raw_advance = result.get("advance", {})
+    advance = raw_advance if isinstance(raw_advance, dict) else {}
+    has_control = "control_continuation" in result
+    raw_control = result.get("control_continuation", {})
+    control = raw_control if isinstance(raw_control, dict) else {}
+    values = {"requested_horizon": horizon, "result_horizon": result.get("horizon"),
+              "physical_clock": result.get("physical_clock"),
+              "advance_physical_time": advance.get("physical_time"),
+              "branch_physical_time": getattr(branch, "physical_time", None)}
+    if has_control:
+        values["controller_requested_horizon"] = control.get("requested_horizon")
+        values["controller_physical_time"] = control.get("physical_time")
+    problems = []
+    for name, value in values.items():
+        if isinstance(value, bool) or not isinstance(value, (float, int)) or not math.isfinite(value):
+            problems.append(name + ":missing_or_nonfinite")
+        elif abs(value - horizon) > 1e-8:
+            problems.append(name + ":does_not_equal_requested_horizon")
+    if advance.get("status") != "reached":
+        problems.append("advance_not_reached")
+    if outer_status is not None and outer_status != "reached":
+        problems.append("outer_continuation_not_reached")
+    if has_control and control.get("status") != "reached":
+        problems.append("controller_continuation_not_reached")
+    if result.get("status") in ("budget_exhausted", "censored", "failed", "timeout_unknown"):
+        problems.append("result_explicitly_censored")
+    if advance.get("horizon_complete") is not True or result.get("native_summary", {}).get("event_limit_reached"):
+        problems.append("native_horizon_incomplete")
+    return {"status": "reached" if not problems else "unknown", "problems": problems,
+            "evidence": values, "advance_status": advance.get("status"), "outer_status": outer_status}
+
+
+def enumerate_interventions(session: NativeBranch, actions: Iterable[Intervention], *,
+                            horizon: float, job_contracts: list[dict[str, Any]],
+                            baseline_action_id: str = "WAIT", max_branches: int = 128,
+                            max_seconds: float = 30,
+                            continuation: Callable[[NativeBranch, float], dict[str, Any]] | None = None,
+                            validate: Callable[[dict[str, Any], Intervention], Any] | None = None,
+                            strict_paired_service: bool = True) -> dict[str, Any]:
+    """Fork once per alternative; replace one intervention, then same policy.
+
+    Validate must independently replay receipts/physical invariants before an
+    optimal-domain claim can be made. Without it all solutions stay unverified.
+    Native rejection is recorded, not replaced by a silent successful WAIT.
+    """
+    if not math.isfinite(horizon) or horizon < session.physical_time or max_branches < 1 or max_seconds <= 0:
+        raise ValueError("finite_reference:invalid_domain")
+    alternatives = list(actions)
+    ids = [a.action_id for a in alternatives]
+    if len(set(ids)) != len(ids) or baseline_action_id not in ids:
+        raise ValueError("finite_reference:invalid_action_identity_or_missing_baseline")
+    if not any(a.kind == "wait" for a in alternatives):
+        raise ValueError("finite_reference:wait_required")
+    # Evaluate the actual baseline before optional branches when budget-limited.
+    alternatives.sort(key=lambda a: (a.action_id != baseline_action_id, a.action_id))
+    start = time.perf_counter()
+    rows = []
+    for action in alternatives:
+        if len(rows) >= max_branches or time.perf_counter() - start >= max_seconds:
+            break
+        tick = time.perf_counter()
+        branch = session.fork()
+        reply: dict[str, Any] = {"status": "accepted", "reason": "wait"}
+        if action.kind == "transfer":
+            reply = branch.submit_transfer_intent(copy.deepcopy(action.request))
+        elif action.kind == "route":
+            reply = branch.submit_route_intent(copy.deepcopy(action.request))
+        elif action.kind != "wait":
+            raise ValueError("finite_reference:unknown_intervention")
+        if reply.get("status") in ("rejected", "failed_no_safe_continuation", "timeout_unknown"):
+            # A native permission rejection resolves this requested action.
+            # Budget/solver inability does not prove the action infeasible.
+            classification = "rejected" if reply["status"] == "rejected" else "unresolved_submission"
+            rows.append({"action": asdict(action), "reply": reply, "status": classification,
+                         "elapsed_seconds": time.perf_counter() - tick})
+            continue
+        continued = continuation(branch, horizon) if continuation else branch.result_at(horizon)
+        outer_status = None
+        if "result" in continued and "jobs" not in continued:
+            declared_status = continued.get("status", "missing")
+            outer_status = declared_status if isinstance(declared_status, str) else "invalid_status_type"
+            result = continued["result"]
+        else:
+            result = continued
+        completion = _horizon_completion(result, branch, horizon, outer_status)
+        if completion["status"] != "reached":
+            rows.append({"action": asdict(action), "reply": reply, "status": "incomplete_horizon",
+                         "completion": completion,
+                         "result": result, "elapsed_seconds": time.perf_counter() - tick})
+            continue
+        metrics = outcome_cost(result, job_contracts, horizon)
+        audit = validate(result, action) if validate else None
+        if validate and (not isinstance(audit, dict) or audit.get("status") != "passed"):
+            raise ValueError("finite_reference:independent_audit_did_not_pass")
+        resolution: dict[str, Any] = {"status": "wait", "reason": "no_intervention"}
+        status = "verified" if validate else "unverified"
+        if action.kind != "wait":
+            request_id = action.request["request_id"]
+            requests = (result["transfers"] if action.kind == "transfer" else
+                        branch.observe(action.request["owner_id"])["route_requests"])
+            resolved = next((r for r in requests if r["request_id"] == request_id), None)
+            if resolved is None:
+                raise ValueError("finite_reference:submitted_request_missing_from_resolution_ledger")
+            resolution = {key: resolved.get(key) for key in ("status", "reason", "request_id")}
+            success = {"received"} if action.kind == "transfer" else {"updated"}
+            if resolved["status"] in ("rejected", "cancelled", "failed", "expired"):
+                status = "asynchronous_rejected"
+            elif resolved["status"] not in success:
+                status = "unresolved_at_horizon"
+        physical_events = {"EDGE_ENTER", "EDGE_EXIT", "LOAD_START", "LOAD_COMPLETE", "STORAGE_ENTER",
+                           "STORAGE_RELEASE", "UNLOAD_START", "UNLOAD_COMPLETE", "HOLD_COMPLETE",
+                           "EXPORT_GRANTED", "EMPTY_RECEIVED", "UNUSED_RECEIVING_RELEASED", "LEG_FAILED"}
+        physical_trace = [{k: r[k] for k in ("time", "event", "tray_id", "business_bag_id", "node", "from", "to") if k in r}
+                          for r in result.get("receipts", []) if r["event"] in physical_events]
+        physical_identity = hashlib.sha256(json.dumps(physical_trace, sort_keys=True).encode()).hexdigest()
+        rows.append({"action": asdict(action), "reply": reply,
+                     "status": status, "execution_resolution": resolution,
+                     "completion": completion,
+                     "physical_outcome_sha256": physical_identity,
+                     "metrics": metrics, "audit": audit, "result": result,
+                     "elapsed_seconds": time.perf_counter() - tick})
+    baseline = next((r for r in rows if r["action"]["action_id"] == baseline_action_id), None)
+    eligible = []
+    for row in rows:
+        if "metrics" not in row or not baseline or "metrics" not in baseline:
+            continue
+        row["paired_service_preserved"] = service_dominates(row["metrics"], baseline["metrics"])
+        if row["status"] == "verified" and (not strict_paired_service or row["paired_service_preserved"]):
+            eligible.append(row)
+    best = min(eligible, key=lambda r: (r["metrics"]["cost"], r["action"]["action_id"]), default=None)
+    complete = len(rows) == len(alternatives) and all(
+        r["status"] in ("verified", "rejected", "asynchronous_rejected") for r in rows)
+    return {"schema": "g31.finite_intervention_reference.v1", "rows": rows,
+            "domain_size": len(alternatives), "evaluated": len(rows), "exhaustive": complete,
+            "best_action_id": best["action"]["action_id"] if best else None,
+            "best_cost": best["metrics"]["cost"] if best else None,
+            "optimality": "optimal_in_enumerated_domain" if complete and validate and best else "unknown",
+            "global_native_optimality": "unknown", "elapsed_seconds": time.perf_counter() - start,
+            "distinct_verified_physical_outcomes": len({r["physical_outcome_sha256"] for r in rows if r["status"] == "verified"}),
+            "information_track": "offline_common_real_future_diagnostic",
+            "strict_paired_service": strict_paired_service,
+            "domain": "one intervention at this checkpoint; supplied finite actions; fixed continuation and future"}
+
+
+def headroom(reference: dict[str, Any], deployed_action_ids: Iterable[str],
+             selected_action_id: str, baseline_action_id: str) -> dict[str, Any]:
+    costs = {r["action"]["action_id"]: r["metrics"]["cost"] for r in reference["rows"]
+             if r["status"] == "verified" and r.get("paired_service_preserved", False)}
+    pool = set(deployed_action_ids)
+    if not costs or selected_action_id not in costs or baseline_action_id not in costs:
+        return {"status": "not_comparable", "verified_candidate_count": len(costs)}
+    pool_costs = [costs[a] for a in pool if a in costs]
+    if not pool_costs:
+        return {"status": "zero_deployment_candidates", "verified_candidate_count": len(costs)}
+    best, pool_best = min(costs.values()), min(pool_costs)
+    if selected_action_id not in pool:
+        raise ValueError("finite_reference:selected_action_outside_deployment_pool")
+    return {"status": "finite_domain_comparison", "verified_candidate_count": len(costs),
+            "deployment_candidate_count": len(pool_costs),
+            "reference_headroom": costs[baseline_action_id] - best,
+            "pool_loss": pool_best - best, "ranking_loss": costs[selected_action_id] - pool_best,
+            "complete_reference_domain": reference["exhaustive"],
+            "global_lower_bound": None}
