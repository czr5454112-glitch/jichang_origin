+++ b/scripts/experiments/g31_ics_circulation/validate_live.py
@@ -0,0 +1,89 @@
+"""Run native/Python circulation regressions with explicit binary provenance."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).absolute().parents[3]
+
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def snapshot() -> dict[str, str]:
+    paths = [ROOT / "CMakeLists.txt", *ROOT.glob("cpp/**/*.hpp"), *ROOT.glob("cpp/**/*.cpp"),
+             *ROOT.glob("scripts/experiments/g31_ics_circulation/*.py"),
+             *ROOT.glob("tests/test_g31_circulation_*.py"),
+             ROOT / "tests/test_g31_fixed_blocking_certificate.py",
+             ROOT / "tests/test_g31_original_mechanism.py"]
+    return {str(p.relative_to(ROOT)): sha(p) for p in sorted(paths)}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--build-receipt", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--timeout", type=float, default=300)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    binary = args.binary.absolute()
+    build = json.loads(args.build_receipt.read_text(encoding="utf-8"))
+    before = snapshot()
+    binary_hash = sha(binary)
+    compiled_mismatch = [p for p, digest in build["source_after"].items() if before.get(p) != digest]
+    tests = sorted({str(p.relative_to(ROOT)) for p in ROOT.glob("tests/test_g31_circulation_*.py")} |
+                   {"tests/test_g31_fixed_blocking_certificate.py",
+                    "tests/test_g31_original_mechanism.py"})
+    command = [sys.executable, "-m", "pytest", "-q", *tests,
+               "--junitxml=" + str((args.output / "junit.xml").absolute())]
+    receipt = {"schema": "g31.live_regression.v1", "status": "running", "command": command,
+               "binary": str(binary), "binary_sha256": binary_hash,
+               "build_receipt": str(args.build_receipt), "build_receipt_sha256": sha(args.build_receipt),
+               "compiled_source_mismatch": compiled_mismatch, "source_before": before,
+               "test_files": tests, "environment": {"G31_CIRCULATION_BINARY": str(binary),
+                    "PYTHONPATH": "src;.", "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"}}
+    start = time.perf_counter()
+    try:
+        if build["status"] != "passed" or build["source_changed"] or compiled_mismatch:
+            raise RuntimeError("source does not match a successful clean build")
+        if binary_hash not in build["binary_sha256"].values():
+            raise RuntimeError("binary hash is absent from clean build receipt")
+        env = dict(os.environ, **receipt["environment"], PYTHONIOENCODING="utf-8")
+        with (args.output / "stdout.log").open("wb") as out, (args.output / "stderr.log").open("wb") as err:
+            run = subprocess.run(command, cwd=ROOT, env=env, stdout=out, stderr=err,
+                                 timeout=args.timeout, check=False)
+        receipt["exit_code"] = run.returncode
+        cases = ET.parse(args.output / "junit.xml").findall(".//testcase")
+        receipt["counts"] = {"tests": len(cases),
+                             "failures": sum(c.find("failure") is not None for c in cases),
+                             "errors": sum(c.find("error") is not None for c in cases),
+                             "skipped": sum(c.find("skipped") is not None for c in cases)}
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = sorted(k for k in before.keys() | receipt["source_after"].keys()
+                                           if before.get(k) != receipt["source_after"].get(k))
+        if run.returncode or not cases or any(receipt["counts"][k] for k in ("failures", "errors", "skipped")):
+            raise RuntimeError("regression did not complete without failure/error/skip")
+        if receipt["source_changed"] or sha(binary) != binary_hash:
+            raise RuntimeError("source or binary changed during verification")
+        receipt["status"] = "passed"
+    except Exception as exc:
+        receipt["status"] = "failed"
+        receipt["error"] = repr(exc)
+    finally:
+        receipt["wall_seconds"] = time.perf_counter() - start
+        (args.output / "receipt.json").write_text(json.dumps(receipt, indent=2), encoding="utf-8")
+    print(json.dumps({k: receipt[k] for k in ("status", "counts", "error") if k in receipt}))
+    return 0 if receipt["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_original_reference.py b/scripts/experiments/g31_ics_circulation/validate_original_reference.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_original_reference.py
@@ -0,0 +1,142 @@
+"""Predeclared six-action reference at the original map's first public return.
+
+Boundary selection reads only actual owner observations at fixed control ticks.
+It does not inspect outcomes of candidate continuations or future input jobs.
+All branches replace the same one control epoch, preserve its next-tick phase,
+and use identical reactive continuation with actual delayed demand messages.
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+import copy
+import gzip
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching, transfer_candidates
+from .finite_reference import Intervention, enumerate_interventions, headroom
+from .native_host import audit_result, load_native
+from .original_mechanism import select_input
+from .original_workload import digest, write_json
+from .validate_analytic_control import replay_input
+
+
+def first_public_return(session, owners, *, horizon, period=60.):
+    state, submitted, inspected = None, [], 0
+    for tick in range(int(horizon // period) + 1):
+        target = tick * period
+        advance = session.advance_to(target)
+        if advance["status"] != "reached":
+            raise RuntimeError("original_reference:prefix_censored")
+        for owner in owners:
+            observation = session.observe(owner)
+            decision = transfer_candidates(observation, predictive=False, message_delay=2.,
+                                           request_prefix="original-first-public-reference")
+            inspected += 1
+            if decision["intents"]:
+                if len(decision["intents"]) != 1 or state is None or state["next_tick"] != tick:
+                    raise RuntimeError("original_reference:undeclared_multi_action_or_phase")
+                # The finite intervention replaces this complete epoch. No
+                # branch reruns this tick or publishes a different demand tape.
+                continuation_state = copy.deepcopy(state)
+                continuation_state["next_tick"] = tick + 1
+                return {"observation": observation, "decision": decision, "owner": owner,
+                        "tick": tick, "time": target, "inspected_owner_boundaries": inspected,
+                        "prefix_submitted": submitted, "controller_state_before_epoch": state,
+                        "controller_state_for_continuation": continuation_state,
+                        "rule": "first fixed 60-second tick with public actual-empty reactive return intent; owner order sorted; no outcome search",
+                        "epoch_replacement": "one whole current epoch, no current-epoch demand republish; next epoch and cached publication signatures shared by every branch"}
+        prefix = run_online_matching(session, owners, horizon=target, predictive=False,
+            control_period=period, message_delay=2., demand_delay=.5, controller_state=state)
+        if prefix["status"] != "reached":
+            raise RuntimeError("original_reference:prefix_controller_censored")
+        state = prefix["controller_state"]
+        submitted.extend(prefix["submitted"])
+    raise RuntimeError("original_reference:no_qualifying_boundary")
+
+
+def finite_actions(boundary):
+    request = boundary["decision"]["intents"][0]
+    actions = [Intervention("WAIT", "wait"), Intervention("analytic", "transfer", request)]
+    for offset in (1., 15., 30., 60.):
+        delayed = dict(request, request_id=request["request_id"] + f":offset:{offset:g}",
+                       earliest_departure=request["earliest_departure"] + offset,
+                       expiry=request["expiry"] + offset)
+        actions.append(Intervention(f"delay-{offset:g}", "transfer", delayed))
+    return actions
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--horizon", type=float, default=86400.)
+    parser.add_argument("--max-seconds", type=float, default=120.)
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), *[Path(__file__).with_name(name + ".py") for name in
+             ("analytic_control", "finite_reference", "original_mechanism", "original_workload", "native_host", "validate_analytic_control")]]
+    snapshot = lambda: {str(path): digest(path) for path in paths}
+    receipt = {"schema": "g31.original_finite_reference.v1", "status": "running",
+               "source_before": snapshot(), "binary_sha256": digest(args.binary),
+               "scope": "24 complete original-source bags on unchanged full graph; offline finite intervention, not global optimum or method innovation",
+               "declared_domain": ["WAIT", "analytic", "delay-1", "delay-15", "delay-30", "delay-60"]}
+    write_json(args.output / "receipt.json", receipt)
+    start = time.perf_counter()
+    try:
+        data, selection, lineage = select_input(24, horizon=args.horizon)
+        write_json(args.output / "input.json", data); write_json(args.output / "selection.json", selection)
+        with gzip.open(args.output / "mother_crosswalk.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for row in lineage:
+                stream.write(json.dumps(row) + "\n")
+        session = load_native(args.binary).NativeSession(data)
+        owners = sorted({node["resource_owner"] for node in data["node_contracts"]})
+        boundary = first_public_return(session, owners, horizon=args.horizon)
+        actions = finite_actions(boundary)
+        write_json(args.output / "public_boundary_and_domain.json", {**boundary, "actions": [asdict(action) for action in actions]})
+        parent_hash = session.offline_state_sha256()
+
+        def continuation(branch, horizon):
+            run = run_online_matching(branch, owners, horizon=horizon, predictive=False,
+                control_period=60., message_delay=2., demand_delay=.5,
+                controller_state=copy.deepcopy(boundary["controller_state_for_continuation"]))
+            run["result"]["offline_continuation_submitted"] = run["submitted"]
+            return run
+
+        def validate(result, action):
+            submissions = boundary["prefix_submitted"] + result["offline_continuation_submitted"]
+            if action.kind == "transfer":
+                submissions = submissions + [{"request": action.request, "reply": {"status": "pending"}}]
+            return audit_result(replay_input(data, submissions), result)
+
+        reference = enumerate_interventions(session, actions, horizon=args.horizon, job_contracts=data["jobs"],
+            baseline_action_id="analytic", max_branches=6, max_seconds=args.max_seconds,
+            continuation=continuation, validate=validate, strict_paired_service=True)
+        with gzip.open(args.output / "finite_reference_raw.json.gz", "wt", encoding="utf-8") as stream:
+            json.dump(reference, stream)
+        receipt["reference"] = {key: value for key, value in reference.items() if key != "rows"}
+        receipt["headroom"] = headroom(reference, ["WAIT", "analytic"], "analytic", "analytic")
+        receipt["candidates"] = [{key: value for key, value in row.items() if key not in ("result", "audit")}
+                                 for row in reference["rows"]]
+        receipt["boundary"] = {key: boundary[key] for key in ("owner", "tick", "time", "inspected_owner_boundaries", "rule", "epoch_replacement")}
+        receipt["parent_unchanged"] = session.offline_state_sha256() == parent_hash
+        if not receipt["parent_unchanged"]:
+            raise RuntimeError("original_reference:fork_changed_parent")
+        receipt["status"] = "executed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["traceback"] = traceback.format_exc()
+    finally:
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = [path for path, value in receipt["source_before"].items() if receipt["source_after"][path] != value]
+        receipt["wall_seconds"] = time.perf_counter() - start
+        if receipt["source_changed"]:
+            receipt["status"] = "source_changed"
+        write_json(args.output / "receipt.json", receipt)
+    print(json.dumps({key: value for key, value in receipt.items() if key != "candidates"}, indent=2))
+    return int(receipt["status"] != "executed")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_original_regional.py b/scripts/experiments/g31_ics_circulation/validate_original_regional.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_original_regional.py
@@ -0,0 +1,166 @@
+"""Actual on-demand R1 request on the original graph and predeclared source subset.
+
+The common route-authorization factor is explicit. This is not a field-granted
+permission or a new method. A public first-branch rule selects the checkpoint;
+no alternative's future outcome is inspected to choose the boundary.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .finite_reference import Intervention, enumerate_interventions, headroom, outcome_cost, service_dominates
+from .native_host import audit_result, load_native
+from .original_mechanism import select_input
+from .original_workload import json_digest, write_json
+from .regional_control import complete_on_demand, public_astar
+from .validate_analytic_control import replay_input
+
+
+def first_public_branch(session, owners, *, max_events=5000):
+    """Stop at first observed loaded tray with two public stage continuations."""
+    for inspected in range(max_events + 1):
+        for owner in owners:
+            observation = session.observe(owner)
+            jobs = {j["business_bag_id"]: j for j in observation["jobs"]}
+            for tray in sorted(observation["trays"], key=lambda t: t["tray_id"]):
+                job = jobs.get(tray["business_bag_id"])
+                if tray["mode"] != "loaded" or tray["edge_to"] >= 0 or not job:
+                    continue
+                storage = job["storage_node"]
+                goal = storage if storage >= 0 and job["storage_released_at"] < 0 else job["destination"]
+                choices = sorted(e["to"] for e in observation["edge_contracts"]
+                    if e["from"] == tray["node"] and e["capacity"] > 0
+                    and public_astar(observation, e["to"], goal))
+                if len(choices) >= 2:
+                    return {"owner": owner, "tray_id": tray["tray_id"], "observation": observation,
+                            "public_next_choices": choices, "inspected_event_boundaries": inspected,
+                            "selection": "first observed loaded, unentered tray with two positive-capacity public stage continuations"}
+        if not session.step():
+            break
+    raise RuntimeError("no qualifying public route boundary within declared event budget")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--count", type=int, default=24)
+    parser.add_argument("--horizon", type=float, default=86400.)
+    parser.add_argument("--reference", action="store_true",
+                        help="enumerate every public next choice at the same declared first boundary")
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), *[Path(__file__).with_name(n + ".py") for n in
+             ("original_mechanism", "original_workload", "analytic_control", "finite_reference",
+              "regional_control", "native_host", "validate_analytic_control")]]
+    snapshot = lambda: {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    receipt = {"status": "running", "source_before": snapshot(),
+               "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+               "claim": "original graph R1 integration and request timing; common research authorization factor; no novelty or full-flow claim"}
+    start = time.perf_counter()
+    try:
+        data, selection, lineage = select_input(args.count, horizon=args.horizon)
+        # Both baseline and candidate have identical service and route authority.
+        # Original source has no field route-authority column: this is a factor.
+        for job in data["jobs"]:
+            job["allow_suffix_reroute"] = True
+        selection["base_selected_input_sha256"] = selection["input_sha256"]
+        selection["input_sha256"] = json_digest(data)
+        selection["common_research_factor"] = {"allow_suffix_reroute": True,
+            "applies_to": "both S4 baseline and R1 candidate", "field_permission_claim": False,
+            "business_destination_arrival_storage_deadline_changed": False}
+        write_json(args.output / "input.json", data)
+        write_json(args.output / "selection.json", selection)
+        with gzip.open(args.output / "mother_crosswalk.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for row in lineage:
+                stream.write(json.dumps(row) + "\n")
+        native = load_native(args.binary); session = native.NativeSession(data)
+        owners = sorted({n["resource_owner"] for n in data["node_contracts"]})
+        boundary = first_public_branch(session, owners)
+        write_json(args.output / "boundary.json", boundary)
+        parent_hash = session.offline_state_sha256()
+        baseline, candidate = session.fork(), session.fork()
+        measurement = complete_on_demand(candidate, boundary["owner"], boundary["tray_id"],
+            "original-r1-first-public-branch", logical_compute_delay=.001, lease_seconds=5.)
+        write_json(args.output / "complete_request.json", measurement)
+        # Synchronize common continuation phase after the same native interval.
+        baseline.advance_to(candidate.physical_time)
+        outcomes = {}
+        for label, branch in (("S4", baseline), ("regional_Astar", candidate)):
+            run = run_online_matching(branch, owners, horizon=args.horizon, predictive=True,
+                control_period=60., message_delay=2., demand_delay=.5)
+            if run["status"] != "reached" or run["result"]["horizon"] != args.horizon:
+                raise RuntimeError("original regional continuation incomplete")
+            audit = audit_result(replay_input(data, run["submitted"]), run["result"])
+            with gzip.open(args.output / (label + "_raw.json.gz"), "wt", encoding="utf-8") as stream:
+                json.dump(run, stream)
+            write_json(args.output / (label + "_audit.json"), audit)
+            outcomes[label] = outcome_cost(run["result"], data["jobs"], args.horizon)
+            write_json(args.output / (label + "_metrics.json"), outcomes[label])
+        receipt["measurement"] = {k: v for k, v in measurement.items() if k != "submission"}
+        receipt["request_submission"] = measurement["submission"]["response"]
+        receipt["boundary"] = {k: v for k, v in boundary.items() if k != "observation"}
+        receipt["strict_paired_service_preserved"] = service_dominates(outcomes["regional_Astar"], outcomes["S4"])
+        receipt["cost_regional_minus_S4"] = outcomes["regional_Astar"]["cost"] - outcomes["S4"]["cost"]
+        receipt["outcomes"] = {k: {name: value for name, value in row.items() if name != "per_job"}
+                               for k, row in outcomes.items()}
+        if args.reference:
+            template = measurement["submission"]["request"]
+            if template is None:
+                raise RuntimeError("no route template for public-domain reference")
+            actions = [Intervention("WAIT", "wait")]
+            for next_node in boundary["public_next_choices"]:
+                request = dict(template, request_id=f"original-route-reference-{next_node}", next=next_node)
+                actions.append(Intervention(f"route-{next_node}", "route", request))
+            # All branches share the post-delivery controller start and its phase.
+            # The real common future is used only in this offline diagnostic.
+            continuation_start = session.physical_time + .001
+
+            def continuation(branch, horizon):
+                branch.advance_to(continuation_start)
+                run = run_online_matching(branch, owners, horizon=horizon, predictive=True,
+                    control_period=60., message_delay=2., demand_delay=.5)
+                run["result"]["offline_continuation_submitted"] = run["submitted"]
+                return run
+
+            def validate(result, action):
+                return audit_result(replay_input(data, result["offline_continuation_submitted"]), result)
+
+            baseline_id = f"route-{template['next']}"
+            reference = enumerate_interventions(session, actions, horizon=args.horizon,
+                job_contracts=data["jobs"], baseline_action_id=baseline_id,
+                max_branches=len(actions), max_seconds=120., continuation=continuation, validate=validate)
+            with gzip.open(args.output / "route_reference_raw.json.gz", "wt", encoding="utf-8") as stream:
+                json.dump(reference, stream)
+            receipt["reference"] = {k: v for k, v in reference.items() if k != "rows"}
+            receipt["headroom"] = headroom(reference, [a.action_id for a in actions], baseline_id, baseline_id)
+            receipt["candidate_summary"] = [{"action": row["action"], "status": row["status"],
+                "completion": row.get("completion"), "cost": row.get("metrics", {}).get("cost"),
+                "paired_service_preserved": row.get("paired_service_preserved")}
+                for row in reference["rows"]]
+            receipt["reference_limit"] = "all current public next hops plus WAIT only; subsequent requests/routes and transfer assignment not exhaustively optimized"
+        receipt["parent_unchanged"] = session.offline_state_sha256() == parent_hash
+        assert receipt["parent_unchanged"]
+        receipt["status"] = "executed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["traceback"] = traceback.format_exc()
+    finally:
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = [p for p, h in receipt["source_before"].items() if receipt["source_after"][p] != h]
+        if receipt["source_changed"]:
+            receipt["status"] = "source_changed"
+        receipt["wall_seconds"] = time.perf_counter() - start
+        write_json(args.output / "receipt.json", receipt)
+    print(json.dumps(receipt, indent=2))
+    return int(receipt["status"] != "executed")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_regional_control.py b/scripts/experiments/g31_ics_circulation/validate_regional_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_regional_control.py
@@ -0,0 +1,113 @@
+"""R1 on-demand integration and native finite route reference, with raw receipts.
+
+This campaign certifies only the declared synthetic engineering contracts. Its
+Storage slack example deliberately has no business improvement to learn.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .finite_reference import Intervention, enumerate_interventions, headroom, outcome_cost
+from .native_host import audit_result, load_native, tiny_cycle
+from .regional_control import complete_on_demand, decode_route
+
+
+def write(path, value):
+    Path(path).write_text(json.dumps(value, indent=2, allow_nan=False), encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    native = load_native(args.binary)
+    files = [Path(__file__), Path(__file__).with_name("regional_control.py"),
+             Path(__file__).with_name("finite_reference.py"), Path(__file__).with_name("native_host.py")]
+    snapshot = lambda: {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    receipt = {"schema": "g31.regional_native_campaign.v1", "status": "running", "cases": [],
+               "source_before": snapshot(), "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+               "scope": "synthetic R1 integration and finite offline reference; not research gain or full 100ms validation"}
+    start = time.perf_counter()
+    base = tiny_cycle(); base["transfers"] = []; base["jobs"][0]["allow_suffix_reroute"] = True
+    scenarios = [("asynchronous_nonperiodic", base, .11, .01, 5., "allowed"),
+                 ("already_executed_prefix", base, 1.16, .01, 5., "allowed"),
+                 ("stale_computation", base, .11, .2, 5., "stale_executed_prefix"),
+                 ("expired_message", base, .11, .01, .001, "request_expired")]
+    denied = copy.deepcopy(base); denied["jobs"][0]["allow_suffix_reroute"] = False
+    scenarios.append(("permission_refusal", denied, .11, .01, 5., "route:service_obligation_disallows_reroute"))
+    fault = copy.deepcopy(base); fault["faults"] = [{"from": 0, "to": 1, "start": 0., "end": 20., "message_delay": .03}]
+    scenarios.append(("delivered_fault_detour", fault, .11, .01, 5., "allowed"))
+    try:
+        for name, data, at, delay, lease, expected in scenarios:
+            folder = args.output / name; folder.mkdir()
+            write(folder / "input.json", data)
+            session = native.NativeSession(data); session.advance_to(at)
+            observation = session.observe("A"); write(folder / "observation.json", observation)
+            baseline = session.fork().result_at(30)
+            measured = complete_on_demand(session, "A", "T0", name,
+                                          logical_compute_delay=delay, lease_seconds=lease)
+            request = measured["submission"]
+            result = session.result_at(30)
+            delivered = session.observe("A")["route_requests"]
+            final = delivered[-1] if delivered else request["response"]
+            write(folder / "request.json", request); write(folder / "final_response.json", final)
+            write(folder / "complete_compute_measurement.json", measured)
+            write(folder / "result.json", result); write(folder / "baseline_result.json", baseline)
+            audits = {"candidate": audit_result(data, result), "baseline": audit_result(data, baseline)}
+            write(folder / "audits.json", audits)
+            assert final["reason"] == expected, (name, final)
+            if name == "delivered_fault_detour":
+                assert decode_route(request["encoded_route"]).replaceable_suffix == (0, 6, 2)
+                assert next(r for r in result["receipts"] if r["event"] == "EDGE_ENTER")["to"] == 6
+            if name == "already_executed_prefix":
+                assert decode_route(request["encoded_route"]).committed_prefix == (0, 1)
+            receipt["cases"].append({"name": name, "response": final,
+                                     "compute_wall_ms": measured["compute_wall_ms"],
+                                     "compute_cpu_ms": measured["compute_cpu_ms"],
+                                     "meets_measured_100ms": measured["meets_measured_100ms"],
+                                     "cost": outcome_cost(result, data["jobs"], 30),
+                                     "baseline_cost": outcome_cost(baseline, data["jobs"], 30)})
+        # Compare actual alternative paths at one real boundary. Both reach
+        # Storage before its fixed release, so raw movement differs but the
+        # release slack absorbs the business-time difference.
+        session = native.NativeSession(base); session.advance_to(.11)
+        visible = session.observe("A"); tray = visible["trays"][0]
+        actions = [Intervention("WAIT", "wait")]
+        for next_node in (1, 6):
+            request = {"request_id": f"suffix-{next_node}", "owner_id": "A", "business_bag_id": "B1", "tray_id": "T0",
+                       "from": 0, "next": next_node, "expected_generation": tray["generation"],
+                       "expected_traversal": tray["traversal_id"], "expiry": 2., "message_delay": .01}
+            actions.append(Intervention(f"route-{next_node}", "route", request))
+        reference = enumerate_interventions(session, actions, horizon=30., job_contracts=base["jobs"],
+                                             baseline_action_id="route-1", validate=lambda r, a: audit_result(base, r))
+        write(args.output / "slack_absorption_reference.json", reference)
+        comparison = headroom(reference, [a.action_id for a in actions], "route-1", "route-1")
+        write(args.output / "headroom.json", comparison)
+        assert reference["optimality"] == "optimal_in_enumerated_domain"
+        assert reference["distinct_verified_physical_outcomes"] == 2
+        assert comparison["reference_headroom"] == 0
+        receipt["reference"] = {k: v for k, v in reference.items() if k != "rows"}
+        receipt["headroom"] = comparison
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["traceback"] = traceback.format_exc()
+    finally:
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = [p for p, h in receipt["source_before"].items() if receipt["source_after"][p] != h]
+        if receipt["source_changed"]:
+            receipt["status"] = "source_changed_development_only"
+        receipt["wall_seconds"] = time.perf_counter() - start
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "headroom", "traceback") if k in receipt}))
+    return 0 if receipt["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
