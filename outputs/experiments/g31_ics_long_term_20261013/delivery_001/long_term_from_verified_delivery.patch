+++ b/tests/test_g31_circulation_session.py
@@ -0,0 +1,162 @@
+"""Actual native continuations and policy-visible information boundaries."""
+from copy import deepcopy
+import os
+from pathlib import Path
+import pytest
+from scripts.experiments.g31_ics_circulation.native_host import load_native, tiny_cycle, audit_result
+
+
+@pytest.fixture(scope="module")
+def native():
+    return load_native(os.environ.get("G31_CIRCULATION_BINARY", str(next(
+        (Path(__file__).absolute().parents[1]/"build_lt_session/python").glob("czr005_circulation*.pyd")))))
+
+
+def request(now=10):
+    return dict(request_id="live:online-1",owner_id="B",tray_id="T0",source=4,destination=0,
+                earliest_departure=now,expiry=60,message_delay=0)
+
+
+def without_return():
+    data=tiny_cycle();data["transfers"]=[];return data
+
+
+@pytest.mark.parametrize("boundary", [.05,.12,1.2,3,6,8.2,9,10,14])
+def test_live_restore_is_same_continuation(native,boundary):
+    data=tiny_cycle();a=native.NativeSession(data);a.advance_to(boundary)
+    checkpoint=a.checkpoint();b=native.NativeSession(data);b.restore(checkpoint)
+    assert a.offline_state_sha256()==b.offline_state_sha256()
+    ar=a.result_at(70);br=b.result_at(70)
+    for key in ["receipts","jobs","trays","transfers","population"]: assert ar[key]==br[key]
+    assert a.offline_state_sha256()==b.offline_state_sha256()
+    audit_result(data,ar)
+
+
+def test_quiescent_siblings_diverge_only_after_explicit_action(native):
+    data=without_return();parent=native.NativeSession(data);parent.advance_to(10)
+    before=parent.offline_state_sha256();a=parent.fork();b=parent.fork()
+    assert a.submit_transfer_intent(request())["status"]=="pending"
+    assert b.offline_state_sha256()==before==parent.offline_state_sha256()
+    ar=a.result_at(70);br=b.result_at(70)
+    assert ar["jobs"][1]["status"]=="completed"
+    assert br["jobs"][1]["status"]=="waiting_for_tray"
+    replay=deepcopy(data);r=request();r.pop("owner_id");r["issued_at"]=10;replay["transfers"].append(r)
+    audit_result(replay,ar);audit_result(data,br)
+
+
+def test_future_environment_never_changes_current_observation(native):
+    first=without_return();first["jobs"][1]["arrival"]=50
+    second=deepcopy(first);second["jobs"][1]["arrival"]=60
+    second["jobs"].append(dict(second["jobs"][1],business_bag_id="unpublished",arrival=70))
+    second["faults"]=[{"from":0,"to":1,"start":40,"end":45}]
+    a=native.NativeSession(first);b=native.NativeSession(second)
+    for t in [0,.11,1,3,8,12]:
+        a.advance_to(t);b.advance_to(t)
+        for owner in ["A","B"]: assert a.observe(owner)==b.observe(owner)
+
+
+def test_delayed_demand_is_an_immutable_observed_snapshot(native):
+    s=native.NativeSession(without_return());s.advance_to(.25)
+    assert s.publish_demand("A","B",1)["status"]=="pending"
+    assert s.observe("B")["delivered_messages"]==[]
+    snapshot=s.checkpoint();s.advance_to(1.25)
+    msg=s.observe("B")["delivered_messages"][0]
+    assert msg["observed_at"]==.25 and msg["delivered_at"]==1.25
+    assert [j["business_bag_id"] for j in msg["jobs"]]==["B2"]
+    msg["jobs"].clear()
+    assert s.observe("B")["delivered_messages"][0]["jobs"]
+    branch=native.NativeSession(without_return());branch.restore(snapshot);branch.advance_to(1.25)
+    assert branch.observe("B")==s.observe("B")
+
+
+def route_request(observation, delay=.01):
+    t=next(t for t in observation["trays"] if t["tray_id"]=="T0")
+    return dict(request_id="route-1",owner_id="A",business_bag_id="B1",tray_id="T0",
+                **{"from":0,"next":6}, expected_generation=t["generation"],
+                expected_traversal=t["traversal_id"],expiry=2,message_delay=delay)
+
+
+@pytest.mark.parametrize("permission,delay,reason", [(True,.01,"allowed"),(False,.01,"service_obligation_disallows_reroute"),(True,.2,"stale_executed_prefix")])
+def test_asynchronous_route_request_obeys_prefix_and_service_permission(native,permission,delay,reason):
+    data=without_return();data["jobs"][0]["allow_suffix_reroute"]=permission
+    s=native.NativeSession(data);s.advance_to(.11)
+    assert s.submit_route_intent(route_request(s.observe("A"),delay))["status"]=="pending"
+    result=s.result_at(30)
+    requests=s.observe("A")["route_requests"]
+    assert requests[0]["reason"]==reason
+    first=next(r for r in result["receipts"] if r["event"]=="EDGE_ENTER")
+    assert first["to"]==(6 if reason=="allowed" else 1)
+    audit_result(data,result)
+
+
+def test_transfer_permission_staleness_and_cancellation(native):
+    s=native.NativeSession(without_return());s.advance_to(10)
+    wrong=request();wrong["owner_id"]="A"
+    assert s.submit_transfer_intent(wrong)==dict(status="rejected",reason="resource_owner_mismatch")
+    stale=request();stale["expected_version"]=999999
+    assert s.submit_transfer_intent(stale)["reason"]=="stale_observation"
+    assert s.submit_transfer_intent(request())["status"]=="pending"
+    assert s.cancel_transfer_intent("live:online-1","A")["status"]=="rejected"
+    assert s.cancel_transfer_intent("live:online-1","B")["status"]=="cancelled"
+    assert s.result_at(70)["jobs"][1]["status"]=="waiting_for_tray"
+
+
+def test_committed_empty_prefix_cannot_be_cancelled(native):
+    s=native.NativeSession(without_return());s.advance_to(10);s.submit_transfer_intent(request());s.advance_to(10.1)
+    assert s.cancel_transfer_intent("live:online-1","B")["reason"]=="already_committed"
+    assert s.result_at(70)["jobs"][1]["status"]=="completed"
+
+
+def test_closed_edge_is_preserved_and_never_entered(native):
+    data=tiny_cycle();data["edge_contracts"][0]["capacity"]=0
+    result=native.run(data)
+    assert all(not(r["event"]=="EDGE_ENTER" and (r["from"],r["to"])==(0,1)) for r in result["receipts"])
+    assert all(j["status"]=="completed" for j in result["jobs"])
+    audit_result(data,result)
+
+
+def test_event_budget_does_not_jump_over_unprocessed_physics(native):
+    s=native.NativeSession(tiny_cycle());r=s.advance_to(70,max_events=1)
+    assert r["status"]=="budget_exhausted" and s.physical_time<70
+    assert s.result_at(70)["jobs"][1]["status"]=="completed"
+
+
+def test_failed_empty_attempt_recovers_with_new_authority_without_erasing_history(native):
+    data=tiny_cycle();data["transfers"][0]["expiry"]=11
+    data["faults"]=[{"from":4,"to":5,"start":0.,"end":30.,"message_delay":4.}]
+    s=native.NativeSession(data);s.advance_to(12)
+    assert s.observe("B")["trays"][0]["mode"]=="quarantined"
+    assert s.recover_empty_tray("recover-1","A","T0")["status"]=="rejected"
+    assert s.recover_empty_tray("recover-1","B","T0",.5)["status"]=="pending"
+    branch=s.fork();s.advance_to(12.5);branch.advance_to(12.5)
+    assert s.offline_state_sha256()==branch.offline_state_sha256()
+    assert s.observe("B")["trays"][0]["mode"]=="empty"
+    s.advance_to(34)
+    new=request(34);new["request_id"]="live:fresh-after-repair"
+    assert s.submit_transfer_intent(new)["status"]=="pending"
+    result=s.result_at(75)
+    assert result["transfers"][0]["status"]=="failed"
+    assert result["transfers"][1]["status"]=="received"
+    assert all(j["status"]=="completed" for j in result["jobs"])
+    replay=deepcopy(data);new.pop("owner_id");new["issued_at"]=34;replay["transfers"].append(new)
+    audit_result(replay,result)
+
+
+@pytest.mark.parametrize("blocker,reason", [("static_suffix", "no_static_legal_suffix"),
+                                           ("notified_fault", "advertised_fault")])
+def test_route_update_cannot_claim_a_known_invalid_old_or_new_route(native, blocker, reason):
+    data = without_return()
+    data["jobs"][0].update(allow_suffix_reroute=True, deadline=-1)
+    if blocker == "static_suffix":
+        for edge in data["edge_contracts"]:
+            if edge["from"] == 6:
+                edge["capacity"] = 0
+    else:
+        data["faults"] = [{"from": 0, "to": 6, "start": 0., "end": 20., "message_delay": 0.}]
+    s = native.NativeSession(data); s.advance_to(.11)
+    assert s.submit_route_intent(route_request(s.observe("A")))["status"] == "pending"
+    result = s.result_at(30)
+    reply = s.observe("A")["route_requests"][0]
+    assert reply["status"] == "rejected" and reply["reason"] == reason
+    assert next(r for r in result["receipts"] if r["event"] == "EDGE_ENTER")["to"] == 1
+    audit_result(data, result)
diff --git a/tests/test_g31_circulation_single_tray_lower_bound.py b/tests/test_g31_circulation_single_tray_lower_bound.py
--- /dev/null
+++ b/tests/test_g31_circulation_single_tray_lower_bound.py
@@ -0,0 +1,106 @@
+"""Independent contract counterexamples for the narrow offline FIFO bound."""
+import copy
+
+import pytest
+
+from scripts.experiments.g31_ics_circulation.single_tray_lower_bound import (
+    check_actual, fifo_travel_bound,
+)
+
+
+def contract():
+    # The tempting direct shortcut is closed. Huge node service is deliberately
+    # omitted from the lower bound, while mandatory Storage, hold and reuse stay.
+    edges = [(0, 1, 2., 1.), (1, 2, 3., 1.), (2, 0, 4., 1.), (0, 2, .1, 1.)]
+    return {
+        "node_records": [(n, 1, 100., n, 0, []) for n in range(3)],
+        "node_contracts": [{"node": n, "capacity": 1} for n in range(3)],
+        "edge_records": edges,
+        "edge_contracts": [{"from": u, "to": v, "capacity": 0 if (u, v) == (0, 2) else 1}
+                           for u, v, _, _ in edges],
+        "trays": [{"tray_id": "T", "node": 0}],
+        "jobs": [
+            {"business_bag_id": "A", "arrival": 0., "origin": 0, "destination": 2,
+             "deadline": 14., "storage_node": 1, "storage_release_at": 10.,
+             "storage_min_dwell": 5., "load_seconds": 1., "unload_seconds": 2., "hold_seconds": 3.},
+            {"business_bag_id": "B", "arrival": 4., "origin": 0, "destination": 2,
+             "deadline": 30., "load_seconds": 1., "unload_seconds": 1., "hold_seconds": 0.},
+        ],
+        "options": {"queue_discipline": "fifo"},
+    }
+
+
+def test_storage_absolute_release_and_dwell_overlap_and_physical_reuse_is_mandatory():
+    result = fifo_travel_bound(contract(), 100.)
+    a, b = result["rows"]
+    assert a["storage_entry_lower_bound"] == 3.
+    # Absolute release 10 overlaps dwell [3, 8]; adding them would be invalid.
+    assert a["storage_release_lower_bound"] == 10.
+    assert a["completion_lower_bound"] == 15.
+    assert a["next_loader_ready_lower_bound"] == 22.  # unload15 + hold3 + return4
+    assert b["load_start_lower_bound"] == 22.
+    assert b["completion_lower_bound"] == 29.  # closed direct shortcut excluded
+    assert b["positive_capacity_directed_paths"]["loaded_direct"] == [0, 1, 2]
+    assert result["restricted_sojourn_lower_bound"] == 40.
+    assert result["minimum_deadline_misses"] == 1
+
+
+def test_restriction_at_horizon_keeps_both_jobs_and_unfinished_time():
+    result = fifo_travel_bound(contract(), 20.)
+    assert result["offered"] == 2
+    assert result["restricted_sojourn_lower_bound"] == 31.  # 15 + (20 - 4)
+
+
+def test_reverse_edge_cannot_be_invented_to_make_empty_return_possible():
+    data = contract()
+    data["edge_records"] = [e for e in data["edge_records"] if e[:2] != (2, 0)]
+    with pytest.raises(ValueError, match="no_positive_capacity_directed_path:2:0"):
+        fifo_travel_bound(data, 100.)
+
+
+@pytest.mark.parametrize("change,reason", [
+    ("second_tray", "requires_one_tray"),
+    ("second_origin", "requires_one_fifo_origin"),
+    ("same_time_arrival", "simultaneous_arrivals"),
+    ("non_fifo", "non_fifo_contract"),
+])
+def test_declines_populations_where_the_sequence_proof_does_not_apply(change, reason):
+    data = contract()
+    if change == "second_tray":
+        data["trays"].append({"tray_id": "T2", "node": 0})
+    elif change == "second_origin":
+        data["jobs"][1]["origin"] = 1
+    elif change == "same_time_arrival":
+        data["jobs"][1]["arrival"] = 0.
+    else:
+        data["options"]["queue_discipline"] = "priority"
+    with pytest.raises(ValueError, match=reason):
+        fifo_travel_bound(data, 100.)
+
+
+def actual():
+    return {"receipts": [{"event": "LOAD_START", "business_bag_id": b, "tray_id": "T"} for b in ("A", "B")],
+            "jobs": [{"business_bag_id": "A", "completed_at": 17., "status": "completed"},
+                     {"business_bag_id": "B", "completed_at": 34., "status": "completed"}]}
+
+
+def test_actual_full_population_gap_and_sequence_are_checked():
+    data = contract()
+    bound = fifo_travel_bound(data, 100.)
+    result = check_actual(bound, actual(), data)
+    assert result["metrics"]["offered"] == 2
+    assert result["restricted_sojourn_gap_to_lower_bound"] == 7.
+    assert result["actual_deadline_misses"] == 2
+    wrong_order = actual()
+    wrong_order["receipts"].reverse()
+    with pytest.raises(ValueError, match="actual_loading_sequence"):
+        check_actual(bound, wrong_order, data)
+
+
+def test_any_bound_exceeding_actual_completion_is_rejected():
+    data = contract()
+    bound = fifo_travel_bound(data, 100.)
+    result = copy.deepcopy(actual())
+    result["jobs"][1]["completed_at"] = 28.
+    with pytest.raises(ValueError, match="bound_exceeds_actual_completion"):
+        check_actual(bound, result, data)
diff --git a/tests/test_g31_fixed_blocking_certificate.py b/tests/test_g31_fixed_blocking_certificate.py
--- /dev/null
+++ b/tests/test_g31_fixed_blocking_certificate.py
@@ -0,0 +1,38 @@
+"""The restricted state certificate must fail closed when a premise changes."""
+import copy
+import pytest
+from scripts.experiments.g31_ics_circulation.certify_original_blocking import certify
+
+
+def fixture():
+    data={"node_contracts":[{"node":n,"capacity":2 if n==1 else 1} for n in range(4)],
+        "edge_contracts":[{"from":0,"to":1,"capacity":1},{"from":1,"to":2,"capacity":1},
+                          {"from":2,"to":3,"capacity":0}],
+        "jobs":[{"business_bag_id":f"B{i}","storage_node":1,"destination":goal}
+                for i,goal in enumerate([3,2,2])],"faults":[],"transfers":[]}
+    snapshot={"trays":[{"node":n,"active_leg":i,"mode":"loaded","edge_to":-1,"reception_node":-1}
+                        for i,n in enumerate([1,1,0])],
+        "legs":[{"runtime_id":i,"job_index":i,"kind":"storage_out" if i<2 else "storage_in"} for i in range(3)],
+        "junctions":[{"node":1,"queue":[0,1]},{"node":0,"queue":[2]}],
+        "resource_waits":[{"runtime_id":0,"node":1,"static_blocked":True,"receiving_nodes":[]},
+                          {"runtime_id":2,"node":0,"static_blocked":False,"receiving_nodes":[1]}]}
+    return data,snapshot
+
+
+def test_certificate_proves_only_the_declared_dead_end():
+    data,snapshot=fixture()
+    result=certify(data,snapshot)
+    assert result["status"]=="proved_under_listed_fixed_contract"
+    assert result["global_optimality"]=="unknown"
+    assert result["airport_physical_infeasibility_claim"] is False
+
+
+@pytest.mark.parametrize("variant",["reachable_head","empty_tray","missing_fifo_occupant","fault_tape","wrong_stage"])
+def test_broken_premise_returns_unknown(variant):
+    data,snapshot=copy.deepcopy(fixture())
+    if variant=="reachable_head":data["jobs"][0]["destination"]=2
+    if variant=="empty_tray":snapshot["trays"][2]["mode"]="empty"
+    if variant=="missing_fifo_occupant":snapshot["junctions"][0]["queue"]= [0]
+    if variant=="fault_tape":data["faults"].append({"reason":"future change unknown"})
+    if variant=="wrong_stage":snapshot["legs"][2]["kind"]="direct"
+    assert certify(data,snapshot)["status"]=="unknown"
diff --git a/tests/test_g31_original_mechanism.py b/tests/test_g31_original_mechanism.py
--- /dev/null
+++ b/tests/test_g31_original_mechanism.py
@@ -0,0 +1,27 @@
+"""A mechanism subset is selected from source rules, never observed winners."""
+from collections import Counter
+import pytest
+
+from scripts.experiments.g31_ics_circulation.original_mechanism import select_input
+from scripts.experiments.g31_ics_circulation.original_workload import ProxyContract, build_input
+
+
+@pytest.mark.parametrize("count",[2,24])
+def test_prespecified_subset_keeps_full_graph_and_original_business(count):
+    data, selection, lineage = select_input(count)
+    parent, _, _ = build_input(scale=1,contract=ProxyContract(
+        "nanning-on-carrier-proxy-v1-n4-s4-t2",4,4,2,1.,1.,0.,"finite_berth_waiting_research_proxy"))
+    originals = {j["business_bag_id"]:j for j in parent["jobs"]}
+    assert all(j == originals[j["business_bag_id"]] for j in data["jobs"])
+    assert len(data["jobs"]) == count
+    assert data["node_records"] == parent["node_records"]
+    assert data["edge_records"] == parent["edge_records"]
+    assert data["node_contracts"] == parent["node_contracts"]
+    assert data["edge_contracts"] == parent["edge_contracts"]
+    assert len(data["trays"]) == 1 and data["trays"][0] in parent["trays"]
+    assert data["transfers"] == []
+    assert selection["selected_without_simulation_results"]
+    assert selection["mother_offered"] == len(lineage) == 28506
+    assert sum(r["selected_for_witness"] for r in lineage) == count
+    assert all(r["eligibility"] == "eligible_static_round_trip" for r in lineage if r["selected_for_witness"])
+    assert Counter(r["eligibility"] for r in lineage) == selection["eligibility_counts"]
