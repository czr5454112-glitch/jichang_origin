+    message, = s.observe_protocol("B")["delivered_messages"]
+    assert message["observed_at"] == .5 and message["delivered_at"] == 2.
+    assert [j["business_bag_id"] for j in message["jobs"]] == ["B2"]
+    assert message["message_id"] == final["result_id"]
