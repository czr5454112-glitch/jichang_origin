+++ b/scripts/experiments/g31_ics_circulation/probe_protocol_route_aba.py
@@ -0,0 +1,153 @@
+"""Actual native route A/B/A lifecycle probe with unchanged fault knowledge.
+
+The second tray physically enters and leaves a local branch. Its occupancy
+changes the public A* preference while the main tray remains at one stage.
+Historical successful ACKs must not stand for the latest installed intent.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import traceback
+
+from . import protocol_control
+from .native_host import audit_result, load_native, prepare_input, tiny_cycle
+from .original_workload import write_json
+from .regional_control import public_astar
+
+
+def scene():
+    data = tiny_cycle()
+    data["transfers"] = []
+    data["jobs"] = data["jobs"][:1]
+    data["jobs"][0]["allow_suffix_reroute"] = True
+    edges = [(u, v, 1.02 if (u, v) == (0, 6) else length, speed)
+             for u, v, length, speed in data["edge_records"]]
+    edges += [(7, 1, .1, 1.), (1, 8, .2, 1.)]
+    data["edge_records"] = edges
+    data["node_records"] = [
+        (n, 3 if n == 2 else 1, 10. if n == 0 else .5 if n in (1, 6) else .05,
+         n, 0, [v for u, v, _, _ in edges if u == n]) for n in range(9)]
+    data["node_contracts"] += [{"node": n, "zone": "A", "capacity": 1} for n in (7, 8)]
+    data["edge_contracts"] = [{"from": u, "to": v, "capacity": 1, "entry_headway": .2}
+                              for u, v, *_ in edges]
+    data["trays"].append({"tray_id": "T_OCC", "node": 7})
+    for bag, origin, destination, arrival in [("OCC_ENTER", 7, 1, .2), ("OCC_LEAVE", 1, 8, 1.)]:
+        data["jobs"].append({"business_bag_id": bag, "origin": origin, "destination": destination,
+            "arrival": arrival, "deadline": 40., "load_seconds": .01, "unload_seconds": .05,
+            "hold_seconds": .05, "protected_service": True, "allow_suffix_reroute": True})
+    data["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02}
+    data["model_scope"] = "native same-stage route A/B/A from actual local occupancy; no fault changes"
+    return prepare_input(data)
+
+
+class CapturePublic:
+    def __init__(self, session):
+        self.session = session
+        self.observations = []
+
+    def __getattr__(self, name):
+        return getattr(self.session, name)
+
+    def observe_protocol_control(self, owner):
+        observation = self.session.observe_protocol_control(owner)
+        if owner == "A":
+            self.observations.append(copy.deepcopy(observation))
+        return observation
+
+
+def execute(module, native, output):
+    data = scene()
+    write_json(output / "input.json", data)
+    raw = native.NativeSession(data)
+    raw.advance_to(.11)
+    captured = CapturePublic(raw)
+    run = module.run_protocol_control(captured, ["A", "B"], horizon=2.6,
+                                     forecasts=False, prebalance=False, lease_seconds=5.)
+    audit = audit_result(data, run["result"])
+    calls = [c for c in run["client_calls"] if c["kind"] == "route" and not c["retry"]
+             and c["request"]["tray_id"] == "T0"]
+    ids = {c["request"]["request_id"] for c in calls}
+    acks = [a for a in raw.observe_protocol("A")["delivered_command_acks"] if a["request_id"] in ids]
+    observations = []
+    for observed in captured.observations:
+        tray = next(t for t in observed["trays"] if t["tray_id"] == "T0")
+        path = public_astar(observed, tray["node"], 2)
+        observations.append({"at": observed["now"], "path": list(path),
+            "stage_identity": [tray[k] for k in ("node", "generation", "traversal_id", "business_bag_id")],
+            "known_faults": observed["known_faults"],
+            "branch_occupancy": {str(n["node"]): n.get("occupancy") for n in observed["node_contracts"]
+                                 if n["node"] in (1, 6)}})
+    transitions = []
+    for observed in observations:
+        nxt = observed["path"][1]
+        if not transitions or transitions[-1]["next"] != nxt:
+            transitions.append({"at": observed["at"], "next": nxt})
+    fixture_valid = (run["status"] == "reached" and audit["status"] == "passed"
+        and [r["next"] for r in transitions] == [1, 6, 1]
+        and len({tuple(o["stage_identity"]) for o in observations}) == 1
+        and all(o["known_faults"] == [] for o in observations))
+    first = next((c for c in calls if c["request"]["next"] == 1), None)
+    b = next((c for c in calls if c["request"]["next"] == 6), None)
+    first_updated = first is not None and any(a["request_id"] == first["request"]["request_id"]
+        and a["status"] == "updated" for a in acks)
+    b_updated = b is not None and any(a["request_id"] == b["request"]["request_id"]
+        and a["status"] == "updated" for a in acks)
+    last_a = [c for c in calls if c["request"]["next"] == 1 and b and c["at"] > b["at"]]
+    fresh_a_updated = any(a["request_id"] in {c["request"]["request_id"] for c in last_a}
+        and a["status"] == "updated" for a in acks)
+    old_lease_still_live = bool(first and len(transitions) == 3
+        and first["request"]["expiry"] > transitions[2]["at"])
+    receipt = {"name": "native_same_stage_route_aba", "fixture_valid": fixture_valid,
+        "transitions": transitions, "first_a_updated": first_updated, "b_updated": b_updated,
+        "first_a_lease_live_on_return": old_lease_still_live, "fresh_a_updated_on_return": fresh_a_updated,
+        "fixed": fixture_valid and first_updated and b_updated and old_lease_still_live and fresh_a_updated,
+        "route_calls": [{"at": c["at"], **c["request"]} for c in calls], "route_acks": acks,
+        "audit": audit, "public_observations": observations}
+    with gzip.open(output / "raw.json.gz", "wt", encoding="utf-8") as stream:
+        json.dump({"run": run, "public_observations": captured.observations}, stream, allow_nan=False)
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--controller-source", type=Path)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    module = protocol_control
+    source = args.controller_source or Path(protocol_control.__file__)
+    if args.controller_source:
+        name = "scripts.experiments.g31_ics_circulation._frozen_route_aba_controller"
+        spec = importlib.util.spec_from_file_location(name, source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt = {"schema": "g31.protocol_route_aba_probe.v1", "status": "running",
+        "controller_source": str(source), "source_before": before,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest()}
+    try:
+        receipt["case"] = execute(module, load_native(args.binary), args.output)
+        receipt["status"] = "passed" if receipt["case"]["fixed"] else "failed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["source_after"] = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt["source_changed"] = [] if receipt["source_after"] == before else [str(source)]
+    write_json(args.output / "receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "source_changed", "exception") if k in receipt}))
+    return int(bool(receipt["source_changed"]) or (args.require_fixed and receipt["status"] != "passed"))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/probe_protocol_tick_boundary.py b/scripts/experiments/g31_ics_circulation/probe_protocol_tick_boundary.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/probe_protocol_tick_boundary.py
@@ -0,0 +1,118 @@
+"""Native nextafter horizon and strict controller continuation probes."""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import traceback
+
+from . import protocol_control
+from .native_host import load_native, tiny_cycle
+from .original_workload import write_json
+
+
+def scene():
+    data = tiny_cycle()
+    data["transfers"] = []
+    data["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02}
+    return data
+
+
+def execute(module, native, output):
+    data = scene()
+    write_json(output / "input.json", data)
+    options = {"routes": False, "forecasts": False, "prebalance": False}
+    boundary = math.nextafter(.61, -math.inf)
+    split = native.NativeSession(data)
+    split.advance_to(.11)
+    result = {"requested_split_horizon": boundary, "next_control_tick": .11 + .5,
+              "horizon_hex": boundary.hex(), "tick_hex": (.11 + .5).hex()}
+    artifacts = {}
+    try:
+        prefix = module.run_protocol_control(split, ["A", "B"], horizon=boundary, **options)
+        result["split_status"] = prefix["status"]
+        result["physical_time_at_return"] = split.physical_time
+        saved = split.checkpoint()
+        parent_hash = split.offline_state_sha256()
+        state = json.loads(json.dumps(prefix["controller_state"], allow_nan=False))
+        before_state = copy.deepcopy(state)
+        resumed_native = native.NativeSession(data)
+        resumed_native.restore(saved)
+        resumed = module.run_protocol_control(resumed_native, ["A", "B"], horizon=1.3, state=state, **options)
+        full_native = native.NativeSession(data)
+        full_native.advance_to(.11)
+        full = module.run_protocol_control(full_native, ["A", "B"], horizon=1.3, **options)
+        equality = {key: resumed["result"][key] == full["result"][key]
+                    for key in ("jobs", "trays", "transfers", "receipts", "leg_identities")}
+        equality.update(controller_state=resumed["controller_state"] == full["controller_state"],
+            native_state=resumed_native.offline_state_sha256() == full_native.offline_state_sha256(),
+            parent_unchanged=split.offline_state_sha256() == parent_hash,
+            input_state_unchanged=state == before_state)
+        result["continuation_equalities"] = equality
+        artifacts.update(prefix=prefix, resumed=resumed, full=full)
+        result["split_fixed"] = (prefix["status"] == resumed["status"] == full["status"] == "reached"
+                                 and result["physical_time_at_return"] == boundary and all(equality.values()))
+    except Exception as error:
+        result.update(split_fixed=False, split_exception_type=type(error).__name__, split_exception=str(error),
+                      physical_time_at_return=split.physical_time, split_exception_trace=traceback.format_exc())
+    result["native_advanced_past_requested_horizon"] = result["physical_time_at_return"] > boundary
+
+    past = native.NativeSession(data)
+    past.advance_to(.11)
+    before = past.offline_state_sha256()
+    try:
+        artifacts["past_horizon_run"] = module.run_protocol_control(past, ["A", "B"],
+            horizon=math.nextafter(.11, -math.inf), **options)
+        result["past_horizon_rejected"] = False
+    except ValueError as error:
+        result["past_horizon_rejected"] = True
+        result["past_horizon_error"] = str(error)
+    result["past_horizon_state_unchanged"] = past.offline_state_sha256() == before
+    result["fixed"] = result["split_fixed"] and result["past_horizon_rejected"] and result["past_horizon_state_unchanged"]
+    with gzip.open(output / "raw.json.gz", "wt", encoding="utf-8") as stream:
+        json.dump(artifacts, stream, allow_nan=False)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--controller-source", type=Path)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    module = protocol_control
+    source = args.controller_source or Path(protocol_control.__file__)
+    if args.controller_source:
+        name = "scripts.experiments.g31_ics_circulation._frozen_tick_boundary_controller"
+        spec = importlib.util.spec_from_file_location(name, source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt = {"schema": "g31.protocol_tick_boundary_probe.v1", "status": "running",
+        "controller_source": str(source), "source_before": before,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest()}
+    try:
+        receipt["case"] = execute(module, load_native(args.binary), args.output)
+        receipt["status"] = "passed" if receipt["case"]["fixed"] else "failed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["source_after"] = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt["source_changed"] = [] if receipt["source_after"] == before else [str(source)]
+    write_json(args.output / "receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "source_changed", "exception") if k in receipt}))
+    return int(bool(receipt["source_changed"]) or (args.require_fixed and receipt["status"] != "passed"))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/protocol_control.py b/scripts/experiments/g31_ics_circulation/protocol_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/protocol_control.py
@@ -0,0 +1,370 @@
+"""Public-state R1/R2 controller over native delivered-ACK message endpoints.
+
+The controller owns request identities, immutable payloads, retries and its
+control phase. It does not read offline results to make a decision. Physical
+time, messages, owner authorization and tray motion remain in the G31 host.
+"""
+from __future__ import annotations
+
+import copy
+import json
+import math
+import time
+from typing import Any
+
+from .analytic_control import transfer_candidates
+from .regional_control import decode_route, encode_route, make_route_packet, public_astar
+
+
+TERMINAL = {"received", "rejected", "cancelled", "failed", "expired", "updated", "delivered", "withdrawn"}
+
+
+class ProtocolClient:
+    """Serializable client outbox. No unacknowledged server truth is inspected."""
+
+    def __init__(self, session: Any, *, retry_period: float = 1., state: dict | None = None):
+        if not math.isfinite(retry_period) or retry_period <= 0:
+            raise ValueError("protocol_client:invalid_retry_period")
+        self.session = session
+        self.state = copy.deepcopy(state) if state is not None else {
+            "schema": "g31.protocol_client_state.v1", "retry_period": retry_period,
+            "sequences": {}, "outbox": {}}
+        if self.state.get("schema") != "g31.protocol_client_state.v1" or self.state["retry_period"] != retry_period:
+            raise ValueError("protocol_client:state_configuration_mismatch")
+        self.calls: list[dict] = []
+
+    def next_id(self, owner: str, kind: str) -> str:
+        n = self.state["sequences"].get(owner, 0)
+        self.state["sequences"][owner] = n + 1
+        return f"live:{len(owner.encode('utf-8'))}:{owner}:{kind}:{n}"
+
+    def _send(self, row: dict, *, retry: bool) -> dict:
+        payload = copy.deepcopy(row["payload"])
+        started = time.perf_counter()
+        reply = (self.session.submit_protocol_transfer(payload) if row["kind"] == "transfer"
+                 else self.session.submit_protocol_command(payload))
+        self.calls.append({"at": self.session.physical_time, "retry": retry,
+                           "kind": row["kind"], "request": payload, "reply": copy.deepcopy(reply),
+                           "submit_compute_ms": 1000*(time.perf_counter()-started)})
+        row["next_retry"] = self.session.physical_time + self.state["retry_period"]
+        row["submission_reply"] = copy.deepcopy(reply)
+        if reply.get("status") == "rejected":
+            row["terminal"] = True
+        return reply
+
+    def submit(self, owner: str, kind: str, payload: dict, *, request_id: str | None = None) -> tuple[str, dict]:
+        request = copy.deepcopy(payload)
+        # The protocol validates physical/owner dependencies on delivery. The
+        # legacy truth-derived owner_version is deliberately unavailable here.
+        request.pop("expected_version", None)
+        request["request_id"] = request_id if request_id is not None else self.next_id(owner, kind)
+        if request["request_id"] in self.state["outbox"]:
+            raise ValueError("protocol_client:duplicate_id_use_saved_payload_retry")
+        request["owner_id"] = owner
+        if kind != "transfer":
+            request["kind"] = kind
+        row = {"kind": kind, "payload": request, "terminal": False,
+               "created_at": self.session.physical_time}
+        self.state["outbox"][request["request_id"]] = row
+        return request["request_id"], self._send(row, retry=False)
+
+    def refresh(self, *, retry: bool = True) -> list[dict]:
+        views = []
+        for request_id, row in self.state["outbox"].items():
+            if row["terminal"]:
+                continue
+            owner = row["payload"]["owner_id"]
+            view = (self.session.protocol_request(owner, request_id) if row["kind"] == "transfer"
+                    else self.session.protocol_command(owner, request_id))
+            row["client_view"] = copy.deepcopy(view)
+            ack = view.get("last_delivered_ack", {})
+            row["terminal"] = ack.get("status") in TERMINAL
+            views.append({"request_id": request_id, "kind": row["kind"], "view": copy.deepcopy(view)})
+            # acknowledged pending/granted is a snapshot, not final receipt.
+            # Poll it with the same immutable payload, never a second order.
+            if retry and not row["terminal"] and self.session.physical_time >= row["next_retry"]:
+                self._send(row, retry=True)
+        return views
+
+    def view(self, owner: str, *, compact: bool = True) -> dict:
+        result = (self.session.observe_protocol_control(owner) if compact else self.session.observe_protocol(owner))
+        # This ledger is explicitly derived by native from this client's own
+        # payloads and delivered ACKs. It must not be the legacy truth ledger.
+        result["transfers"] = result["client_transfer_ledger"]
+        return result
+
+
+def route_payload(observation: dict, tray_id: str, *, message_delay: float, lease_seconds: float) -> tuple[dict, str]:
+    packet = make_route_packet(observation, tray_id)
+    encoded = encode_route(packet)
+    decoded = decode_route(encoded)
+    return {"business_bag_id": decoded.business_bag_id, "tray_id": tray_id,
+            "from": decoded.replaceable_suffix[0], "next": decoded.replaceable_suffix[1],
+            "expected_generation": decoded.generation, "expected_traversal": decoded.traversal_id,
+            "expiry": observation["now"] + lease_seconds, "message_delay": message_delay}, encoded
+
+
+def _publish_services(client: ProtocolClient, owner: str, state: dict, *, command_delay: float,
+                      publication_delay: float, routes: bool, forecasts: bool, lease_seconds: float) -> list[dict]:
+    observation = client.view(owner)
+    nodes = {int(row["node"]): row for row in observation["node_contracts"]}
+    jobs = {row["business_bag_id"]: row for row in observation.get("jobs", [])}
+    alive = set()
+    records = []
+    for tray in observation.get("trays", []):
+        job = jobs.get(tray.get("business_bag_id")) or tray.get("job_contract")
+        if not job or tray["mode"] not in ("loading", "loaded") or tray.get("edge_to", -1) >= 0:
+            continue
+        key = json.dumps([owner, tray["tray_id"], job["business_bag_id"], tray["generation"],
+                          tray["traversal_id"], tray["node"]], separators=(",", ":"))
+        if routes and tray["mode"] == "loaded" and job.get("allow_suffix_reroute", False):
+            try:
+                payload, encoded = route_payload(observation, tray["tray_id"], message_delay=command_delay,
+                                                 lease_seconds=lease_seconds)
+            except ValueError as exc:
+                records.append({"kind": "route_not_proposed", "reason": str(exc), "key": key})
+            else:
+                # Timestamp/expiry alone is not a new routing need. A changed
+                # public path/fault readset or a rejected/expired request is.
+                route_key = key + ":" + json.dumps([decode_route(encoded).replaceable_suffix,
+                    observation.get("known_faults", [])], sort_keys=True, separators=(",", ":"))
+                # An old successful ACK is historical evidence, not proof
+                # that its route is still installed after a different intent.
+                # Serialize this stage's updates until the prior result is
+                # known so a late retry cannot reinstall a superseded route.
+                active = state.setdefault("active_routes", {}).get(key)
+                old_id = (active or {}).get("request_id")
+                old_row = client.state["outbox"].get(old_id)
+                old_ack = (old_row or {}).get("client_view", {}).get("last_delivered_ack", {})
+                accepted_until = (old_row or {}).get("payload", {}).get("expiry", -1.)
+                needs_request = (old_row is None or
+                    (old_row["terminal"] and ((active or {}).get("route_key") != route_key or
+                     old_ack.get("status") != "updated" or observation["now"] >= accepted_until)
+                     and observation["now"] >= old_row["next_retry"]))
+                if needs_request:
+                    request_id, reply = client.submit(owner, "route", payload)
+                    state["routes"][route_key] = request_id
+                    state["active_routes"][key] = {"route_key": route_key, "request_id": request_id}
+                    records.append({"kind": "route", "request_id": request_id, "encoded_route": encoded, "reply": reply})
+        if forecasts:
+            storage = int(job.get("storage_node", -1))
+            goal = storage if storage >= 0 and job.get("storage_released_at", -1) < 0 else int(job["destination"])
+            path = public_astar(observation, int(tray["node"]), goal)
+            if len(path) < 2:
+                continue
+            next_node = path[1]
+            forecast_key = key + ":" + str(next_node)
+            alive.add(forecast_key)
+            old = state["forecasts"].get(forecast_key)
+            old_request = client.state["outbox"].get((old or {}).get("request_id"))
+            old_ack = (old_request or {}).get("client_view", {}).get("last_delivered_ack", {})
+            withdrew = client.state["outbox"].get((old or {}).get("withdraw_request_id"))
+            withdraw_ack = (withdrew or {}).get("client_view", {}).get("last_delivered_ack", {})
+            withdrawal_delivered = withdraw_ack.get("status") in {"delivered", "withdrawn", "cancelled"}
+            rejected = bool(old_request and old_request["terminal"] and
+                (old_ack.get("status") == "rejected" or old_request["submission_reply"].get("status") == "rejected"))
+            needs_publication = old is None or old.get("withdrawn") or old.get("retired_without_publication") or withdrawal_delivered or rejected
+            if needs_publication and (old_request is None or observation["now"] >= old_request["next_retry"]):
+                if old:
+                    state.setdefault("forecast_history", []).append(copy.deepcopy(old))
+                target = nodes[next_node].get("resource_owner", nodes[next_node]["zone"])
+                request_id, reply = client.submit(owner, "service_forecast", {
+                    "target_owner": target, "tray_id": tray["tray_id"], "next": next_node,
+                    "message_delay": command_delay, "publication_delay": publication_delay})
+                state["forecasts"][forecast_key] = {"owner": owner, "request_id": request_id, "withdrawn": False}
+                records.append({"kind": "service_forecast", "request_id": request_id, "reply": reply})
+    for key, old in state["forecasts"].items():
+        if old["owner"] != owner or key in alive or old["withdrawn"] or old.get("retired_without_publication"):
+            continue
+        original = client.state["outbox"][old["request_id"]]
+        original_ack = original.get("client_view", {}).get("last_delivered_ack", {})
+        if original["terminal"] and (original["submission_reply"].get("status") == "rejected" or
+                (original_ack.get("status") == "rejected" and not original_ack.get("result_id"))):
+            old["retired_without_publication"] = True
+            continue
+        previous = client.state["outbox"].get(old.get("withdraw_request_id"))
+        if previous:
+            if not previous["terminal"]:
+                continue
+            ack = previous.get("client_view", {}).get("last_delivered_ack", {})
+            if ack.get("status") in {"delivered", "withdrawn", "cancelled"}:
+                old["withdrawn"] = True
+                continue
+            # Rejected before the referenced publication existed is not a
+            # withdrawal. Preserve it and try a new intent at a later tick.
+            old["withdrawal_failure"] = copy.deepcopy(ack or previous["submission_reply"])
+            if observation["now"] < previous["next_retry"]:
+                continue
+        request_id, reply = client.submit(owner, "withdraw_service_forecast", {
+            "forecast_request_id": old["request_id"], "message_delay": command_delay,
+            "publication_delay": publication_delay})
+        old["withdraw_request_id"] = request_id
+        records.append({"kind": "withdraw_service_forecast", "request_id": request_id, "reply": reply})
+    return records
+
+
+def run_protocol_control(session: Any, owners: list[str], *, horizon: float, control_period: float = .5,
+                         predictive: bool = True, command_delay: float = .01, publication_delay: float = .02,
+                         retry_period: float = .5, routes: bool = True, forecasts: bool = True,
+                         prebalance: bool = True, compact: bool = True, lease_seconds: float = 5., state: dict | None = None,
+                         event_budget: int = 100000) -> dict:
+    """Advance common public ticks, including retries and both real control layers.
+
+    Each call preserves the next unexecuted tick. Native + JSON client/controller
+    state must be restored together; JSON alone cannot restore physical state.
+    """
+    if not owners or len(set(owners)) != len(owners):
+        raise ValueError("protocol_control:invalid_owners")
+    if not all(math.isfinite(v) and v >= 0 for v in (horizon, command_delay, publication_delay, lease_seconds)) or control_period <= 0 or not math.isfinite(control_period):
+        raise ValueError("protocol_control:invalid_timing")
+    if horizon < session.physical_time:
+        raise ValueError("protocol_control:horizon_before_physical_time")
+    config = {"owners": owners, "control_period": control_period, "predictive": predictive,
+              "command_delay": command_delay, "publication_delay": publication_delay,
+              "retry_period": retry_period, "routes": routes, "forecasts": forecasts,
+              "prebalance": prebalance, "compact": compact, "lease_seconds": lease_seconds}
+    current = copy.deepcopy(state) if state is not None else {
+        "schema": "g31.protocol_controller_state.v2", "config": config,
+        "start": session.physical_time, "next_tick": 0, "published": {}, "routes": {}, "forecasts": {}}
+    if current.get("schema") != "g31.protocol_controller_state.v2" or current["config"] != config:
+        raise ValueError("protocol_control:state_configuration_mismatch")
+    if current.get("control_boundary_complete") is False:
+        raise ValueError("protocol_control:partial_tick_resume_not_supported")
+    client = ProtocolClient(session, retry_period=retry_period, state=current.get("client"))
+    records, native_batches = [], []
+
+    def advance(target):
+        started = time.perf_counter(); cpu = time.process_time()
+        response = session.advance_to(target, max_events=event_budget)
+        native_batches.append({"target": target, "status": response["status"],
+                               "wall_ms": 1000*(time.perf_counter()-started),
+                               "cpu_ms": 1000*(time.process_time()-cpu)})
+        return response.get("status") == "reached" and response.get("horizon_complete", False)
+
+    complete = True
+    # An epsilon must never authorize executing an event after the requested
+    # horizon; native time cannot then be rolled back to finish the call.
+    while current["start"] + current["next_tick"] * control_period <= horizon:
+        target = current["start"] + current["next_tick"] * control_period
+        if target < session.physical_time:
+            raise ValueError("protocol_control:missed_control_boundary")
+        if not advance(target):
+            complete = False; break
+        started = time.perf_counter()
+        refreshed = client.refresh()
+        publications, service_actions = [], []
+        for owner in owners:
+            signature = session.protocol_demand_signature(owner)
+            channels = current["published"].setdefault(owner, {})
+            for recipient in owners:
+                if recipient == owner:
+                    continue
+                old_id = channels.get(recipient)
+                previous = client.state["outbox"].get(old_id)
+                if previous:
+                    if not previous["terminal"]:
+                        continue
+                    ack = previous.get("client_view", {}).get("last_delivered_ack", {})
+                    if ack.get("status") == "delivered":
+                        # Native captures at source execution, not submission.
+                        # Only the actually delivered ACK's immutable capture
+                        # can justify suppressing an unchanged publication.
+                        captured = ack.get("captured_demand_signature")
+                        if captured is None:
+                            raise ValueError("protocol_control:captured_demand_signature_required")
+                        if captured == signature:
+                            continue
+                    elif target < previous["next_retry"]:
+                        continue
+                request_id, reply = client.submit(owner, "demand", {
+                    "target_owner": recipient, "message_delay": command_delay,
+                    "publication_delay": publication_delay})
+                channels[recipient] = request_id
+                publications.append({"request_id": request_id, "reply": reply})
+            service_actions.extend(_publish_services(client, owner, current, command_delay=command_delay,
+                publication_delay=publication_delay, routes=routes, forecasts=forecasts, lease_seconds=lease_seconds))
+        preparation_ms = 1000*(time.perf_counter()-started)
+        if not advance(target):
+            complete = False; break
+        decisions = []
+        for owner in owners if prebalance else []:
+            started = time.perf_counter()
+            observation = client.view(owner, compact=compact)
+            decision = transfer_candidates(observation, predictive=predictive, message_delay=command_delay,
+                respect_service_forecasts=forecasts, request_prefix=f"protocol:{current['next_tick']}")
+            initial = decision
+            attempts = []
+            for _ in range(len(initial["intents"])):
+                if not decision["intents"]:
+                    break
+                request_id, reply = client.submit(owner, "transfer", decision["intents"][0])
+                attempts.append({"request_id": request_id, "reply": reply})
+                if reply.get("status") != "pending":
+                    break
+                observation = client.view(owner, compact=compact)
+                decision = transfer_candidates(observation, predictive=predictive, message_delay=command_delay,
+                    respect_service_forecasts=forecasts, request_prefix=f"protocol:{current['next_tick']}:residual")
+            decisions.append({"owner_id": owner, "decision": initial, "attempts": attempts,
+                              "compute_ms": 1000*(time.perf_counter()-started)})
+        records.append({"tick": current["next_tick"], "at": target, "refreshed": refreshed,
+                        "publications": publications, "service_actions": service_actions,
+                        "preparation_compute_ms": preparation_ms, "owner_decisions": decisions})
+        current["next_tick"] += 1
+    if complete:
+        complete = advance(horizon)
+    # Do not insert a client observation at an arbitrary split horizon: that
+    # would alter the controller history relative to uninterrupted execution.
+    current["client"] = copy.deepcopy(client.state)
+    # result_at itself advances and uses a separate native budget. It must
+    # never silently execute the rest of a budget-truncated timestamp.
+    result = session.result_at(horizon) if complete else None
+    complete = complete and result.get("advance", {}).get("status") == "reached" and result.get("advance", {}).get("horizon_complete", False)
+    current["control_boundary_complete"] = complete
+    continuation = {"status": "reached" if complete else "budget_exhausted",
+                    "requested_horizon": horizon, "physical_time": session.physical_time}
+    if result is not None:
+        result["control_continuation"] = continuation
+    return {"status": "reached" if complete else "budget_exhausted", "result": result,
+            "controller_state": current, "control_records": records, "client_calls": client.calls,
+            "native_batches": native_batches, "control_continuation": continuation,
+            "complete_100ms_requirement_certified": False,
+            "scope": "actual R1/R2 analytic baseline on public native protocol; no new-method or deployment claim"}
+
+
+def complete_protocol_route(session: Any, owner: str, tray: str, request_id: str, *, command_delay: float = .01,
+                            lease_seconds: float = 2., confirmation_window: float = 1.,
+                            poll_period: float = .05, retry_period: float = .2, event_budget: int = 100000) -> dict:
+    """Charge one whole simulated request, including all intervening native work."""
+    if not all(math.isfinite(v) and v >= 0 for v in (command_delay, lease_seconds, confirmation_window)) or poll_period <= 0 or not math.isfinite(poll_period):
+        raise ValueError("protocol_route:invalid_timing")
+    started = time.perf_counter(); cpu = time.process_time(); begin = session.physical_time
+    client = ProtocolClient(session, retry_period=retry_period)
+    progress = None
+    try:
+        payload, encoded = route_payload(client.view(owner), tray, message_delay=command_delay, lease_seconds=lease_seconds)
+    except ValueError as exc:
+        response = {"status": "rejected", "reason": str(exc)}; encoded = None
+    else:
+        request_id, response = client.submit(owner, "route", payload, request_id=request_id)
+        tick = 0
+        while response["status"] == "pending":
+            target = min(begin + confirmation_window, begin + tick*poll_period)
+            progress = session.advance_to(target, max_events=event_budget)
+            if progress["status"] != "reached" or not progress.get("horizon_complete", False):
+                response = {"status": "timeout_unknown", "reason": "native_budget_exhausted"}; break
+            client.refresh()
+            known = client.state["outbox"][request_id]
+            ack = known.get("client_view", {}).get("last_delivered_ack")
+            if ack and ack["status"] in TERMINAL:
+                response = copy.deepcopy(ack); break
+            if target >= begin + confirmation_window:
+                response = {"status": "timeout_unknown", "reason": "no_terminal_delivered_ack_in_public_window"}; break
+            tick += 1
+    response = json.loads(json.dumps(response, allow_nan=False))
+    wall = 1000*(time.perf_counter()-started)
+    return {"request_id": request_id, "encoded_route": encoded, "response": response, "advance": progress,
+            "client_state": client.state, "client_calls": client.calls,
+            "compute_wall_ms": wall, "compute_cpu_ms": 1000*(time.process_time()-cpu),
+            "meets_measured_100ms": wall <= 100., "physical_started_at": begin,
+            "physical_finished_at": session.physical_time, "complete_100ms_requirement_certified": False,
+            "timing_scope": "observation+conversion+A*+codec+submit+all intervening native events/revalidation/ACK+client retry/response codec; logical wait is simulated, no deployment SLA"}
diff --git a/scripts/experiments/g31_ics_circulation/regional_control.py b/scripts/experiments/g31_ics_circulation/regional_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/regional_control.py
@@ -0,0 +1,172 @@
+"""Owner-local on-demand routing and a versioned system A* intent codec.
+
+Only public observations are consumed. The packet is a replaceable preference,
+never a reservation, inventory record or permission to undo an entered edge.
+"""
+from __future__ import annotations
+from dataclasses import asdict, dataclass
+import heapq
+import json
+import math
+import time
+from typing import Any
+
+
+@dataclass(frozen=True)
+class RoutePacket:
+    schema: str
+    business_bag_id: str
+    tray_id: str
+    owner_id: str
+    generation: int
+    traversal_id: int
+    stage: str
+    stage_goal: int
+    committed_prefix: tuple[int, ...]
+    replaceable_suffix: tuple[int, ...]
+    observed_at: float
+
+
+def encode_route(packet: RoutePacket) -> str:
+    if packet.schema != "g31.route_intent.v1" or not packet.replaceable_suffix or not packet.committed_prefix:
+        raise ValueError("route_codec:invalid_packet")
+    if packet.committed_prefix[-1] != packet.replaceable_suffix[0] or packet.replaceable_suffix[-1] != packet.stage_goal:
+        raise ValueError("route_codec:prefix_or_stage_mismatch")
+    return json.dumps(asdict(packet),sort_keys=True,separators=(",",":"),allow_nan=False)
+
+
+def decode_route(payload: str) -> RoutePacket:
+    data=json.loads(payload)
+    data["committed_prefix"]=tuple(data["committed_prefix"])
+    data["replaceable_suffix"]=tuple(data["replaceable_suffix"])
+    packet=RoutePacket(**data)
+    encode_route(packet)
+    return packet
+
+
+def public_astar(observation: dict[str, Any], source: int, goal: int) -> tuple[int, ...]:
+    """A* with exact static lower bound and declared local berth penalty.
+
+    Dynamic penalties use local occupancy only. Remote live queues do not exist
+    in this projection. This is a deterministic strong baseline, not novelty.
+    """
+    contracts={n["node"]:n for n in observation["node_contracts"]}
+    service={n[0]:max(n[2],.001) for n in observation["node_records"]}
+    closed={(e["from"],e["to"]) for e in observation["edge_contracts"] if e["capacity"]==0}
+    closed.update((f["from"],f["to"]) for f in observation.get("known_faults",[]) if f["active"])
+    outgoing={n:[] for n in contracts}; incoming={n:[] for n in contracts}
+    for u,v,length,speed in observation["edge_records"]:
+        if (u,v) in closed: continue
+        cost=service[u]+max(length/speed,.001)
+        outgoing[u].append((v,cost));incoming[v].append((u,cost))
+    h={goal:0.};queue=[(0.,goal)]
+    while queue:
+        cost,node=heapq.heappop(queue)
+        if cost!=h[node]:continue
+        for predecessor,weight in incoming[node]:
+            new=cost+weight
+            if new<h.get(predecessor,math.inf):
+                h[predecessor]=new;heapq.heappush(queue,(new,predecessor))
+    if source not in h:return ()
+    queue=[(h[source],0.,(source,),source)];best={source:0.}
+    while queue:
+        _,cost,path,node=heapq.heappop(queue)
+        if cost!=best[node]:continue
+        if node==goal:return path
+        for successor,weight in outgoing[node]:
+            if successor not in h:continue
+            local=contracts[successor]
+            penalty=max(0,local.get("occupancy",0))*service[successor]
+            new=cost+weight+penalty
+            if new<best.get(successor,math.inf):
+                best[successor]=new
+                heapq.heappush(queue,(new+h[successor],new,path+(successor,),successor))
+    return ()
+
+
+def make_route_packet(observation: dict[str, Any], tray_id: str) -> RoutePacket:
+    tray=next((t for t in observation["trays"] if t["tray_id"]==tray_id),None)
+    if tray is None:raise ValueError("route:tray_not_visible")
+    if tray["edge_to"]>=0:raise ValueError("route:committed_edge_cannot_be_replaced")
+    job=next((j for j in observation["jobs"] if j["business_bag_id"]==tray["business_bag_id"]),None)
+    if job is None or not job["allow_suffix_reroute"]:raise ValueError("route:service_obligation_disallows_reroute")
+    if tray["mode"]!="loaded":raise ValueError("route:no_active_route_stage")
+    storage=job.get("storage_node",-1)
+    before_storage=storage>=0 and job.get("storage_released_at",-1)<0
+    goal=storage if before_storage else job["destination"]
+    path=public_astar(observation,tray["node"],goal)
+    if len(path)<2:raise ValueError("route:no_safe_public_continuation")
+    return RoutePacket("g31.route_intent.v1",job["business_bag_id"],tray_id,observation["owner_id"],
+                       tray["generation"],tray["traversal_id"],"storage_in" if before_storage else "storage_out_or_direct",
+                       goal,tuple(tray.get("committed_prefix",[tray["node"]])),path,observation["now"])
+
+
+def submit_on_demand(session, owner_id: str, tray_id: str, request_id: str, *,
+                     message_delay: float=0., logical_compute_delay: float=0., lease_seconds: float=5.) -> dict[str, Any]:
+    """Queue completion at a native event time; delayed state can invalidate it.
+
+    Measured CPU/wall compute is distinct from declared deterministic processing
+    delay. Owner delivery/revalidation must be measured separately for a full
+    100ms claim; this routine deliberately does not make that claim.
+    """
+    if not all(math.isfinite(x) and x>=0 for x in (message_delay,logical_compute_delay,lease_seconds)):
+        raise ValueError("route:invalid_delay")
+    start=time.perf_counter();cpu=time.process_time()
+    observation=session.observe(owner_id)
+    try:
+        packet=make_route_packet(observation,tray_id)
+        decoded=decode_route(encode_route(packet))
+        request={"request_id":request_id,"owner_id":owner_id,"business_bag_id":decoded.business_bag_id,
+                 "tray_id":tray_id,"from":decoded.replaceable_suffix[0],"next":decoded.replaceable_suffix[1],
+                 "expected_generation":decoded.generation,"expected_traversal":decoded.traversal_id,
+                 "expiry":observation["now"]+lease_seconds,"message_delay":message_delay+logical_compute_delay}
+        response=session.submit_route_intent(request)
+        payload=encode_route(packet)
+    except ValueError as exc:
+        response={"status":"rejected","reason":str(exc)};request=None;payload=None
+    return {"response":response,"request":request,"encoded_route":payload,
+            "submission_compute_ms":(time.perf_counter()-start)*1000,
+            "submission_cpu_ms":(time.process_time()-cpu)*1000,
+            "logical_compute_delay":logical_compute_delay,"message_delay":message_delay,
+            "timing_scope":"observe+conversion+candidate A*+codec+submit; delivery owner compute excluded",
+            "complete_100ms_requirement_certified":False}
+
+
+def complete_on_demand(session, owner_id: str, tray_id: str, request_id: str, *,
+                       message_delay: float=0., logical_compute_delay: float=0.,
+                       lease_seconds: float=5., event_budget: int=100000) -> dict[str, Any]:
+    """Measure one complete synchronous *simulation experiment* request chain.
+
+    This drives the existing native session only to the declared completion
+    message time, then reads the actual owner response. All simulated physical
+    event work in that interval is charged too: measured wall/CPU is therefore
+    a conservative compute scope, not a pure policy timing or deployment SLA.
+    It must not be nested in an external controller without preserving that
+    controller's intervening ticks. Network delay is logical and separately
+    recorded; no claim is made that wall-clock physical equipment was running.
+    """
+    start=time.perf_counter();cpu=time.process_time();physical_start=session.physical_time
+    submitted=submit_on_demand(session,owner_id,tray_id,request_id,
+        message_delay=message_delay,logical_compute_delay=logical_compute_delay,lease_seconds=lease_seconds)
+    progress=None
+    if submitted["response"]["status"]=="pending":
+        progress=session.advance_to(physical_start+logical_compute_delay+message_delay,max_events=event_budget)
+        actual=next((r for r in session.observe(owner_id)["route_requests"] if r["request_id"]==request_id),None)
+        if actual is None or actual["status"]=="pending":
+            final={"status":"timeout_unknown","reason":"owner_completion_not_observed"}
+        else:
+            final=actual
+    else:
+        final=submitted["response"]
+    # Include response serialization/deserialization in the measured path.
+    final=json.loads(json.dumps(final,allow_nan=False))
+    wall_ms=(time.perf_counter()-start)*1000;cpu_ms=(time.process_time()-cpu)*1000
+    return {"submission":submitted,"final_response":final,"advance":progress,
+            "compute_wall_ms":wall_ms,"compute_cpu_ms":cpu_ms,
+            "meets_measured_100ms":wall_ms<=100.,"overrun_is_failure":wall_ms>100.,
+            "physical_started_at":physical_start,"physical_finished_at":session.physical_time,
+            "logical_network_delay_seconds":message_delay,
+            "logical_processing_delay_seconds":logical_compute_delay,
+            "timing_scope":"observe+conversion+A*+codec+submit+all intervening native events including owner revalidation+confirmation+response codec",
+            "hard_realtime_guarantee":False,"complete_100ms_requirement_certified":False,
+            "limits":"single-process synthetic/request sample; modeled network wait; external controller ticks not automatically replayed"}
diff --git a/scripts/experiments/g31_ics_circulation/run_original_control.py b/scripts/experiments/g31_ics_circulation/run_original_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/run_original_control.py
@@ -0,0 +1,211 @@
+"""Budgeted original-map R2 controls through one persistent native G31 host.
+
+This uses the existing same-information analytic baseline without manufacturing
+return requests. The source denominator never changes; disk/wall/event budgets
+produce explicit censoring, not completion or physical-infeasibility claims.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .native_host import audit_result, load_native
+from .original_workload import (
+    DEFAULT_MAP, ProxyContract, build_input, digest, return_contract_diagnostics,
+    source_map, static_diagnostics, summarize_execution, verify_source_map, write_json,
+)
+from .validate_analytic_control import replay_input
+
+
+class NativeBatchMeter:
+    """Observe existing calls only; never insert or reschedule a native event.
+
+    A batch may process physics and several requests together. Its total CPU
+    must not be divided by request count and presented as per-request cost.
+    result_at additionally renders offline results; that cost is separate.
+    """
+
+    def __init__(self, session):
+        self.session = session
+        self.batches = []
+
+    def __getattr__(self, name):
+        return getattr(self.session, name)
+
+    def _measure(self, kind, target, *args, **kwargs):
+        start_clock = self.session.physical_time
+        wall, cpu = time.perf_counter(), time.process_time()
+        result = getattr(self.session, kind)(target, *args, **kwargs)
+        self.batches.append({"call": kind, "start_clock": start_clock, "target": target,
+            "end_clock": self.session.physical_time,
+            "wall_ms": 1000*(time.perf_counter()-wall), "cpu_ms": 1000*(time.process_time()-cpu),
+            "status": result.get("status") if kind == "advance_to" else result.get("advance", {}).get("status"),
+            "scope": "shared native event batch" if kind == "advance_to" else "native final advance plus full offline result serialization"})
+        return result
+
+    def advance_to(self, target, *args, **kwargs):
+        return self._measure("advance_to", target, *args, **kwargs)
+
+    def result_at(self, target, *args, **kwargs):
+        return self._measure("result_at", target, *args, **kwargs)
+
+
+def decision_identity(decision: dict) -> str:
+    """Compare policy semantics independently of observation serialization.
+
+    Pool/demand array indices are representation details. Exact population
+    counts, supply identities, forecast dependencies and actual selected
+    requests are policy evidence; physical events are checked separately.
+    """
+    payload = {key: decision[key] for key in (
+        "policy", "now", "version", "forecasts", "supplies", "intents",
+        "clearing_pressure_without_available_source")}
+    payload["exact_waiting_count"] = decision.get("exact_waiting_count")
+    payload["exact_demand_count"] = decision.get("exact_demand_count", len(decision["demands"]))
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":"),
+                                    allow_nan=False).encode()).hexdigest()
+
+
+def execute(args) -> dict:
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("original_workload.py")]
+    receipt = {"schema": "g31.original_online_control.v1", "status": "running",
+        "source_before": {str(p): digest(p) for p in paths},
+        "binary_sha256": digest(args.binary), "predictive": args.predictive,
+        "respect_service_forecasts": args.service_forecasts,
+        "compact_projection": args.compact_projection,
+        "control_period": args.control_period, "horizon": args.horizon,
+        "message_delay": args.message_delay, "demand_delay": args.demand_delay,
+        "wall_budget_seconds": args.wall_budget, "max_events": args.max_events,
+        "scope": "same native original-map input and lawful owner observations; analytic R2 baseline, no R1 protection certificate or main-method innovation",
+        "complete_100ms_requirement_certified": False}
+    write_json(args.output/"receipt.json", receipt)
+    started = time.perf_counter()
+    try:
+        contract = ProxyContract(f"nanning-on-carrier-proxy-v1-n4-s{args.storage_berths}-t2",
+                                4, args.storage_berths, 2, 1., 1., 0.,
+                                "finite_berth_waiting_research_proxy")
+        data, manifest, crosswalk = build_input(scale=args.scale, contract=contract,
+            horizon=args.horizon, max_events=args.max_events, trace_limit=0)
+        write_json(args.output/"input_manifest.json", manifest)
+        profile = json.loads(DEFAULT_MAP.read_text(encoding="utf-8"))
+        write_json(args.output/"source_workbooks.json", verify_source_map(profile, source_map.default_source_dir()))
+        write_json(args.output/"static_diagnostics.json", static_diagnostics(data))
+        write_json(args.output/"return_contract_diagnostics.json", return_contract_diagnostics(data))
+        with gzip.open(args.output/"business_crosswalk.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for row in crosswalk:
+                stream.write(json.dumps(row, sort_keys=True)+"\n")
+        owners = sorted({n["resource_owner"] for n in data["node_contracts"]})
+        session = NativeBatchMeter(load_native(args.binary).NativeSession(data))
+        state, submitted, compute_ms = None, [], []
+        tick = 0
+        reason = "common_horizon_reached"
+        with (args.output/"control_steps.jsonl").open("w", encoding="utf-8") as stream:
+            while True:
+                target = min(tick*args.control_period, args.horizon)
+                chunk_started = time.perf_counter()
+                session.batches = []
+                run = run_online_matching(session, owners, horizon=target,
+                    predictive=args.predictive, control_period=args.control_period,
+                    message_delay=args.message_delay, demand_delay=args.demand_delay,
+                    respect_service_forecasts=args.service_forecasts, controller_state=state,
+                    compact_projection=args.compact_projection)
+                state = run["controller_state"]
+                submitted.extend(run["submitted"])
+                rows = []
+                for record in run["control_records"]:
+                    decision = record["decision"]
+                    compute_ms.append(record["compute_ms"])
+                    rows.append({"owner_id": record["owner_id"], "compute_ms": record["compute_ms"],
+                        "compute_parts_ms": record.get("compute_parts_ms", {}),
+                        "candidate_pairs": len(decision["pool"]), "supplies": len(decision["supplies"]),
+                        "demands": decision.get("exact_demand_count", len(decision["demands"])),
+                        "represented_demands": len(decision["demands"]),
+                        "waiting": decision.get("exact_waiting_count"),
+                        "demand_identity_scope": decision.get("demand_identity_scope", "all_visible_uncovered"),
+                        "decision_identity": decision_identity(decision),
+                        "residual_decision_identities": [decision_identity(d) for d in record["replans"]],
+                        "intents": len(decision["intents"]),
+                        "forecast_ledgers": dict(Counter(f["ledger"] for f in decision["forecasts"])),
+                        "reply_statuses": dict(Counter(r["status"] for r in record["replies"]))})
+                result = run["result"]
+                summary = summarize_execution(data, result)
+                stream.write(json.dumps({"tick": tick, "target": target, "status": run["status"],
+                    "actual_clock": session.physical_time, "event_count": summary["native_summary"]["event_count"],
+                    "observed": summary["observed"], "completed": summary["completed"], "loaded": summary["loaded"],
+                    "chunk_wall_seconds": time.perf_counter()-chunk_started,
+                    "publication_records": run.get("publication_records", []),
+                    "native_batches": session.batches,
+                    "owner_computations": rows, "submitted": run["submitted"]})+"\n")
+                stream.flush()
+                if run["status"] != "reached":
+                    reason = "native_event_budget_censored"
+                    break
+                if target == args.horizon:
+                    break
+                if time.perf_counter()-started >= args.wall_budget:
+                    reason = "wall_budget_censored_at_completed_control_boundary"
+                    break
+                tick += 1
+        receipt["stop_reason"] = reason
+        receipt["status"] = "reached" if summary["horizon_reached"] else "censored"
+        receipt["offline_final_state_sha256"] = session.offline_state_sha256()
+        receipt["control_compute_ms"] = {"count": len(compute_ms), "max": max(compute_ms, default=0.),
+            "sum": sum(compute_ms), "over_100ms": sum(value > 100 for value in compute_ms),
+            "scope": run["timing_scope"]}
+        write_json(args.output/"summary.json", summary)
+        write_json(args.output/"event_audit.json", audit_result(replay_input(data, submitted), result))
+        write_json(args.output/"submitted_requests.json", submitted)
+        with gzip.open(args.output/"controller_state.json.gz", "wt", encoding="utf-8") as stream:
+            json.dump(state, stream)
+        with gzip.open(args.output/"business_results.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for job in result["jobs"]:
+                stream.write(json.dumps(job)+"\n")
+        with gzip.open(args.output/"physical_events.jsonl.gz", "wt", encoding="utf-8") as stream:
+            for event in result["receipts"]:
+                stream.write(json.dumps(event)+"\n")
+        # Native checkpoints remain process-bound; never label the controller
+        # JSON as an independently restorable physical checkpoint.
+        receipt["continuation_boundary"] = {"physical_time": session.physical_time,
+            "native_session_persisted": False, "rerun_required_after_process_exit": True}
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["wall_seconds"] = time.perf_counter()-started
+    receipt["source_changed"] = [str(p) for p in paths if digest(p) != receipt["source_before"][str(p)]]
+    write_json(args.output/"receipt.json", receipt)
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--scale", type=int, choices=(1, 2), default=1)
+    parser.add_argument("--horizon", type=float, default=86400.)
+    parser.add_argument("--control-period", type=float, default=300.)
+    parser.add_argument("--message-delay", type=float, default=2.)
+    parser.add_argument("--demand-delay", type=float, default=.5)
+    parser.add_argument("--max-events", type=int, default=100000)
+    parser.add_argument("--storage-berths", type=int, default=4)
+    parser.add_argument("--wall-budget", type=float, default=120.)
+    parser.add_argument("--predictive", action="store_true")
+    parser.add_argument("--service-forecasts", action="store_true")
+    parser.add_argument("--compact-projection", action="store_true",
+                        help="Use exact native FIFO projection; all physical jobs and offered denominators remain intact.")
+    args = parser.parse_args()
+    receipt = execute(args)
+    print(json.dumps(receipt, indent=2))
+    return int(receipt["status"] == "failed" or bool(receipt["source_changed"]))
+
+
+if __name__ == "__main__":
