+def test_large_timestamp_candidate_labels_are_exact_and_unique(native):
+    parent, _ = prefix(native, scenario_input(SCENARIOS[0]))
+    observation = parent.observe("A")
+    observation["now"] = 1.e13
+    domain = build_domain(observation)
