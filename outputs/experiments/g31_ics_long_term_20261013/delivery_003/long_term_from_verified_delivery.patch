+++ b/scripts/experiments/g31_ics_circulation/validate_protocol_command_tests.py
@@ -0,0 +1,54 @@
+"""Capture unedited native protocol pytest output, JUnit and source identities."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    root = Path(__file__).absolute().parents[3]
+    out = Path(args.output).absolute(); out.mkdir(parents=True, exist_ok=False)
+    binary = Path(args.binary).absolute()
+    tests = ["tests/test_g31_circulation_protocol_commands.py", "tests/test_g31_circulation_owner_protocol.py",
+             "tests/test_g31_circulation_control_projection.py", "tests/test_g31_circulation_service_forecast.py",
+             "tests/test_g31_circulation_regional_control.py"]
+    paths = sorted({*root.glob("cpp/**/*.hpp"), *root.glob("cpp/**/*.cpp"),
+                    *(root / file for file in tests), Path(__file__).absolute()})
+    snapshot = lambda: {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    before = snapshot()
+    environment = dict(os.environ, PYTHONPATH="src;.", PYTEST_DISABLE_PLUGIN_AUTOLOAD="1",
+                       PYTHONIOENCODING="utf-8", G31_CIRCULATION_BINARY=str(binary))
+    command = [sys.executable, "-m", "pytest", *tests, "-q", f"--junitxml={out / 'junit.xml'}"]
+    started = time.perf_counter()
+    proc = subprocess.run(command, cwd=root, env=environment, capture_output=True)
+    elapsed = time.perf_counter() - started
+    (out / "stdout.txt").write_bytes(proc.stdout); (out / "stderr.txt").write_bytes(proc.stderr)
+    counts = None
+    if (out / "junit.xml").exists():
+        tree = ET.parse(out / "junit.xml").getroot()
+        counts = {key: sum(int(s.get(key, 0)) for s in tree.iter("testsuite"))
+                  for key in ("tests", "failures", "errors", "skipped")}
+    after = snapshot(); changed = [p for p in before if before[p] != after[p]]
+    receipt = {"schema": "g31.protocol_commands_pytest.v1", "status": "passed" if not proc.returncode and not changed else "failed",
+               "command": command, "returncode": proc.returncode, "counts": counts, "elapsed_seconds": elapsed,
+               "binary": str(binary), "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
+               "source_before": before, "source_after": after, "source_changed": changed}
+    (out / "receipt.json").write_text(json.dumps(receipt, indent=2), encoding="utf-8")
+    print(json.dumps({k: receipt[k] for k in ("status", "returncode", "counts", "elapsed_seconds", "source_changed")}))
+    print(proc.stdout.decode("utf-8", errors="replace"))
+    return proc.returncode or bool(changed)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_protocol_control.py b/scripts/experiments/g31_ics_circulation/validate_protocol_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_protocol_control.py
@@ -0,0 +1,163 @@
+"""Run actual R1/R2 public protocol factors with complete native ledgers."""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .finite_reference import outcome_cost, service_dominates
+from .native_host import audit_result, load_native, tiny_cycle
+from .original_workload import write_json
+from .protocol_control import complete_protocol_route, run_protocol_control
+from .validate_known_service_control import known_service_input
+
+
+def scenarios():
+    base = tiny_cycle(); base["transfers"] = []
+    for job in base["jobs"]:
+        job["allow_suffix_reroute"] = True
+    fault_specs = [
+        ("ordinary", {}), ("lost_ack", {"drop_ack_packets": 1}),
+        ("duplicate_ack", {"duplicate_acks": True, "duplicate_ack_delay": .5}),
+        ("source_unavailable", {"owner_outages": [{"owner": "B", "start": .2, "end": 12.}]}),
+        ("receiver_unavailable", {"owner_outages": [{"owner": "A", "start": 9., "end": 12.}]}),
+    ]
+    cases = []
+    for name, changes in fault_specs:
+        data = copy.deepcopy(base)
+        data["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02, **changes}
+        cases.append((name, data, ["A", "B"]))
+    refused = copy.deepcopy(cases[0][1])
+    next(n for n in refused["node_contracts"] if n["node"] == 0)["allow_receive"] = False
+    cases.append(("receiver_refuses", refused, ["A", "B"]))
+    known = known_service_input()
+    known["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02, "drop_ack_packets": 1}
+    # Independent authorized-routing research factor, shared by every policy;
+    # does not alter the frozen known_service campaign or its old conclusions.
+    for job in known["jobs"]:
+        job["allow_suffix_reroute"] = True
+    known["model_scope"] += "; common explicit suffix permission and native ACK-loss factor"
+    cases.append(("known_service_ack_loss", known, ["A", "B", "C"]))
+    return cases
+
+
+POLICIES = {
+    "r1_only": {"routes": True, "forecasts": True, "prebalance": False, "predictive": False},
+    "reactive_r2": {"routes": False, "forecasts": False, "prebalance": True, "predictive": False},
+    "predictive_r2": {"routes": False, "forecasts": True, "prebalance": True, "predictive": True},
+    "joint_r1_r2": {"routes": True, "forecasts": True, "prebalance": True, "predictive": True},
+}
+
+
+def replay_input(data, calls):
+    replay = copy.deepcopy(data)
+    requests = {}
+    for call in calls:
+        if call["kind"] != "transfer" or call["retry"] or call["reply"].get("status") != "pending":
+            continue
+        payload = copy.deepcopy(call["request"])
+        payload["issued_at"] = call["at"]
+        assert payload["request_id"] not in requests
+        requests[payload["request_id"]] = payload
+    replay["transfers"] = list(requests.values())
+    return replay
+
+
+def gz(path, value):
+    with gzip.open(path, "wt", encoding="utf-8") as f:
+        json.dump(value, f, ensure_ascii=False, allow_nan=False)
+
+
+def snapshot():
+    here = Path(__file__).parent
+    names = [__file__, here/"protocol_control.py", here/"analytic_control.py", here/"regional_control.py",
+             here/"native_host.py", here/"finite_reference.py", here/"validate_known_service_control.py",
+             here/"validate_coupled_control.py"]
+    return {str(p): hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in names}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    before = snapshot()
+    receipt = {"schema": "g31.protocol_control_campaign.v1", "status": "running", "cases": [],
+               "source_before": before, "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+               "scope": "synthetic authorized R1/R2 factors; common native physical and communication contract within each factor",
+               "complete_100ms_requirement_certified": False, "novelty": "engineering integration and strong analytic baselines"}
+    fixed = scenarios()
+    write_json(args.output/"protocol.json", {"horizon": 50., "start": .11, "control_period": .5,
+        "command_delay": .01, "publication_delay": .02, "retry_period": .5, "policies": POLICIES,
+        "cases": [n for n, _, _ in fixed], "selection": "declared before native execution; all outcomes retained"})
+    write_json(args.output/"receipt.json", receipt)
+    started = time.perf_counter()
+    try:
+        native = load_native(args.binary)
+        for name, data, owners in fixed:
+            folder = args.output/name; folder.mkdir()
+            write_json(folder/"input.json", data)
+            case = {"name": name, "policies": {}}
+            for policy, options in POLICIES.items():
+                target = folder/policy; target.mkdir()
+                session = native.NativeSession(data); session.advance_to(.11)
+                run = run_protocol_control(session, owners, horizon=50., **options)
+                gz(target/"run.json.gz", run)
+                assert run["status"] == "reached", (name, policy, run["status"])
+                replay = replay_input(data, run["client_calls"])
+                write_json(target/"audit_input.json", replay)
+                audit = audit_result(replay, run["result"])
+                assert audit["status"] == "passed", audit
+                write_json(target/"audit.json", audit)
+                metrics = outcome_cost(run["result"], data["jobs"], 50.)
+                calls = run["client_calls"]
+                ack_views = {owner: session.observe_protocol(owner) for owner in owners}
+                gz(target/"delivered_views.json.gz", ack_views)
+                case["policies"][policy] = {"status": "reached", "metrics": metrics, "audit": audit,
+                    "requests_by_kind": {kind: sum(c["kind"] == kind and not c["retry"] for c in calls)
+                        for kind in ("route", "transfer", "demand", "service_forecast", "withdraw_service_forecast")},
+                    "retry_calls": sum(c["retry"] for c in calls),
+                    "completed": sum(j["status"] == "completed" for j in run["result"]["jobs"]),
+                    "offered": len(data["jobs"]), "physical_transfers": len(run["result"]["transfers"]),
+                    "offline_final_state_sha256": session.offline_state_sha256()}
+                assert case["policies"][policy]["requests_by_kind"]["demand"] > 0
+            baseline = case["policies"]["reactive_r2"]["metrics"]
+            for row in case["policies"].values():
+                row["paired_service_vs_reactive_r2"] = service_dominates(row["metrics"], baseline)
+            receipt["cases"].append(case)
+            write_json(args.output/"receipt.json", receipt)
+        # Complete single-request timings retain refusal/unknown and all
+        # intervening physical work. They cannot certify loaded whole-day SLA.
+        complete = []
+        for name, changes, delay, window in [
+            ("allowed", {}, .01, 1.), ("stale", {}, .2, 1.),
+            ("lost_ack", {"drop_ack_packets": 1}, .01, 1.),
+            ("no_ack_within_window", {"drop_ack_packets": 100}, .01, .3),
+            ("source_unavailable", {"owner_outages": [{"owner": "A", "start": .1, "end": .5}]}, .01, 1.),
+        ]:
+            data = copy.deepcopy(fixed[0][1]); data["owner_protocol"].update(changes)
+            session = native.NativeSession(data); session.advance_to(.11)
+            measured = complete_protocol_route(session, "A", "T0", "live:1:A:full-query", command_delay=delay,
+                                               confirmation_window=window)
+            complete.append({"name": name, **measured})
+        write_json(args.output/"complete_route_requests.json", complete)
+        receipt["complete_route_sample_count"] = len(complete)
+        receipt["complete_route_sample_max_ms"] = max(r["compute_wall_ms"] for r in complete)
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["exception"] = traceback.format_exc()
+    receipt["source_after"] = snapshot()
+    receipt["source_changed"] = [p for p in before if before[p] != receipt["source_after"][p]]
+    receipt["wall_seconds"] = time.perf_counter()-started
+    write_json(args.output/"receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "source_changed", "wall_seconds", "exception") if k in receipt}))
+    return int(receipt["status"] != "passed" or bool(receipt["source_changed"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_regional_control.py b/scripts/experiments/g31_ics_circulation/validate_regional_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_regional_control.py
@@ -0,0 +1,113 @@
+"""R1 on-demand integration and native finite route reference, with raw receipts.
+
+This campaign certifies only the declared synthetic engineering contracts. Its
+Storage slack example deliberately has no business improvement to learn.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .finite_reference import Intervention, enumerate_interventions, headroom, outcome_cost
+from .native_host import audit_result, load_native, tiny_cycle
+from .regional_control import complete_on_demand, decode_route
+
+
+def write(path, value):
+    Path(path).write_text(json.dumps(value, indent=2, allow_nan=False), encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    native = load_native(args.binary)
+    files = [Path(__file__), Path(__file__).with_name("regional_control.py"),
+             Path(__file__).with_name("finite_reference.py"), Path(__file__).with_name("native_host.py")]
+    snapshot = lambda: {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    receipt = {"schema": "g31.regional_native_campaign.v1", "status": "running", "cases": [],
+               "source_before": snapshot(), "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+               "scope": "synthetic R1 integration and finite offline reference; not research gain or full 100ms validation"}
+    start = time.perf_counter()
+    base = tiny_cycle(); base["transfers"] = []; base["jobs"][0]["allow_suffix_reroute"] = True
+    scenarios = [("asynchronous_nonperiodic", base, .11, .01, 5., "allowed"),
+                 ("already_executed_prefix", base, 1.16, .01, 5., "allowed"),
+                 ("stale_computation", base, .11, .2, 5., "stale_executed_prefix"),
+                 ("expired_message", base, .11, .01, .001, "request_expired")]
+    denied = copy.deepcopy(base); denied["jobs"][0]["allow_suffix_reroute"] = False
+    scenarios.append(("permission_refusal", denied, .11, .01, 5., "route:service_obligation_disallows_reroute"))
+    fault = copy.deepcopy(base); fault["faults"] = [{"from": 0, "to": 1, "start": 0., "end": 20., "message_delay": .03}]
+    scenarios.append(("delivered_fault_detour", fault, .11, .01, 5., "allowed"))
+    try:
+        for name, data, at, delay, lease, expected in scenarios:
+            folder = args.output / name; folder.mkdir()
+            write(folder / "input.json", data)
+            session = native.NativeSession(data); session.advance_to(at)
+            observation = session.observe("A"); write(folder / "observation.json", observation)
+            baseline = session.fork().result_at(30)
+            measured = complete_on_demand(session, "A", "T0", name,
+                                          logical_compute_delay=delay, lease_seconds=lease)
+            request = measured["submission"]
+            result = session.result_at(30)
+            delivered = session.observe("A")["route_requests"]
+            final = delivered[-1] if delivered else request["response"]
+            write(folder / "request.json", request); write(folder / "final_response.json", final)
+            write(folder / "complete_compute_measurement.json", measured)
+            write(folder / "result.json", result); write(folder / "baseline_result.json", baseline)
+            audits = {"candidate": audit_result(data, result), "baseline": audit_result(data, baseline)}
+            write(folder / "audits.json", audits)
+            assert final["reason"] == expected, (name, final)
+            if name == "delivered_fault_detour":
+                assert decode_route(request["encoded_route"]).replaceable_suffix == (0, 6, 2)
+                assert next(r for r in result["receipts"] if r["event"] == "EDGE_ENTER")["to"] == 6
+            if name == "already_executed_prefix":
+                assert decode_route(request["encoded_route"]).committed_prefix == (0, 1)
+            receipt["cases"].append({"name": name, "response": final,
+                                     "compute_wall_ms": measured["compute_wall_ms"],
+                                     "compute_cpu_ms": measured["compute_cpu_ms"],
+                                     "meets_measured_100ms": measured["meets_measured_100ms"],
+                                     "cost": outcome_cost(result, data["jobs"], 30),
+                                     "baseline_cost": outcome_cost(baseline, data["jobs"], 30)})
+        # Compare actual alternative paths at one real boundary. Both reach
+        # Storage before its fixed release, so raw movement differs but the
+        # release slack absorbs the business-time difference.
+        session = native.NativeSession(base); session.advance_to(.11)
+        visible = session.observe("A"); tray = visible["trays"][0]
+        actions = [Intervention("WAIT", "wait")]
+        for next_node in (1, 6):
+            request = {"request_id": f"suffix-{next_node}", "owner_id": "A", "business_bag_id": "B1", "tray_id": "T0",
+                       "from": 0, "next": next_node, "expected_generation": tray["generation"],
+                       "expected_traversal": tray["traversal_id"], "expiry": 2., "message_delay": .01}
+            actions.append(Intervention(f"route-{next_node}", "route", request))
+        reference = enumerate_interventions(session, actions, horizon=30., job_contracts=base["jobs"],
+                                             baseline_action_id="route-1", validate=lambda r, a: audit_result(base, r))
+        write(args.output / "slack_absorption_reference.json", reference)
+        comparison = headroom(reference, [a.action_id for a in actions], "route-1", "route-1")
+        write(args.output / "headroom.json", comparison)
+        assert reference["optimality"] == "optimal_in_enumerated_domain"
+        assert reference["distinct_verified_physical_outcomes"] == 2
+        assert comparison["reference_headroom"] == 0
+        receipt["reference"] = {k: v for k, v in reference.items() if k != "rows"}
+        receipt["headroom"] = comparison
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["traceback"] = traceback.format_exc()
+    finally:
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = [p for p, h in receipt["source_before"].items() if receipt["source_after"][p] != h]
+        if receipt["source_changed"]:
+            receipt["status"] = "source_changed_development_only"
+        receipt["wall_seconds"] = time.perf_counter() - start
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "headroom", "traceback") if k in receipt}))
+    return 0 if receipt["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
