+                   "cost": r["metrics"]["cost"], "source": r["source_repair_status"], "resource": r["resource_repair_status"],
+                   "vs_ordinary": r["relative_to_frozen_ordinary"]["preserved"], "vs_WAIT": r["relative_to_frozen_WAIT"]["preserved"]}
