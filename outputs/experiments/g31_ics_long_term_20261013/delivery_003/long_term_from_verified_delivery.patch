+"""Exercise whether unrelated private transport changes a local traversal version."""
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).absolute().parents[3]
+sys.path.insert(0, str(ROOT))
+from scripts.experiments.g31_ics_circulation.native_host import load_native, prepare_input, tiny_cycle
+
+
+def inputs():
+    plain = tiny_cycle()
+    plain["transfers"] = []
+    plain["jobs"] = [plain["jobs"][0]]
+    plain["jobs"][0]["arrival"] = 1
+    plain["node_records"] += [(7, 1, .01, 7, 0, [8]), (8, 1, .01, 8, 0, [7])]
+    plain["edge_records"] += [(7, 8, .01, 1), (8, 7, .01, 1)]
+    plain["node_contracts"] += [dict(node=n, zone="C", capacity=1) for n in (7, 8)]
+    plain["edge_contracts"] += [dict(zip(("from", "to", "capacity", "entry_headway"), (u, v, 1, .01)))
+                                for u, v in ((7, 8), (8, 7))]
+    plain["trays"].append(dict(tray_id="private-C-tray", node=7))
+    plain = prepare_input(plain)
+    private = deepcopy(plain)
+    private["jobs"].append(dict(business_bag_id="private-C-job", origin=7, destination=8, arrival=0,
+                                deadline=40, unload_seconds=.01, hold_seconds=0, load_seconds=.01))
+    return plain, private
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--binary", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--require-fixed", action="store_true")
+    args = p.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    result = {"schema": "g31.private_traversal_counter_probe.v1", "binary": str(args.binary.absolute()),
+              "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(), "variants": []}
+    try:
+        native = load_native(args.binary)
+        for private_transport, data in zip((False, True), inputs()):
+            s = native.NativeSession(data)
+            s.advance_to(.5)
+            before = s.observe("A")
+            s.advance_to(1.2)
+            result["variants"].append({"private_C_transport": private_transport, "input": data,
+                                       "A_before": before, "A_after": s.observe("A")})
+        a, b = result["variants"]
+        result["before_equal"] = a["A_before"] == b["A_before"]
+        result["after_equal"] = a["A_after"] == b["A_after"]
+        result["fixed"] = result["before_equal"] and result["after_equal"]
+        result["status"] = "passed" if result["fixed"] else "reproduced_private_traversal_counter_leak"
+    except Exception as error:
+        result["status"] = "execution_error"
+        result["exception"] = repr(error)
+        raise
+    finally:
+        (args.output / "receipt.json").write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps({k: result[k] for k in ("status", "before_equal", "after_equal")}))
+    return int(args.require_fixed and not result["fixed"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/probe_protocol_controller.py b/scripts/experiments/g31_ics_circulation/probe_protocol_controller.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/probe_protocol_controller.py
@@ -0,0 +1,125 @@
+"""Actual before/after probes for budget and same-stage controller lifecycles."""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import traceback
+
+from . import protocol_control
+from .native_host import load_native, prepare_input, tiny_cycle
+from .original_workload import write_json
+
+
+class BudgetGuard:
+    def __init__(self, session):
+        self.session = session
+        self.cut_hash = None
+        self.extra_result_calls = 0
+
+    def __getattr__(self, name):
+        return getattr(self.session, name)
+
+    def advance_to(self, *args, **kwargs):
+        reply = self.session.advance_to(*args, **kwargs)
+        if reply["status"] == "budget_exhausted":
+            self.cut_hash = self.session.offline_state_sha256()
+        return reply
+
+    def result_at(self, *args, **kwargs):
+        if self.cut_hash is not None:
+            self.extra_result_calls += 1
+        return self.session.result_at(*args, **kwargs)
+
+
+def base():
+    data = tiny_cycle(); data["transfers"] = []
+    data["jobs"][0]["allow_suffix_reroute"] = True
+    data["jobs"][1]["arrival"] = 40.
+    data["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02}
+    return data
+
+
+def execute(module, native, output):
+    rows = []
+    data = base(); raw = native.NativeSession(data); raw.advance_to(.11)
+    guarded = BudgetGuard(raw)
+    cut = module.run_protocol_control(guarded, ["A", "B"], horizon=3., event_budget=1)
+    rows.append({"name": "budget_cut", "fixed": guarded.cut_hash is not None and
+                 guarded.cut_hash == raw.offline_state_sha256() and guarded.extra_result_calls == 0,
+                 "status": cut["status"], "cut_state": guarded.cut_hash,
+                 "returned_state": raw.offline_state_sha256(), "extra_result_calls": guarded.extra_result_calls})
+    write_json(output/"budget_probe.json", rows[-1])
+
+    data = base(); data["jobs"][0]["load_seconds"] = 20.
+    data["faults"] = [{"from": 0, "to": v, "start": 1., "end": 2.} for v in (1, 6)]
+    session = native.NativeSession(data); session.advance_to(.11)
+    run = module.run_protocol_control(session, ["A", "B"], horizon=3., routes=False, prebalance=False)
+    calls = [c for c in run["client_calls"] if c["kind"] == "service_forecast" and not c["retry"]]
+    withdrawals = [c for c in run["client_calls"] if c["kind"] == "withdraw_service_forecast" and not c["retry"]]
+    acks = session.observe_protocol("A")["delivered_command_acks"]
+    late = {c["request"]["request_id"] for c in calls if c["at"] >= 2.}
+    rows.append({"name": "same_stage_forecast_recovery", "fixed": bool(late) and
+                 any(a["request_id"] in late and a["status"] == "delivered" for a in acks),
+                 "publication_times": [c["at"] for c in calls], "withdrawal_times": [c["at"] for c in withdrawals],
+                 "late_publication_ids": sorted(late)})
+    write_json(output/"forecast_input.json", data)
+    with gzip.open(output/"forecast_run.json.gz", "wt", encoding="utf-8") as f:
+        json.dump({"run": run, "acks": acks}, f)
+
+    data = base()
+    data["node_records"] = [(n, kind, 10. if n == 0 else service, x, y, successors)
+        for n, kind, service, x, y, successors in data["node_records"]]
+    data["faults"] = [{"from": 0, "to": 1, "start": .15, "end": 1.}]
+    data = prepare_input(data)
+    session = native.NativeSession(data); session.advance_to(.11)
+    run = module.run_protocol_control(session, ["A", "B"], horizon=3., command_delay=.2,
+                                      forecasts=False, prebalance=False)
+    routes = [c for c in run["client_calls"] if c["kind"] == "route" and not c["retry"]]
+    acks = session.observe_protocol("A")["delivered_command_acks"]
+    alternatives = {c["request"]["request_id"] for c in routes if c["request"]["next"] == 6}
+    rows.append({"name": "same_stage_route_public_path_change", "fixed": bool(alternatives) and
+                 any(a["request_id"] in alternatives and a["status"] == "updated" for a in acks),
+                 "routes": [{"at": c["at"], "next": c["request"]["next"], "reply": c["reply"]} for c in routes]})
+    write_json(output/"route_input.json", data)
+    with gzip.open(output/"route_run.json.gz", "wt", encoding="utf-8") as f:
+        json.dump({"run": run, "acks": acks}, f)
+    return rows
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--controller-source", type=Path)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args(); args.output.mkdir(parents=True, exist_ok=False)
+    module = protocol_control
+    source = args.controller_source or Path(protocol_control.__file__)
+    if args.controller_source:
+        name = "scripts.experiments.g31_ics_circulation._frozen_protocol_controller_probe"
+        spec = importlib.util.spec_from_file_location(name, source)
+        module = importlib.util.module_from_spec(spec); sys.modules[name] = module
+        spec.loader.exec_module(module)
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt = {"schema": "g31.protocol_controller_probes.v1", "status": "running",
+               "controller_source": str(source), "source_before": before,
+               "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest()}
+    try:
+        receipt["cases"] = execute(module, load_native(args.binary), args.output)
+        receipt["status"] = "passed" if all(r["fixed"] for r in receipt["cases"]) else "failed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["exception"] = traceback.format_exc()
+    receipt["source_after"] = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt["source_changed"] = [] if receipt["source_after"] == before else [str(source)]
+    write_json(args.output/"receipt.json", receipt)
+    print(json.dumps(receipt, indent=2))
+    return int(bool(receipt["source_changed"]) or (args.require_fixed and receipt["status"] != "passed"))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/probe_protocol_demand_capture.py b/scripts/experiments/g31_ics_circulation/probe_protocol_demand_capture.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/probe_protocol_demand_capture.py
@@ -0,0 +1,133 @@
+"""Native delayed demand capture can differ from its client's cached signature.
+
+Y arrives between controller ticks and waits for an actually occupied tray.
+The delayed native publication captures Y before the tray becomes available;
+Y is then physically loaded before the next tick. The queue is empty at both
+client sampling ticks, but the receiver must eventually receive a correction.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import traceback
+
+from . import protocol_control
+from .native_host import audit_result, load_native, prepare_input, tiny_cycle
+from .original_workload import write_json
+
+
+def scene():
+    data = tiny_cycle()
+    data["transfers"] = []
+    data["trays"] = [{"tray_id": "T0", "node": 5}]
+    data["edge_records"] = [(u, v, .1 if (u, v) == (5, 0) else length, speed)
+                            for u, v, length, speed in data["edge_records"]]
+    y = copy.deepcopy(data["jobs"][0])
+    y.update(business_bag_id="Y", arrival=.1, load_seconds=10.)
+    data["jobs"] = [{"business_bag_id": "P", "origin": 5, "destination": 0,
+        "arrival": 0., "deadline": 40., "load_seconds": .01, "unload_seconds": .05,
+        "hold_seconds": .1, "protected_service": True}, y]
+    data["owner_protocol"] = {"enabled": True, "timeout": .2, "ack_delay": .02}
+    data["model_scope"] = "native delayed demand capture of transient real waiting queue; no client future input"
+    return prepare_input(data)
+
+
+class CapturePublic:
+    def __init__(self, session):
+        self.session = session
+        self.signatures = []
+        self.observations = []
+
+    def __getattr__(self, name):
+        return getattr(self.session, name)
+
+    def protocol_demand_signature(self, owner):
+        value = self.session.protocol_demand_signature(owner)
+        self.signatures.append({"at": self.session.physical_time, "owner": owner, "signature": copy.deepcopy(value)})
+        return value
+
+    def observe_protocol_control(self, owner):
+        value = self.session.observe_protocol_control(owner)
+        if owner == "B":
+            self.observations.append(copy.deepcopy(value))
+        return value
+
+
+def execute(module, native, output):
+    data = scene()
+    write_json(output / "input.json", data)
+    raw = native.NativeSession(data)
+    raw.advance_to(.02)
+    captured = CapturePublic(raw)
+    run = module.run_protocol_control(captured, ["A", "B"], horizon=2.9, control_period=1.,
+        command_delay=.2, publication_delay=.02, routes=False, forecasts=False, prebalance=False)
+    final_observation = raw.observe_protocol("B")
+    audit = audit_result(data, run["result"])
+    loads = [r for r in run["result"]["receipts"] if r["event"] == "LOAD_START" and r["business_bag_id"] == "Y"]
+    a_signatures = [s for s in captured.signatures if s["owner"] == "A"]
+    messages = [m for o in captured.observations for m in o["delivered_messages"]
+                if m["kind"] == "demand" and m["source_owner"] == "A"]
+    # Compact observations intentionally omit message job identities; the
+    # exact count remains a lawful receiver observation.
+    transient = [m for m in messages if m.get("snapshot_waiting_count", len(m["jobs"])) > 0]
+    latest = next((m for m in final_observation["delivered_messages"]
+                   if m["kind"] == "demand" and m["source_owner"] == "A"), None)
+    source_now = raw.protocol_demand_signature("A")
+    fixture_valid = (run["status"] == "reached" and audit["status"] == "passed" and len(loads) == 1
+        and bool(transient) and all(s["signature"]["waiting_count"] == 0 for s in a_signatures)
+        and source_now["waiting_count"] == 0 and all(m["observed_at"] < loads[0]["time"] for m in transient))
+    corrected = bool(latest and not latest["jobs"] and loads and latest["observed_at"] > loads[0]["time"])
+    result = {"name": "delayed_capture_transient_queue", "fixture_valid": fixture_valid,
+        "fixed": fixture_valid and corrected, "receiver_corrected_after_real_load": corrected,
+        "source_sampled_signatures": a_signatures, "actual_y_load": loads,
+        "transient_receiver_messages": transient, "final_receiver_message": latest,
+        "final_source_signature": source_now,
+        "demand_calls": [c for c in run["client_calls"] if c["kind"] == "demand"], "audit": audit}
+    with gzip.open(output / "raw.json.gz", "wt", encoding="utf-8") as stream:
+        json.dump({"run": run, "receiver_observations": captured.observations,
+                   "final_receiver_observation": final_observation}, stream, allow_nan=False)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--controller-source", type=Path)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    module = protocol_control
+    source = args.controller_source or Path(protocol_control.__file__)
+    if args.controller_source:
+        name = "scripts.experiments.g31_ics_circulation._frozen_demand_capture_controller"
+        spec = importlib.util.spec_from_file_location(name, source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    before = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt = {"schema": "g31.protocol_demand_capture_probe.v1", "status": "running",
+        "controller_source": str(source), "source_before": before,
+        "probe_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest()}
+    try:
+        receipt["case"] = execute(module, load_native(args.binary), args.output)
+        receipt["status"] = "passed" if receipt["case"]["fixed"] else "failed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["source_after"] = hashlib.sha256(source.read_bytes()).hexdigest()
+    receipt["source_changed"] = [] if receipt["source_after"] == before else [str(source)]
+    write_json(args.output / "receipt.json", receipt)
+    print(json.dumps({k: receipt[k] for k in ("status", "source_changed", "exception") if k in receipt}))
+    return int(bool(receipt["source_changed"]) or (args.require_fixed and receipt["status"] != "passed"))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
