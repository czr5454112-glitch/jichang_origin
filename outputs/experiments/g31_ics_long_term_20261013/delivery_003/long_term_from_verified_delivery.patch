+    main()
diff --git a/scripts/experiments/g31_ics_circulation/probe_future_transfer_namespace.py b/scripts/experiments/g31_ics_circulation/probe_future_transfer_namespace.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/probe_future_transfer_namespace.py
@@ -0,0 +1,59 @@
+"""Execute, record, and optionally reject online queries into an unissued tape."""
+from copy import deepcopy
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).absolute().parents[3]
+sys.path.insert(0, str(ROOT))
+from scripts.experiments.g31_ics_circulation.native_host import load_native, tiny_cycle
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    receipt = {"schema": "g31.future_transfer_namespace_probe.v1", "binary": str(args.binary.absolute()),
+               "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(), "variants": []}
+    try:
+        native = load_native(args.binary)
+        plain = tiny_cycle()
+        plain["transfers"] = []
+        request = dict(request_id="future-private", tray_id="T0", source=0, destination=4,
+                       issued_at=40, earliest_departure=40, expiry=60, message_delay=0)
+        future = deepcopy(plain)
+        future["transfers"].append(request)
+        for label, data in (("without_future_request", plain), ("with_future_request", future)):
+            cancel, submit = native.NativeSession(data), native.NativeSession(data)
+            before = cancel.offline_state_sha256()
+            observed = cancel.observe("A")
+            cancellation = cancel.cancel_transfer_intent(request["request_id"], "A")
+            publication = submit.submit_transfer_intent(dict(request, owner_id="A"))
+            row = {"name": label, "input": data, "observation_before": observed,
+                   "cancel_response": cancellation, "cancel_changed_state": before != cancel.offline_state_sha256(),
+                   "submit_response": publication}
+            receipt["variants"].append(row)
+        a, b = receipt["variants"]
+        receipt["observations_equal"] = a["observation_before"] == b["observation_before"]
+        receipt["fixed"] = receipt["observations_equal"] and all(
+            row["cancel_response"] == dict(status="rejected", reason="unknown_request") and
+            row["submit_response"] == dict(status="rejected", reason="online_request_namespace_required") and
+            not row["cancel_changed_state"] for row in receipt["variants"])
+        receipt["status"] = "passed" if receipt["fixed"] else "reproduced_hidden_future_oracle"
+    except Exception as error:
+        receipt["status"] = "execution_error"
+        receipt["exception"] = repr(error)
+        raise
+    finally:
+        (args.output / "receipt.json").write_text(json.dumps(receipt, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps({key: receipt[key] for key in ("status", "fixed", "observations_equal")}, ensure_ascii=False))
+    return 1 if args.require_fixed and not receipt["fixed"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/probe_joint_read_set.py b/scripts/experiments/g31_ics_circulation/probe_joint_read_set.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/probe_joint_read_set.py
@@ -0,0 +1,70 @@
+"""Actual same-clock pledge/cancel counterexample, including saved pre-fix code."""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+from . import joint_window_repair
+from .native_host import load_native
+from .validate_analytic_control import write
+from .validate_joint_window_repair import SCENARIOS, prefix, scenario_input
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--implementation-file", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--require-fixed", action="store_true")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    implementation = joint_window_repair
+    if args.implementation_file:
+        spec = importlib.util.spec_from_file_location(
+            "scripts.experiments.g31_ics_circulation._saved_joint_before", args.implementation_file)
+        implementation = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(implementation)
+    path = Path(implementation.__file__)
+    native = load_native(args.binary)
+    rows = []
+    for mutation in ("new_pledge", "cancel_pledge"):
+        session, _ = prefix(native, scenario_input(SCENARIOS[0]))
+        initial = session.observe("A")
+        initial_domain = implementation.build_domain(initial)
+        first = deepcopy(next(a for a in initial_domain["actions"] if len(a["candidates"]) == 2)["candidates"][0]["request"])
+        first["request_id"] += ":other-controller"
+        if mutation == "new_pledge":
+            observed, domain = initial, initial_domain
+            mutation_reply = session.submit_transfer_intent(first)
+        else:
+            session.submit_transfer_intent(first)
+            observed = session.observe("A")
+            domain = implementation.build_domain(observed)
+            mutation_reply = session.cancel_transfer_intent(first["request_id"], "A")
+        current = session.observe("A")
+        assert current["version"] == observed["version"] and current["now"] == observed["now"] and current != observed
+        selected = next(a for a in domain["actions"] if a["candidates"])
+        before = session.offline_state_sha256()
+        reply = implementation.submit_action(session, selected, observed)
+        after = session.offline_state_sha256()
+        rows.append({"mutation": mutation, "original_public": observed, "current_public": current,
+                     "action": selected, "mutation_reply": mutation_reply, "submit_reply": reply,
+                     "unchanged_version": current["version"], "unchanged_clock": current["now"],
+                     "state_before_submission": before, "state_after_submission": after,
+                     "passed": reply["status"] == "stale_read_set" and before == after})
+    receipt = {"schema": "g31.joint_read_set_probe.v1", "status": "passed" if all(r["passed"] for r in rows) else "failed",
+               "implementation": str(path), "implementation_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+               "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(), "rows": rows}
+    write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "rows": [{"mutation": r["mutation"],
+        "reply": r["submit_reply"]["status"], "passed": r["passed"]} for r in rows]}))
+    if args.require_fixed and receipt["status"] != "passed":
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/probe_offline_wait_diagnostics.py b/scripts/experiments/g31_ics_circulation/probe_offline_wait_diagnostics.py
