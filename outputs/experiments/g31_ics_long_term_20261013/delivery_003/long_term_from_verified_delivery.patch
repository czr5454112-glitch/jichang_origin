+"""Executed R2 baseline and finite-reference campaign; native physics only."""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+import time
+import traceback
+
+from .analytic_control import run_online_matching, transfer_candidates
+from .finite_reference import Intervention, enumerate_interventions, headroom, outcome_cost, service_dominates
+from .native_host import audit_result, load_native, prepare_input, tiny_cycle
+
+
+def write(path: Path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
+
+
+def replay_input(data, submitted):
+    replay = copy.deepcopy(data)
+    replay["transfers"] = [dict(r["request"]) for r in submitted
+                           if r["reply"].get("status") not in ("rejected", "timeout_unknown", "failed_no_safe_continuation")]
+    return replay
+
+
+def scenarios():
+    original = tiny_cycle()
+    original["transfers"] = []
+    result = {"command_delay_2": (original, 2.0, .5)}
+    zero = copy.deepcopy(original)
+    result["zero_delay"] = zero, 0.0, 0.0
+    delayed = copy.deepcopy(original)
+    delayed["jobs"][0]["storage_release_at"] = 20
+    result["storage_delay_20"] = delayed, 2.0, .5
+    stock = copy.deepcopy(original)
+    stock["node_contracts"][4]["export_min_stock"] = 1
+    result["source_reserve_refusal"] = stock, 2.0, .5
+    deny = copy.deepcopy(original)
+    deny["node_contracts"][0]["allow_receive"] = False
+    result["receiver_refusal"] = deny, 2.0, .5
+    future = copy.deepcopy(original)
+    future["jobs"][1]["arrival"] = 25
+    result["unpublished_future_demand"] = future, 2.0, .5
+    plentiful = copy.deepcopy(original)
+    plentiful["node_contracts"][0]["capacity"] = 2
+    plentiful["trays"].append({"tray_id": "T1", "node": 0})
+    result["two_trays_terminal_pressure"] = plentiful, 2.0, .5
+    spare = copy.deepcopy(plentiful)
+    spare["node_contracts"][4]["capacity"] = 2
+    result["two_trays_spare_terminal_no_benefit"] = spare, 2.0, .5
+    long = copy.deepcopy(original)
+    long["edge_records"] = [(u, v, 10 if (u, v) == (4, 5) else length, speed)
+                            for u, v, length, speed in long["edge_records"]]
+    result["longer_return_research_factor"] = prepare_input(long), 2.0, .5
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    files = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("finite_reference.py"),
+             Path(__file__).with_name("native_host.py")]
+    before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    receipt = {"schema": "g31.analytic_native_campaign.v1", "status": "running", "cases": [],
+               "source_before": before, "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(),
+               "information": "owner projection plus delayed observed-demand snapshots; no input transfers",
+               "research_scope": "synthetic mechanism development; not original-map confirmation",
+               "acceptance_scope": "independent native physical replay and full-population paired service; no main-method or 100ms claim"}
+    write(args.output / "receipt.json", receipt)
+    started = time.perf_counter()
+    try:
+        native = load_native(args.binary)
+        for name, (data, delay, demand_delay) in scenarios().items():
+            folder = args.output / name
+            folder.mkdir()
+            write(folder / "input.json", data)
+            metrics = {}
+            for predictive in (False, True):
+                policy = "predictive" if predictive else "reactive"
+                run = run_online_matching(native.NativeSession(data), ["A", "B"], horizon=80,
+                                          predictive=predictive, message_delay=delay, demand_delay=demand_delay)
+                # Independent replay uses requests actually produced at runtime,
+                # not a hand-written successful return schedule.
+                replay = replay_input(data, run["submitted"])
+                write(folder / f"{policy}_raw.json", run)
+                write(folder / f"{policy}_replay_input.json", replay)
+                if run["status"] != "reached":
+                    raise RuntimeError(f"{name}/{policy}:native_event_budget_exhausted")
+                audit = audit_result(replay, run["result"])
+                value = outcome_cost(run["result"], data["jobs"], 80)
+                write(folder / f"{policy}_audit.json", audit)
+                write(folder / f"{policy}_metrics.json", value)
+                if name == "unpublished_future_demand":
+                    assert all(r["request"]["issued_at"] >= data["jobs"][1]["arrival"]
+                               for r in run["submitted"])
+                metrics[policy] = value
+            row = {"case": name, "metrics": metrics,
+                   "cost_difference_predictive_minus_reactive": metrics["predictive"]["cost"] - metrics["reactive"]["cost"],
+                   "paired_service_preserved": service_dominates(metrics["predictive"], metrics["reactive"])}
+            receipt["cases"].append(row)
+            assert row["paired_service_preserved"], (name, "paired service regression")
+            if name == "two_trays_spare_terminal_no_benefit":
+                assert metrics["reactive"]["completed"] == metrics["predictive"]["completed"] == 2
+                assert abs(row["cost_difference_predictive_minus_reactive"]) < 1e-8
+            write(args.output / "receipt.json", receipt)
+        # Actual common checkpoint, no prewritten transfers; one intervention.
+        data = scenarios()["command_delay_2"][0]
+        # Native state alone is insufficient for controller continuation: the
+        # publication cache and periodic phase are checkpointed separately as
+        # trusted JSON, and each sibling receives a deep copy.
+        parent = native.NativeSession(data)
+        prefix = run_online_matching(parent, ["A", "B"], horizon=8, predictive=True,
+                                     message_delay=2, demand_delay=.5)
+        saved = json.loads(json.dumps(prefix["controller_state"]))
+        parent_identity = parent.offline_state_sha256()
+        siblings = [run_online_matching(parent.fork(), ["A", "B"], horizon=80, predictive=True,
+                                        message_delay=2, demand_delay=.5, controller_state=copy.deepcopy(saved))
+                    for _ in range(2)]
+        uninterrupted = json.loads((args.output / "command_delay_2" / "predictive_raw.json").read_text(encoding="utf-8"))
+        compared = ["receipts", "jobs", "trays", "transfers", "leg_identities"]
+        for key in compared:
+            assert siblings[0]["result"][key] == siblings[1]["result"][key] == uninterrupted["result"][key], key
+        assert parent.offline_state_sha256() == parent_identity
+        write(args.output / "controller_continuation.json", {
+            "status": "passed", "checkpoint_time": 8, "controller_state": saved,
+            "parent_state_unchanged": True, "equal_fields": compared,
+            "sibling_controller_states_equal": siblings[0]["controller_state"] == siblings[1]["controller_state"],
+            "scope": "one real pending-message boundary; native fork plus JSON controller state; no duplicate current control tick"})
+        session = native.NativeSession(data)
+        session.advance_to(.5)
+        session.publish_demand("A", "B", .5)
+        session.advance_to(8.0)
+        public = session.observe("B")
+        proposed = transfer_candidates(public, predictive=True, message_delay=2)
+        actions = [Intervention("WAIT", "wait")]
+        for i, request in enumerate(proposed["intents"]):
+            actions.append(Intervention(f"transfer-{i}", "transfer", request))
+            later = dict(request, request_id=request["request_id"] + ":later", earliest_departure=15)
+            actions.append(Intervention(f"transfer-later-{i}", "transfer", later))
+
+        def validate(result, action):
+            replay = copy.deepcopy(data)
+            if action.kind == "transfer":
+                replay["transfers"].append(action.request)
+            return audit_result(replay, result)
+
+        strong_baseline = "transfer-0" if len(actions) > 1 else "WAIT"
+        reference = enumerate_interventions(session, actions, horizon=80, job_contracts=data["jobs"],
+                                            baseline_action_id=strong_baseline, validate=validate)
+        write(args.output / "reference_observation.json", public)
+        best = reference["best_action_id"]
+        write(args.output / "headroom.json", headroom(reference, [a.action_id for a in actions], best, strong_baseline))
+        reference["strong_baseline_action_id"] = strong_baseline
+        wait_cost = next(r["metrics"]["cost"] for r in reference["rows"] if r["action"]["action_id"] == "WAIT")
+        reference["wait_control_gap_only"] = wait_cost - reference["best_cost"]
+        write(args.output / "finite_reference.json", reference)
+        # Actual pending -> rejection must not masquerade as an executed WAIT
+        # alternative. Also keep a request unresolved beyond H as unknown.
+        blocked_data = copy.deepcopy(data)
+        blocked_data["node_contracts"][4]["export_min_stock"] = 1
+        blocked = native.NativeSession(blocked_data)
+        blocked.advance_to(8)
+        denied_request = dict(proposed["intents"][0], request_id="live:reference-source-reserve",
+                              expected_version=blocked.observe("B")["version"])
+
+        def blocked_validate(result, action):
+            replay = copy.deepcopy(blocked_data)
+            if action.kind == "transfer":
+                replay["transfers"].append(action.request)
+            return audit_result(replay, result)
+
+        denied = enumerate_interventions(blocked, [Intervention("WAIT", "wait"),
+            Intervention("source-reserve", "transfer", denied_request)], horizon=80,
+            job_contracts=blocked_data["jobs"], validate=blocked_validate)
+        denied_row = next(r for r in denied["rows"] if r["action"]["action_id"] == "source-reserve")
+        assert denied_row["reply"]["status"] == "pending"
+        assert denied_row["status"] == "asynchronous_rejected"
+        assert denied_row["execution_resolution"]["reason"] == "source_module_min_stock"
+        write(args.output / "finite_async_rejection.json", denied)
+        late_request = dict(proposed["intents"][0], request_id="live:reference-outside-horizon",
+                            earliest_departure=100, expiry=150)
+        unresolved = enumerate_interventions(session, [Intervention("WAIT", "wait"),
+            Intervention("after-horizon", "transfer", late_request)], horizon=80,
+            job_contracts=data["jobs"], validate=validate)
+        assert unresolved["optimality"] == "unknown" and not unresolved["exhaustive"]
+        assert any(r["status"] == "unresolved_at_horizon" for r in unresolved["rows"])
+        write(args.output / "finite_unresolved.json", unresolved)
+        # Preserve the independently discovered prefix/result wrapper bug as
+        # an actual native regression, not only a status-only unit test.
+        censored_data = tiny_cycle()
+        censored_data["transfers"] = []
+        censored_data["options"]["max_events"] = 5
+        censored_source = native.NativeSession(censored_data)
+        def censored_continue(branch, horizon):
+            return run_online_matching(branch, ["A", "B"], horizon=horizon, predictive=False,
+                                       publish=False)["result"]
+        censored_reference = enumerate_interventions(censored_source,
+            [Intervention("WAIT", "wait"), Intervention("second", "wait")], horizon=20,
+            job_contracts=censored_data["jobs"], continuation=censored_continue,
+            validate=lambda result, action: audit_result(censored_data, result))
+        assert not censored_reference["exhaustive"] and censored_reference["optimality"] == "unknown"
+        assert all(row["status"] == "incomplete_horizon" and "metrics" not in row
+                   for row in censored_reference["rows"])
+        write(args.output/"finite_censored_continuation.json", censored_reference)
+        receipt["finite_reference"] = {key: value for key, value in reference.items() if key != "rows"}
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["traceback"] = traceback.format_exc()
+        raise
+    finally:
+        receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+        receipt["source_changed"] = [p for p in before if before[p] != receipt["source_after"][p]]
+        receipt["elapsed_seconds"] = time.perf_counter() - started
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "cases": len(receipt["cases"]),
+                      "reference": receipt["finite_reference"]}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_checkpoint_native.py b/scripts/experiments/g31_ics_circulation/validate_checkpoint_native.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_checkpoint_native.py
@@ -0,0 +1,94 @@
+"""Compile and execute native checkpoint regressions with immutable receipts.
+
+This Windows development-machine runner invokes actual MSVC compilation for
+each target; it does not trust incremental header dependency scanning. CMake's
+circulation_checkpoint target remains the portable test entry point.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import time
+
+ROOT = Path(__file__).absolute().parents[3]
+
+
+def digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--vcvars", type=Path, required=True)
+    parser.add_argument("--targets", nargs="+", choices=("test_circulation_checkpoint", "test_circulation_runtime",
+                        "test_g4irsf14_state_clone_protocol"),
+                        default=["test_circulation_checkpoint", "test_circulation_runtime", "test_g4irsf14_state_clone_protocol"])
+    args = parser.parse_args()
+    out = args.output.absolute()
+    out.mkdir(parents=True, exist_ok=False)
+    build = ROOT / "build_lt_checkpoint" / out.name
+    build.mkdir(parents=True, exist_ok=False)
+    # These paths enter a generated cmd file. Permit ordinary Windows paths,
+    # never shell metacharacters or cmd environment substitution.
+    for value in (ROOT, out, build, args.vcvars):
+        if any(char in str(value) for char in '\r\n"&|<>^%'):
+            raise ValueError("unsupported shell metacharacter in build path")
+    targets = tuple(args.targets)
+    # Header-only runtime plus these exact translation units. The concurrently
+    # developed Python binding translation unit is not a compiled input here.
+    sources = sorted([*(p for p in ROOT.glob("cpp/ics_core/**/*.hpp")
+                        if "bindings" not in p.relative_to(ROOT).parts),
+                      *(ROOT / "cpp/tests" / (name + ".cpp") for name in targets)])
+    snapshot = lambda: {p.relative_to(ROOT).as_posix(): digest(p) for p in sources}
+    receipt = {"schema": "g31.circulation.native_checkpoint_validation.v1", "status": "started",
+               "source_root": str(ROOT), "build_root": str(build), "source_before": snapshot(),
+               "commands": [], "binary_sha256": {}, "incremental_build_used": False}
+    start = time.perf_counter()
+    try:
+        for target in targets:
+            executable = build / (target + ".exe")
+            script = out / (target + ".cmd")
+            # The literal escaped quotes are required by cl's /D parser; they
+            # define a C++ string and are not JSON/shell interpolation.
+            script.write_text(
+                '@echo off\ncall "' + str(args.vcvars.absolute()) + '"\n'
+                'if errorlevel 1 exit /b %errorlevel%\n'
+                'cl /nologo /std:c++17 /EHsc /O2 /MD /bigobj /DCZR005_EVENT_RUNTIME_TESTING=1 '
+                '/DCZR005_SOURCE_DIR=\\"' + ROOT.as_posix() + '\\" '
+                '/I"' + (ROOT / 'cpp').as_posix() + '" "' +
+                (ROOT / 'cpp/tests' / (target + '.cpp')).as_posix() + '" '
+                '/Fo"' + (build / (target + '.obj')).as_posix() + '" '
+                '/Fe"' + executable.as_posix() + '"\nexit /b %errorlevel%\n', encoding="utf-8")
+            for phase, argv in (("compile", ["cmd.exe", "/c", str(script)]),
+                                ("run", [str(executable)])):
+                with (out / f"{target}.{phase}.stdout.log").open("wb") as stdout, \
+                     (out / f"{target}.{phase}.stderr.log").open("wb") as stderr:
+                    started = time.perf_counter()
+                    result = subprocess.run(argv, cwd=ROOT, stdout=stdout, stderr=stderr, check=False)
+                receipt["commands"].append({"target": target, "phase": phase, "argv": argv,
+                                            "exit_code": result.returncode,
+                                            "wall_seconds": time.perf_counter()-started})
+                if result.returncode:
+                    raise RuntimeError(f"{target} {phase} failed: {result.returncode}; raw logs preserved")
+            receipt["binary_sha256"][str(executable)] = digest(executable)
+        receipt["source_after"] = snapshot()
+        receipt["source_changed"] = [p for p, h in receipt["source_before"].items()
+                                     if receipt["source_after"].get(p) != h]
+        if receipt["source_changed"]:
+            raise RuntimeError("sources changed during validation; development evidence only")
+        receipt["status"] = "passed"
+    except Exception as exc:
+        receipt["status"] = "failed"
+        receipt["error"] = str(exc)
+    receipt["wall_seconds"] = time.perf_counter()-start
+    (out / "receipt.json").write_text(json.dumps(receipt, indent=2), encoding="utf-8")
+    print(json.dumps({k: receipt[k] for k in ("status", "wall_seconds")}, indent=2))
+    return 0 if receipt["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_compact_control.py b/scripts/experiments/g31_ics_circulation/validate_compact_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_compact_control.py
@@ -0,0 +1,105 @@
+"""Executed full/compact G31 controller equivalence; no new policy mechanism."""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .native_host import audit_result, load_native
+from .validate_analytic_control import replay_input, scenarios, write
+from .validate_known_service_control import known_service_input, prefix
+
+
+def _hash(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _write_gzip(path, value):
+    with gzip.open(path, "wt", encoding="utf-8") as stream:
+        json.dump(value, stream, ensure_ascii=False, allow_nan=False)
+
+
+def compare(full, compact):
+    assert full["status"] == compact["status"] == "reached"
+    assert full["submitted"] == compact["submitted"]
+    assert full["controller_state"] == compact["controller_state"]
+    decisions = 0
+    keys = ("intents", "supplies", "forecasts", "exact_waiting_count", "exact_demand_count",
+            "clearing_pressure_without_available_source", "assignment_demand_count")
+    for a, b in zip(full["control_records"], compact["control_records"], strict=True):
+        assert a["owner_id"] == b["owner_id"] and a["replies"] == b["replies"]
+        for da, db in zip([a["decision"]]+a["replans"], [b["decision"]]+b["replans"], strict=True):
+            for key in keys:
+                assert da[key] == db[key], (a["owner_id"], da["now"], key)
+            decisions += 1
+    fields = ("receipts", "jobs", "trays", "transfers", "population", "leg_identities")
+    for field in fields:
+        assert full["result"][field] == compact["result"][field], field
+    return {"equal_decisions_including_residual": decisions, "physical_fields_equal": list(fields),
+            "submitted_requests": len(full["submitted"]), "all_offered_jobs_retained": len(full["result"]["jobs"]),
+            "status": "passed"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    files = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("validate_analytic_control.py"),
+             Path(__file__).with_name("validate_known_service_control.py")]
+    before = {str(p): _hash(p) for p in files}
+    receipt = {"schema": "g31.compact_control_equivalence.v1", "status": "running", "cases": [],
+               "source_before": before, "binary_sha256": _hash(args.binary),
+               "scope": "same lawful information and exact equivalent FIFO assignment; synthetic mechanisms plus real native/controller continuation",
+               "novelty": "engineering_optimization_only", "complete_100ms_requirement_certified": False}
+    write(args.output/"receipt.json", receipt)
+    started = time.perf_counter()
+    try:
+        native = load_native(args.binary)
+        for name, (data, delay, demand_delay) in scenarios().items():
+            for predictive in (False, True):
+                case = name+("_predictive" if predictive else "_reactive")
+                parent = native.NativeSession(data)
+                before_parent = parent.offline_state_sha256()
+                runs = [run_online_matching(parent.fork(), ["A", "B"], horizon=80., predictive=predictive,
+                         message_delay=delay, demand_delay=demand_delay, compact_projection=compact)
+                        for compact in (False, True)]
+                _write_gzip(args.output/(case+".json.gz"), {"input": data, "full": runs[0], "compact": runs[1]})
+                row = compare(*runs)
+                assert parent.offline_state_sha256() == before_parent
+                row.update(case=case, parent_unchanged=True,
+                           audit=audit_result(replay_input(data, runs[1]["submitted"]), runs[1]["result"]))
+                receipt["cases"].append(row)
+                write(args.output/"receipt.json", receipt)
+        data = known_service_input()
+        parent, pre = prefix(native, data, predictive=True, windows=True)
+        state = json.loads(json.dumps(pre["controller_state"]))
+        runs = [run_online_matching(parent.fork(), ["A", "B", "C"], horizon=40., predictive=True,
+                message_delay=1., demand_delay=.2, respect_service_forecasts=True,
+                controller_state=copy.deepcopy(state), compact_projection=compact) for compact in (False, True)]
+        _write_gzip(args.output/"forecast_json_continuation.json.gz", {"input": data, "prefix": pre,
+                    "full": runs[0], "compact": runs[1]})
+        row = compare(*runs)
+        row.update(case="delivered_service_forecast_native_and_json_controller_forks", saved_controller_state=state)
+        receipt["cases"].append(row)
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["source_changed"] = [str(p) for p in files if _hash(p) != before[str(p)]]
+    receipt["wall_seconds"] = time.perf_counter()-started
+    write(args.output/"receipt.json", receipt)
+    print(json.dumps(receipt, indent=2, ensure_ascii=False))
+    return int(receipt["status"] != "passed" or bool(receipt["source_changed"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_coupled_control.py b/scripts/experiments/g31_ics_circulation/validate_coupled_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_coupled_control.py
@@ -0,0 +1,128 @@
+"""A native R1 x R2 causal probe, including service regressions if they occur.
+
+The alternate suffix is a predeclared legal causal intervention, not a claimed
+optimal regional algorithm. Both transfer policies are actual same-information
+controllers. This synthetic probe cannot establish main-method innovation.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import traceback
+
+from .analytic_control import run_online_matching
+from .finite_reference import outcome_cost, service_dominates
+from .native_host import audit_result, load_native, prepare_input
+from .regional_control import RoutePacket, decode_route, encode_route
+from .validate_analytic_control import replay_input, write
+
+
+def coupled_input(source_min_stock: int = 1):
+    edges = [(0, 1, 1., 1.), (1, 3, 4., 1.), (0, 2, 1.3, 1.), (2, 3, 4., 1.),
+             (3, 6, .4, 1.), (6, 1, .4, 1.), (1, 4, .4, 1.), (4, 5, 1., 1.), (5, 0, 1., 1.)]
+    nodes = [{"node": n, "zone": "A" if n == 0 else "C" if n in (4, 5) else "B",
+              "capacity": 2 if n == 0 else 1} for n in range(7)]
+    nodes[0]["export_min_stock"] = source_min_stock
+    return prepare_input({"schema": "g31.circulation.input.v1",
+        "model_scope": "synthetic declared coupled shared-junction causal probe; not an original airport map",
+        "node_records": [(n, 1, .05, n, 0, [v for u, v, _, _ in edges if u == n]) for n in range(7)],
+        "edge_records": edges, "node_contracts": nodes,
+        "edge_contracts": [{"from": u, "to": v, "capacity": 1, "entry_headway": .2} for u, v, _, _ in edges],
+        "trays": [{"tray_id": "T0", "node": 0}, {"tray_id": "T1", "node": 0}],
+        "jobs": [{"business_bag_id": name, "origin": origin, "destination": destination,
+                  "arrival": arrival, "deadline": 40, "load_seconds": .1, "unload_seconds": .3,
+                  "hold_seconds": .2, "protected_service": True, "allow_suffix_reroute": True}
+                 for name, origin, destination, arrival in [("B1", 0, 3, 0), ("B2", 0, 3, 6.2), ("B3", 4, 5, .5)]],
+        "transfers": [], "faults": [], "options": {"max_simulation_time": 50}})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--source-min-stock", type=int, default=1)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    data = coupled_input(args.source_min_stock)
+    write(args.output / "input.json", data)
+    native = load_native(args.binary)
+    paths = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("regional_control.py"), Path(__file__).with_name("finite_reference.py")]
+    sources = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    receipt = {"status": "running", "schema": "g31.coupled_causal_probe.v1", "cases": {},
+               "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(), "source_before": sources,
+               "scope": "predeclared synthetic causal intervention; same information and physical contract; all negatives retained"}
+    write(args.output / "receipt.json", receipt)
+    try:
+        for alternate in (False, True):
+            for predictive in (False, True):
+                key = f"{'alternate' if alternate else 'S4'}_{'predictive' if predictive else 'reactive'}"
+                folder = args.output / key
+                folder.mkdir()
+                session = native.NativeSession(data)
+                session.advance_to(.11)
+                route_response = None
+                if alternate:
+                    observation = session.observe("A")
+                    tray = next(t for t in observation["trays"] if t["business_bag_id"] == "B1")
+                    packet = RoutePacket("g31.route_intent.v1", "B1", tray["tray_id"], "A", tray["generation"],
+                        tray["traversal_id"], "storage_out_or_direct", 3, (0,), (0, 2, 3), observation["now"])
+                    decoded = decode_route(encode_route(packet))
+                    request = {"request_id": "causal-B1-alternate", "owner_id": decoded.owner_id,
+                        "business_bag_id": decoded.business_bag_id, "tray_id": decoded.tray_id,
+                        "from": decoded.replaceable_suffix[0], "next": decoded.replaceable_suffix[1],
+                        "expected_generation": decoded.generation, "expected_traversal": decoded.traversal_id,
+                        "expiry": 1, "message_delay": 0}
+                    route_response = session.submit_route_intent(request)
+                    write(folder / "route_request.json", {"packet": encode_route(packet), "request": request,
+                                                           "submission_reply": route_response})
+                run = run_online_matching(session, ["A", "B", "C"], horizon=40, predictive=predictive,
+                                          message_delay=1., demand_delay=.2)
+                write(folder / "raw.json", run)
+                if run["status"] != "reached":
+                    raise RuntimeError(key + ":native_event_budget_exhausted")
+                final_routes = session.observe("A")["route_requests"]
+                write(folder / "route_resolution.json", final_routes)
+                if alternate:
+                    assert final_routes[0]["status"] == "updated", final_routes
+                replay = replay_input(data, run["submitted"])
+                write(folder / "replay_input.json", replay)
+                audit = audit_result(replay, run["result"])
+                write(folder / "audit.json", audit)
+                value = outcome_cost(run["result"], data["jobs"], 40)
+                write(folder / "metrics.json", value)
+                first_hops = {}
+                for event in run["result"]["receipts"]:
+                    if event["event"] == "EDGE_ENTER" and event["business_bag_id"]:
+                        first_hops.setdefault(event["business_bag_id"], event["to"])
+                receipt["cases"][key] = {"metrics": value, "first_hops": first_hops,
+                    "requests": run["submitted"], "route_resolution": final_routes,
+                    "release_events": [r for r in run["result"]["receipts"] if r["event"] == "HOLD_COMPLETE"]}
+                write(args.output / "receipt.json", receipt)
+        rows = receipt["cases"]
+        # The experiment is successful when the intended causal effects are
+        # actually identified; service deterioration is retained, not asserted away.
+        route_effect = rows["S4_predictive"]["first_hops"]["B1"] != rows["alternate_predictive"]["first_hops"]["B1"]
+        transfer_effect = rows["S4_reactive"]["first_hops"]["B2"] != rows["S4_predictive"]["first_hops"]["B2"]
+        receipt["causal_observation"] = {"route_intent_changed_B1_physical_first_hop": route_effect,
+            "transfer_policy_changed_B2_physical_first_hop": transfer_effect,
+            "predictive_service_preserved_under_S4": service_dominates(rows["S4_predictive"]["metrics"], rows["S4_reactive"]["metrics"]),
+            "alternate_service_preserved_under_predictive": service_dominates(rows["alternate_predictive"]["metrics"], rows["S4_predictive"]["metrics"]),
+            "main_method_novelty": "not_established"}
+        receipt["status"] = "passed" if route_effect and transfer_effect else "causal_effect_not_identified"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["traceback"] = traceback.format_exc()
+        raise
+    finally:
+        receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+        receipt["source_changed"] = [p for p in sources if sources[p] != receipt["source_after"][p]]
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "causal_observation": receipt["causal_observation"]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_forecast_lifecycle.py b/scripts/experiments/g31_ics_circulation/validate_forecast_lifecycle.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_forecast_lifecycle.py
@@ -0,0 +1,111 @@
+"""Actual native forecast revision/withdrawal; prediction is not a tray grant."""
+from __future__ import annotations
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import traceback
+
+from .analytic_control import conditional_service_windows, run_online_matching
+from .native_host import audit_result, load_native
+from .validate_analytic_control import replay_input, write
+from .validate_known_service_control import known_service_input, prefix
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    files = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("validate_known_service_control.py")]
+    snap = lambda: {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    receipt = {"status": "running", "schema": "g31.native_forecast_lifecycle.v1", "source_before": snap(),
+               "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(), "cases": [],
+               "scope": "synthetic correctness/conditional-message baseline; no innovation or universal service guarantee"}
+    try:
+        native = load_native(args.binary)
+        data = known_service_input()
+        write(args.output/"input.json", data)
+        session = native.NativeSession(data); session.advance_to(.61)
+        original = session.publish_service_forecast("A", "B", "T1", 1, 2.)
+        withdrawal = session.withdraw_service_forecast("A", original["message_id"], .1)
+        duplicate = session.withdraw_service_forecast("A", original["message_id"], .1)
+        assert duplicate["status"] == "duplicate", duplicate
+        before = session.observe("B")
+        assert conditional_service_windows(before) == []
+        session.advance_to(.8)
+        early = session.observe("B")
+        assert len(early["delivered_messages"]) == 1 and early["delivered_messages"][0]["status"] == "withdrawn"
+        assert conditional_service_windows(early) == []
+        checkpoint = session.fork()
+        for branch in (session, checkpoint):
+            branch.advance_to(2.7)
+            assert conditional_service_windows(branch.observe("B")) == []
+        assert session.offline_state_sha256() == checkpoint.offline_state_sha256()
+        write(args.output/"overtaking_withdrawal.json", {"original": original, "withdrawal": withdrawal,
+            "duplicate": duplicate, "before": before, "withdrawal_arrived_first": early, "both_delivered": session.observe("B")})
+        receipt["cases"].append({"name": "withdrawal_overtakes_original_and_survives_fork", "status": "passed"})
+
+        # Same-clock announcements are ordered by source-target publication
+        # sequence; receiver delivery order is deliberately reversed.
+        session = native.NativeSession(data); session.advance_to(6.31)
+        old = session.publish_service_forecast("A", "B", "T1", 1, .5)
+        tray = next(t for t in session.observe("A")["trays"] if t["tray_id"] == "T1")
+        route = {"request_id": "forecast-revision-route", "owner_id": "A", "business_bag_id": "B2",
+                 "tray_id": "T1", "from": 0, "next": 2, "expected_generation": tray["generation"],
+                 "expected_traversal": tray["traversal_id"], "expiry": 7., "message_delay": 0.}
+        route_reply = session.submit_route_intent(route); session.advance_to(6.31)
+        assert session.observe("A")["route_requests"][-1]["status"] == "updated"
+        revised = session.publish_service_forecast("A", "B", "T1", 2, .1)
+        withdrawal = session.withdraw_service_forecast("A", old["message_id"], .05)
+        session.advance_to(6.9)
+        final = session.observe("B")
+        windows = conditional_service_windows(final)
+        assert len(windows) == 1 and windows[0]["message_id"] == revised["message_id"] and windows[0]["next"] == 2
+        result = session.result_at(7.)
+        first_hop = next(r["to"] for r in result["receipts"] if r["event"] == "EDGE_ENTER" and r["business_bag_id"] == "B2")
+        assert first_hop == 2
+        write(args.output/"same_clock_revision.json", {"old": old, "revised": revised, "withdrawal": withdrawal,
+            "route_reply": route_reply, "observation": final, "windows": windows, "result": result,
+            "audit": audit_result(data, result)})
+        receipt["cases"].append({"name": "same_clock_route_revision_late_old_tombstone", "status": "passed"})
+
+        session, pre = prefix(native, data, predictive=True, windows=True)
+        mid = run_online_matching(session, ["A", "B", "C"], horizon=7., predictive=True, message_delay=1.,
+            demand_delay=.2, respect_service_forecasts=True, controller_state=pre["controller_state"])
+        submissions = pre["submitted"] + mid["submitted"]
+        state = mid["controller_state"]
+        transfer = next(t for t in mid["result"]["transfers"] if t["status"] == "departed")
+        baseline = session.fork()
+        original_id = pre["forecast_publication"]["delivered"][0]["message_id"]
+        withdrawal = session.withdraw_service_forecast("A", original_id, 0.)
+        refusal = session.cancel_transfer_intent(transfer["request_id"], "B")
+        assert refusal["status"] == "rejected" and refusal["reason"] == "already_committed", refusal
+        run = run_online_matching(session, ["A", "B", "C"], horizon=40., predictive=True, message_delay=1.,
+            demand_delay=.2, respect_service_forecasts=True, controller_state=copy.deepcopy(state))
+        unchanged = run_online_matching(baseline, ["A", "B", "C"], horizon=40., predictive=True, message_delay=1.,
+            demand_delay=.2, respect_service_forecasts=True, controller_state=copy.deepcopy(state))
+        assert run["result"]["jobs"] == unchanged["result"]["jobs"]
+        assert run["result"]["trays"] == unchanged["result"]["trays"]
+        assert next(t for t in run["result"]["transfers"] if t["request_id"] == transfer["request_id"])["status"] == "received"
+        assert conditional_service_windows(session.observe("B")) == []
+        write(args.output/"withdrawal_is_not_physical_cancellation.json", {"withdrawal": withdrawal,
+            "cancel_refusal": refusal, "before_transfer": transfer, "result": run["result"], "baseline_result": unchanged["result"],
+            "audit": audit_result(replay_input(data, submissions+run["submitted"]), run["result"])})
+        receipt["cases"].append({"name": "withdrawal_keeps_departed_tray_and_forbids_transfer_cancel", "status": "passed"})
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"; receipt["traceback"] = traceback.format_exc()
+    finally:
+        receipt["source_after"] = snap()
+        receipt["source_changed"] = [p for p,v in receipt["source_before"].items() if receipt["source_after"][p] != v]
+        write(args.output/"receipt.json", receipt)
+    print(json.dumps(receipt))
+    return int(receipt["status"] != "passed" or bool(receipt["source_changed"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/validate_joint_circulation_factor.py b/scripts/experiments/g31_ics_circulation/validate_joint_circulation_factor.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_joint_circulation_factor.py
@@ -0,0 +1,197 @@
+"""Independent predeclared legal-return graph factor with common live control.
+
+The former absorbing-terminal experiment is immutable. This new synthetic
+physical contract is shared by every action/method and is not an airport fix.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .assess_joint_window_protection import compare
+from .finite_reference import _horizon_completion, outcome_cost, service_dominates
+from .joint_window_repair import build_domain, submit_action
+from .native_host import audit_result, load_native, prepare_input
+from .validate_analytic_control import replay_input, write
+from .validate_joint_window_repair import SCENARIOS, scenario_input
+
+
+HORIZON = 2000.
+CONTROL_PERIOD = 10.
+OWNERS = ["A", "B", "C"]
+
+
+def circulation_factor_input(spec):
+    data = copy.deepcopy(scenario_input(spec))
+    data["edge_records"].append((10, 7, .5, 1.))
+    data["edge_contracts"].append({"from": 10, "to": 7, "capacity": 1, "entry_headway": .2})
+    data["node_records"] = [tuple(list(n[:5]) + [[7]]) if n[0] == 10 else n for n in data["node_records"]]
+    data["model_scope"] = "independent synthetic legal-return factor: common 10->7 edge; not original airport or retroactive repair of absorbing-terminal experiment"
+    return prepare_input(data)
+
+
+def common_prefix(native, data):
+    session = native.NativeSession(data)
+    session.advance_to(.05)
+    forecast = session.publish_service_forecast("C", "A", "TP", 2, .02)
+    publications, published = [], {}
+    for owner in OWNERS:
+        local = session.observe(owner)
+        signature = sorted([j["business_bag_id"], j["origin"], j["arrival"], j.get("deadline", -1)]
+                           for j in local["jobs"] if j["status"] in ("waiting", "waiting_for_tray"))
+        for recipient in OWNERS:
+            if recipient != owner:
+                publications.append({"source": owner, "target": recipient,
+                                     "reply": session.publish_demand(owner, recipient, .02)})
+        published[owner] = signature
+    session.advance_to(.11)
+    # All channels were published once at .05. The first continuation decision
+    # is 10.11; no duplicate initial publication or extra .11 R2 action is added.
+    state = {"schema": "g31.analytic_controller_state.v1", "start": .11, "next_tick": 1,
+             "published": published, "config": {"owners": OWNERS, "predictive": True,
+                "control_period": CONTROL_PERIOD, "message_delay": .1, "demand_delay": .02,
+                "publish": True, "respect_service_forecasts": True}}
+    return session, state, {"forecast": forecast, "demand_publications": publications}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--max-seconds-per-case", type=float, default=180)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), *(Path(__file__).with_name(name) for name in (
+        "joint_window_repair.py", "analytic_control.py", "assess_joint_window_protection.py",
+        "finite_reference.py", "boundary_reference.py", "native_host.py",
+        "validate_joint_window_repair.py", "validate_analytic_control.py"))]
+    sources = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    protocol = {"schema": "g31.joint_circulation_factor_protocol.v1",
+        "scenarios": [SCENARIOS[1], SCENARIOS[3]], "new_shared_edge": {"from": 10, "to": 7,
+            "length": .5, "speed": 1., "capacity": 1, "entry_headway": .2},
+        "initial_domain": "same 31 public initial actions; all conditional conflicts still run natively",
+        "continuation": {"controller": "strong analytic predictive public windows", "owners": OWNERS,
+            "phase": .11, "first_post_intervention_tick": 10.11, "period": CONTROL_PERIOD,
+            "command_delay": .1, "demand_delay": .02, "compact_projection": False},
+        "horizon": HORIZON, "max_seconds_per_case": args.max_seconds_per_case, "max_events": 100000,
+        "protection": "all offered vs ordinary and WAIT, plus prefix P/U0/U1 vs WAIT",
+        "comparison_scope": "within this new shared synthetic graph/H only; no subtraction from old absorbing graph",
+        "novelty": "not_established; no training; all negative outcomes retained"}
+    write(args.output / "protocol.json", protocol)
+    receipt = {"schema": "g31.joint_circulation_factor.v1", "status": "running", "cases": [],
+               "source_before": sources, "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(),
+               "protocol_sha256": hashlib.sha256((args.output / "protocol.json").read_bytes()).hexdigest()}
+    write(args.output / "receipt.json", receipt)
+    native = load_native(args.binary)
+    public_worlds = []
+    try:
+        for spec in protocol["scenarios"]:
+            folder = args.output / spec["name"]
+            folder.mkdir()
+            data = circulation_factor_input(spec)
+            parent, state, publications = common_prefix(native, data)
+            observed = parent.observe("A")
+            public_worlds.append(observed)
+            domain = build_domain(observed)
+            assert domain["status"] == "complete_finite_public_domain" and len(domain["actions"]) == 31
+            write(folder / "input.json", data)
+            write(folder / "public_domain.json", {"observation": observed, "domain": domain})
+            write(folder / "controller_prefix.json", {"controller_state": state, "publications": publications})
+            parent_before = parent.offline_state_sha256()
+            # Always evaluate the comparison policies first under a wall budget.
+            selected = set(domain["selected"].values()) | {"WAIT"}
+            actions = sorted(domain["actions"], key=lambda a: (a["action_id"] not in selected, a["action_id"]))
+            rows, started = [], time.perf_counter()
+            for index, action in enumerate(actions):
+                if time.perf_counter() - started >= args.max_seconds_per_case:
+                    break
+                branch = parent.fork()
+                initial = submit_action(branch, action, observed)
+                follow = run_online_matching(branch, OWNERS, horizon=HORIZON, predictive=True,
+                    control_period=CONTROL_PERIOD, message_delay=.1, demand_delay=.02,
+                    respect_service_forecasts=True, controller_state=copy.deepcopy(state), compact_projection=False)
+                result = follow["result"]
+                completion = _horizon_completion(result, branch, HORIZON,
+                    follow["status"] if isinstance(follow.get("status"), str) else "invalid_outer_status")
+                row = {"action_id": action["action_id"], "status": "unknown", "completion": completion,
+                       "initial_submission": initial, "initial_conditional_conflicts": action["conditional_conflicts"]}
+                if completion["status"] == "reached":
+                    replay = replay_input(data, initial["submissions"] + follow["submitted"])
+                    row["audit"] = audit_result(replay, result)
+                    row["metrics"] = outcome_cost(result, data["jobs"], HORIZON)
+                    ids = {s["request"]["request_id"] for s in initial["submissions"]}
+                    resolutions = [t for t in result["transfers"] if t["request_id"] in ids]
+                    row["initial_resolutions"] = resolutions
+                    if initial["status"] != "submitted":
+                        row["status"] = "unresolved_submission"
+                    elif any(t["status"] in ("rejected", "failed", "expired", "cancelled") for t in resolutions):
+                        row["status"] = "asynchronous_rejected"
+                    elif len(resolutions) != len(ids) or any(t["status"] != "received" for t in resolutions):
+                        row["status"] = "unresolved_at_horizon"
+                    else:
+                        row["status"] = "verified"
+                    row["TP_business_sequence"] = [r["business_bag_id"] for r in result["receipts"]
+                        if r["tray_id"] == "TP" and r["event"] == "LOAD_START"]
+                    row["TP_cross_zone_return"] = [r for r in result["receipts"]
+                        if r["tray_id"] == "TP" and r["event"] in ("EXPORT_GRANTED", "EMPTY_RECEIVED")]
+                raw = {"initial": initial, "controller_run": follow, "assessment": row}
+                raw_name = f"branch_{index:03d}.json.gz"
+                with gzip.open(folder / raw_name, "wt", encoding="utf-8") as handle:
+                    json.dump(raw, handle, allow_nan=False)
+                row["raw_file"] = raw_name
+                row["raw_sha256"] = hashlib.sha256((folder / raw_name).read_bytes()).hexdigest()
+                rows.append(row)
+            assert parent.offline_state_sha256() == parent_before
+            by_id = {r["action_id"]: r for r in rows}
+            ordinary = by_id[domain["selected"]["ordinary_public_windows"]]
+            wait = by_id["WAIT"]
+            all_ids = sorted(j["business_bag_id"] for j in data["jobs"] if j["arrival"] <= HORIZON)
+            for row in rows:
+                if not all("metrics" in r for r in (row, ordinary, wait)):
+                    continue
+                row["relative_to_ordinary_all_offered"] = compare(row["metrics"], ordinary["metrics"], all_ids)
+                row["relative_to_wait_all_offered"] = compare(row["metrics"], wait["metrics"], all_ids)
+                row["relative_to_wait_precommitted"] = compare(row["metrics"], wait["metrics"], ["P", "U0", "U1"])
+            eligible = [r for r in rows if r["status"] == "verified"
+                        and r.get("relative_to_ordinary_all_offered", {}).get("preserved")]
+            exhaustive = len(rows) == len(actions) and all(r["status"] in ("verified", "asynchronous_rejected") for r in rows)
+            best = min(eligible, key=lambda r: r["metrics"]["cost"], default=None)
+            case = {"scenario": spec, "evaluated": len(rows), "domain_size": 31, "exhaustive": exhaustive,
+                    "strict_bundle_optimality": "optimal_in_this_domain_and_continuation" if exhaustive and best else "unknown",
+                    "global_native_optimality": "unknown", "finite_reference_headroom":
+                    ordinary["metrics"]["cost"] - best["metrics"]["cost"] if best else None,
+                    "qualified_bundle_count": len(eligible), "best_action_id": best["action_id"] if best else None,
+                    "initial_bundle_statuses": {s: sum(r["status"] == s for r in rows) for s in {r["status"] for r in rows}},
+                    "elapsed_seconds": time.perf_counter() - started, "rows": rows,
+                    "policies": {"WAIT": wait, **{name: by_id[key] for name, key in domain["selected"].items()}}}
+            write(folder / "summary.json", case)
+            receipt["cases"].append({k: v for k, v in case.items() if k != "rows"})
+            write(args.output / "receipt.json", receipt)
+        assert public_worlds[0] == public_worlds[1], "unseen_future_changed_initial_public_projection"
+        receipt["initial_public_worlds_identical"] = True
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["traceback"] = traceback.format_exc()
+        raise
+    finally:
+        receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+        receipt["source_changed"] = [p for p in sources if sources[p] != receipt["source_after"][p]]
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "cases": [{"name": c["scenario"]["name"],
+        "evaluated": c["evaluated"], "headroom": c["finite_reference_headroom"],
+        "policies": {name: {"cost": p.get("metrics", {}).get("cost"),
+                              "completed": p.get("metrics", {}).get("completed"),
+                              "TP_bags": p.get("TP_business_sequence")} for name, p in c["policies"].items()}}
+        for c in receipt["cases"]]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_joint_window_feedback.py b/scripts/experiments/g31_ics_circulation/validate_joint_window_feedback.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_joint_window_feedback.py
@@ -0,0 +1,82 @@
+"""Paired native continuation after an actually observed source-demand change."""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+from .finite_reference import _horizon_completion, outcome_cost, service_dominates
+from .joint_window_feedback import repair_observed_source_change
+from .joint_window_repair import build_domain, submit_action
+from .native_host import audit_result, load_native
+from .validate_analytic_control import replay_input, write
+from .validate_joint_window_repair import SCENARIOS, prefix, scenario_input
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), Path(__file__).with_name("joint_window_feedback.py"),
+             Path(__file__).with_name("joint_window_repair.py"), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("finite_reference.py")]
+    sources = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    write(args.output / "protocol.json", {"scenarios": [SCENARIOS[1], SCENARIOS[3]],
+        "boundary": .91, "schedule": ".11 + eight .1 control ticks for both worlds; not triggered by hidden future tape",
+        "intervention": "cancel own uncommitted stale-source promises, preserve remaining assignment, retime after observed change",
+        "comparators": ["frozen_joint", "one_round_observed_source_feedback", "ordinary_public_windows"],
+        "horizon": 5000, "budget": "six full native continuations, no sweep", "novelty": "not_established"})
+    native = load_native(args.binary)
+    receipt = {"schema": "g31.observed_source_feedback.v1", "status": "running", "cases": [],
+               "source_before": sources, "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest()}
+    for scenario in [SCENARIOS[1], SCENARIOS[3]]:
+        data = scenario_input(scenario)
+        parent, publication = prefix(native, data)
+        observation = parent.observe("A")
+        domain = build_domain(observation)
+        rows = []
+        for policy in ("frozen_joint", "one_round_observed_source_feedback", "ordinary_public_windows"):
+            branch = parent.fork()
+            key = "ordinary_public_windows" if policy == "ordinary_public_windows" else "joint_conditional_repair"
+            action = next(a for a in domain["actions"] if a["action_id"] == domain["selected"][key])
+            first = submit_action(branch, action, observation)
+            branch.advance_to(.91)
+            repair = repair_observed_source_change(branch, "A", [s["request"]["request_id"] for s in first["submissions"]]) \
+                     if policy == "one_round_observed_source_feedback" else {"status": "not_requested", "submissions": []}
+            result = branch.result_at(5000)
+            completion = _horizon_completion(result, branch, 5000)
+            if completion["status"] != "reached":
+                raise AssertionError(completion)
+            submissions = first["submissions"] + repair["submissions"]
+            audit = audit_result(replay_input(data, submissions), result)
+            metrics = outcome_cost(result, data["jobs"], 5000)
+            rows.append({"policy": policy, "repair": repair, "initial_submission": first,
+                         "result": result, "metrics": metrics, "audit": audit, "completion": completion})
+        ordinary = rows[2]["metrics"]
+        for row in rows:
+            row["paired_vs_ordinary_all_offered"] = service_dominates(row["metrics"], ordinary)
+        folder = args.output / scenario["name"]
+        folder.mkdir()
+        write(folder / "input.json", data)
+        with gzip.open(folder / "native_continuations.json.gz", "wt", encoding="utf-8") as handle:
+            json.dump(rows, handle, allow_nan=False)
+        receipt["cases"].append({"scenario": scenario, "policies": [{"policy": r["policy"],
+            "cost": r["metrics"]["cost"], "metrics": r["metrics"], "repair_status": r["repair"]["status"],
+            "cancellations": r["repair"].get("cancellations", []),
+            "paired_vs_ordinary_all_offered": r["paired_vs_ordinary_all_offered"]} for r in rows]})
+    receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    receipt["source_changed"] = [p for p in sources if sources[p] != receipt["source_after"][p]]
+    receipt["status"] = "passed"
+    receipt["novelty"] = "not_established; conventional_one_round_feedback_strong_comparator"
+    write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "cases": [{"name": c["scenario"]["name"],
+        "policies": [{k: p[k] for k in ("policy", "cost", "repair_status", "paired_vs_ordinary_all_offered")}
+                     for p in c["policies"]]} for c in receipt["cases"]]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_joint_window_repair.py b/scripts/experiments/g31_ics_circulation/validate_joint_window_repair.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_joint_window_repair.py
@@ -0,0 +1,232 @@
+"""Predeclared bounded P5 branch-C experiment, exclusively native physics."""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .finite_reference import _horizon_completion, outcome_cost, service_dominates
+from .joint_window_repair import build_domain, digest, submit_action
+from .native_host import audit_result, load_native, prepare_input
+from .validate_analytic_control import replay_input, write
+
+
+SCENARIOS = [
+    {"name": "short_shared_receiving", "length": .4, "speed": 1., "future_source": False},
+    {"name": "long_2000m", "length": 2000., "speed": 5., "future_source": False},
+    {"name": "long_5000m", "length": 5000., "speed": 5., "future_source": False},
+    {"name": "long_2000m_unknown_source_demand", "length": 2000., "speed": 5., "future_source": True},
+]
+
+
+def scenario_input(spec: dict) -> dict:
+    edges = [(7, 0, .4, 1.), (8, 1, .4, 1.),
+             (0, 2, spec["length"], spec["speed"]), (1, 2, spec["length"], spec["speed"]),
+             (2, 3, .4, 1.), (2, 4, .6, 1.), (2, 10, .3, 1.),
+             (3, 5, .8, 1.), (4, 6, .8, 1.), (5, 7, .5, 1.), (6, 8, .5, 1.), (9, 2, .8, 1.)]
+    owner = lambda n: "A" if n in (0, 1, 2, 7, 8) else "B" if n in (3, 4) else "C"
+    jobs = [{"business_bag_id": name, "origin": source, "destination": target,
+             "arrival": arrival, "deadline": 4500., "load_seconds": load,
+             "unload_seconds": .1, "hold_seconds": .1, "protected_service": True,
+             "allow_suffix_reroute": True}
+            for name, source, target, arrival, load in
+            [("U0", 7, 0, 0., .1), ("U1", 8, 1, 0., .1),
+             ("D0", 3, 5, 0., .1), ("D1", 4, 6, 0., .1), ("P", 9, 10, 0., .8)]]
+    if spec["future_source"]:
+        # Same public checkpoint as long_2000m. Cannot be used by selection.
+        jobs.append({"business_bag_id": "UNSEEN", "origin": 0, "destination": 10,
+                     "arrival": .9, "deadline": 4500., "load_seconds": .1,
+                     "unload_seconds": .1, "hold_seconds": .1,
+                     "protected_service": True, "allow_suffix_reroute": True})
+    return prepare_input({"schema": "g31.circulation.input.v1",
+        "model_scope": "synthetic predeclared branch-C 2-supply shared incoming capacity; not original map",
+        "node_records": [(n, 1, .05, n, 0, [v for u, v, _, _ in edges if u == n]) for n in range(11)],
+        "edge_records": edges,
+        "node_contracts": [{"node": n, "zone": owner(n), "capacity": 1} for n in range(11)],
+        "edge_contracts": [{"from": u, "to": v, "capacity": 1, "entry_headway": .2}
+                           for u, v, _, _ in edges],
+        "trays": [{"tray_id": "T0", "node": 7}, {"tray_id": "T1", "node": 8},
+                  {"tray_id": "TP", "node": 9}],
+        "jobs": jobs, "transfers": [], "faults": [],
+        "options": {"max_simulation_time": 5001, "max_events": 100000}})
+
+
+def prefix(native, data):
+    parent = native.NativeSession(data)
+    parent.advance_to(.05)
+    forecast = parent.publish_service_forecast("C", "A", "TP", 2, .02)
+    demand = parent.publish_demand("B", "A", .02)
+    if forecast["status"] == "rejected" or demand["status"] == "rejected":
+        raise AssertionError((forecast, demand))
+    parent.advance_to(.11)
+    return parent, {"service_forecast": forecast, "demand": demand}
+
+
+def evaluate(parent, data, observation, action, horizon):
+    started = time.perf_counter()
+    branch = parent.fork()
+    submission = submit_action(branch, action, observation)
+    result = branch.result_at(horizon)
+    completion = _horizon_completion(result, branch, horizon)
+    row = {"action_id": action["action_id"], "submission": submission, "result": result,
+           "completion": completion, "status": "unknown", "conditional_conflicts": action["conditional_conflicts"]}
+    if completion["status"] == "reached":
+        row["audit"] = audit_result(replay_input(data, submission["submissions"]), result)
+        row["metrics"] = outcome_cost(result, data["jobs"], horizon)
+        submitted = {s["request"]["request_id"] for s in submission["submissions"]}
+        row["resolutions"] = [r for r in result["transfers"] if r["request_id"] in submitted]
+        if submission["status"] == "stale_read_set":
+            row["status"] = "unresolved_read_set"
+        elif any(s["reply"].get("status") in ("timeout_unknown", "failed_no_safe_continuation")
+                 for s in submission["submissions"]):
+            row["status"] = "unresolved_submission"
+        elif submission["status"] != "submitted":
+            row["status"] = "rejected_submission"
+        elif any(r["status"] in ("rejected", "failed", "expired", "cancelled") for r in row["resolutions"]):
+            row["status"] = "asynchronous_rejected"
+        elif len(row["resolutions"]) != len(submitted) or any(r["status"] != "received" for r in row["resolutions"]):
+            row["status"] = "unresolved_at_horizon"
+        else:
+            row["status"] = "verified"
+        # Identity excludes request names; equal physical plans are deduplicated.
+        row["physical_sha256"] = digest([{k: r[k] for k in
+            ("time", "event", "tray_id", "business_bag_id", "node", "from", "to") if k in r}
+            for r in result["receipts"] if r["event"] in ("EDGE_ENTER", "EDGE_EXIT", "LOAD_START",
+                "UNLOAD_COMPLETE", "HOLD_COMPLETE", "EMPTY_RECEIVED")])
+    row["elapsed_seconds"] = time.perf_counter() - started
+    return row
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--cases", type=int, default=4)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), Path(__file__).with_name("joint_window_repair.py"),
+             Path(__file__).with_name("analytic_control.py"), Path(__file__).with_name("boundary_reference.py"),
+             Path(__file__).with_name("finite_reference.py"), Path(__file__).with_name("native_host.py")]
+    before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    receipt = {"schema": "g31.joint_window_repair.v1", "status": "running", "source_before": before,
+               "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(), "cases": [],
+               "novelty": "not_established", "P5_gate": "research_candidate",
+               "atomic_multi_owner_commit": False, "global_native_optimality": "unknown"}
+    # Preregister the finite factors, intervention grid, budget and negative
+    # outcomes before executing the first branch. No adaptive winning search.
+    write(args.output / "protocol.json", {"scenarios": SCENARIOS[:args.cases], "horizon": 5000,
+        "max_actions_per_case": 256, "max_seconds_per_case": 120, "source_before": before,
+        "public_domain": "all partial injective 2-tray assignments; point/window/window+longest-incoming-span",
+        "longline_protocol_probe": "at t=2 countermand first already-entered ordinary return; native must refuse without mutation",
+        "continuation": "same mature native S4, no further external control; all original jobs retained",
+        "normal_service": "strict per-job non-worsening relative to ordinary_public_windows under common future",
+        "role": "development falsification; no airport performance or paper novelty claim"})
+    write(args.output / "receipt.json", receipt)
+    public = {}
+    try:
+        native = load_native(args.binary)
+        for spec in SCENARIOS[:args.cases]:
+            folder = args.output / spec["name"]
+            folder.mkdir()
+            data = scenario_input(spec)
+            parent, publication = prefix(native, data)
+            observation = parent.observe("A")
+            public[spec["name"]] = observation
+            domain = build_domain(observation)
+            assert domain["status"] == "complete_finite_public_domain", domain["status"]
+            write(folder / "input.json", data)
+            write(folder / "public_observation.json", observation)
+            write(folder / "domain.json", domain)
+            write(folder / "publication.json", publication)
+            before_parent = parent.offline_state_sha256()
+            rows, started = [], time.perf_counter()
+            for action in domain["actions"]:
+                if time.perf_counter() - started > 120:
+                    break
+                rows.append(evaluate(parent, data, observation, action, 5000))
+            assert parent.offline_state_sha256() == before_parent
+            ordinary = next((r for r in rows if r["action_id"] == domain["selected"]["ordinary_public_windows"]), None)
+            for row in rows:
+                row["paired_service_preserved"] = bool(ordinary and "metrics" in ordinary and "metrics" in row
+                    and service_dominates(row["metrics"], ordinary["metrics"]))
+            protected = [r for r in rows if r["status"] == "verified" and r["paired_service_preserved"]]
+            exhaustive = len(rows) == len(domain["actions"]) and all(r["status"] in
+                ("verified", "asynchronous_rejected", "rejected_submission") for r in rows)
+            best = min(protected, key=lambda r: (r["metrics"]["cost"], r["action_id"]), default=None)
+            comparisons = {}
+            for name, action_id in domain["selected"].items():
+                found = next((r for r in rows if r["action_id"] == action_id), None)
+                comparisons[name] = {k: found[k] for k in ("action_id", "status", "metrics", "paired_service_preserved")
+                                     if found and k in found}
+            # Actual stale owner state check is mutation-free on rejection.
+            stale = parent.fork()
+            stale.advance_to(.8)
+            stale_before = stale.offline_state_sha256()
+            stale_reply = submit_action(stale, domain["actions"][-1], observation)
+            assert stale_reply["status"] == "stale_read_set" and stale.offline_state_sha256() == stale_before
+            inflight_probe = None
+            if spec["length"] >= 2000 and not spec["future_source"]:
+                action = next(a for a in domain["actions"] if a["action_id"] == domain["selected"]["ordinary_public_windows"])
+                inflight = parent.fork()
+                submitted = submit_action(inflight, action, observation)
+                inflight.advance_to(2.)
+                first_id = submitted["submissions"][0]["request"]["request_id"]
+                visible = inflight.observe("A")
+                before_cancel = inflight.offline_state_sha256()
+                cancel = inflight.cancel_transfer_intent(first_id, "A")
+                assert cancel["status"] == "rejected" and cancel["reason"] == "already_committed", cancel
+                assert inflight.offline_state_sha256() == before_cancel
+                actual_tray = next(t for t in visible["trays"] if t["tray_id"] == "T0")
+                assert actual_tray["edge_from"] == 0 and actual_tray["edge_to"] == 2, actual_tray
+                after = inflight.result_at(5000)
+                assert _horizon_completion(after, inflight, 5000)["status"] == "reached"
+                for key in ("jobs", "trays", "receipts", "transfers"):
+                    assert after[key] == ordinary["result"][key], key
+                inflight_probe = {"request_id": first_id, "observed_tray": actual_tray,
+                                  "cancel_reply": cancel, "physics_matches_uncancelled": True}
+                write(folder / "inflight_no_recall.json", inflight_probe)
+            with gzip.open(folder / "native_branches.json.gz", "wt", encoding="utf-8") as handle:
+                json.dump(rows, handle, ensure_ascii=False, allow_nan=False)
+            summary = {"scenario": spec, "domain_size": len(domain["actions"]), "evaluated": len(rows),
+                "exhaustive": exhaustive, "finite_optimality": "optimal_in_enumerated_domain" if exhaustive and best else "unknown",
+                "global_optimality": "unknown", "protected_candidates": len(protected),
+                "distinct_physical_outcomes": len({r["physical_sha256"] for r in rows if "physical_sha256" in r}),
+                "conditional_joint_conflicts": sum(bool(a["conditional_conflicts"]) for a in domain["actions"]),
+                "statuses": {s: sum(r["status"] == s for r in rows) for s in {r["status"] for r in rows}},
+                "policies": comparisons, "best_action_id": best["action_id"] if best else None,
+                "baseline_execution_status": ordinary["status"] if ordinary else "unknown",
+                "headroom_scope": "same_finite_domain_against_complete_baseline" if ordinary and
+                    ordinary["status"] == "verified" else "offline_common_future_outcome_gap_against_failed_requested_baseline",
+                "reference_headroom": ordinary["metrics"]["cost"] - best["metrics"]["cost"] if ordinary and best else None,
+                "stale_read_set_actual_reply": stale_reply, "public_compute_ms": domain["compute_ms"],
+                "longline_inflight_countermand": inflight_probe,
+                "native_reference_seconds": time.perf_counter() - started}
+            write(folder / "summary.json", summary)
+            receipt["cases"].append(summary)
+            write(args.output / "receipt.json", receipt)
+        if "long_2000m_unknown_source_demand" in public:
+            receipt["unknown_future_identical_public_projection"] = (
+                public["long_2000m"] == public["long_2000m_unknown_source_demand"])
+            assert receipt["unknown_future_identical_public_projection"]
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["traceback"] = traceback.format_exc()
+        raise
+    finally:
+        receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+        receipt["source_changed"] = [p for p in paths if before[str(p)] != receipt["source_after"][str(p)]]
+        receipt["source_changed"] = list(map(str, receipt["source_changed"]))
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "cases": [{"name": c["scenario"]["name"],
+        "reference_headroom": c["reference_headroom"], "domain": c["domain_size"],
+        "statuses": c["statuses"]} for c in receipt["cases"]]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/validate_known_service_control.py b/scripts/experiments/g31_ics_circulation/validate_known_service_control.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_known_service_control.py
@@ -0,0 +1,157 @@
+"""Same-information known-service factor on the synthetic coupled graph.
+
+This is a separate physical/information contract from coupled_native_002:
+B2 actually arrives at .5 and loads for 5.8 seconds. Its service forecast is
+published from that observed native loading state with real message delay.
+Point windows are a conventional strong baseline, never hard future grants.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import traceback
+
+from .analytic_control import run_online_matching, transfer_candidates
+from .finite_reference import Intervention, enumerate_interventions, headroom, outcome_cost, service_dominates
+from .native_host import audit_result, load_native, prepare_input
+from .validate_analytic_control import replay_input, write
+from .validate_coupled_control import coupled_input
+
+
+def known_service_input():
+    data = coupled_input(source_min_stock=1)
+    second = next(j for j in data["jobs"] if j["business_bag_id"] == "B2")
+    second.update(arrival=.5, load_seconds=5.8)
+    data["model_scope"] = "synthetic coupled graph; separate observed B2 loading contract factor; not original airport map"
+    return prepare_input(data)
+
+
+def prefix(native, data, *, predictive=False, windows=False, horizon=1.6):
+    session = native.NativeSession(data)
+    session.advance_to(.11)
+    first = run_online_matching(session, ["A", "B", "C"], horizon=.61, predictive=predictive,
+        message_delay=1., demand_delay=.2, respect_service_forecasts=windows)
+    source = session.observe("A")
+    tray = next(t for t in source["trays"] if t["business_bag_id"] == "B2")
+    assert tray["mode"] == "loading", tray
+    reply = session.publish_service_forecast("A", "B", tray["tray_id"], 1, .2)
+    assert reply["status"] not in ("rejected", "timeout_unknown"), reply
+    assert not any(m.get("kind") == "service_forecast" for m in session.observe("B")["delivered_messages"])
+    second = run_online_matching(session, ["A", "B", "C"], horizon=horizon, predictive=predictive,
+        message_delay=1., demand_delay=.2, respect_service_forecasts=windows,
+        controller_state=first["controller_state"])
+    observed = session.observe("B")
+    forecasts = [m for m in observed["delivered_messages"] if m.get("kind") == "service_forecast"]
+    assert len(forecasts) == 1 and forecasts[0]["business_bag_id"] == "B2", forecasts
+    assert abs(forecasts[0]["entry_estimate"] - 6.35) < 1e-8, forecasts
+    assert abs(forecasts[0]["release_estimate"] - 7.4) < 1e-8, forecasts
+    second["submitted"] = first["submitted"] + second["submitted"]
+    second["control_records"] = first["control_records"] + second["control_records"]
+    second["forecast_publication"] = {"source_observation": source, "reply": reply, "delivered": forecasts}
+    return session, second
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), Path(__file__).with_name("analytic_control.py"),
+             Path(__file__).with_name("finite_reference.py"), Path(__file__).with_name("validate_coupled_control.py"),
+             Path(__file__).with_name("native_host.py")]
+    source_before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    receipt = {"schema": "g31.known_service_control.v1", "status": "running", "cases": {},
+        "source_before": source_before, "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(),
+        "scope": "synthetic separate known-demand contract factor; same observations for all policies; no original-map claim",
+        "novelty": "not_established; ordinary public point-window baseline",
+        "normal_service_scope": "post-run per-job paired check under one common future; no universal guarantee"}
+    write(args.output / "receipt.json", receipt)
+    data = known_service_input()
+    write(args.output / "input.json", data)
+    try:
+        native = load_native(args.binary)
+        for policy, predictive, windows in (("reactive", False, False), ("predictive", True, False),
+                                             ("predictive_public_windows", True, True)):
+            folder = args.output / policy
+            folder.mkdir()
+            session, pre = prefix(native, data, predictive=predictive, windows=windows)
+            run = run_online_matching(session, ["A", "B", "C"], horizon=40, predictive=predictive,
+                message_delay=1., demand_delay=.2, respect_service_forecasts=windows,
+                controller_state=pre["controller_state"])
+            run["submitted"] = pre["submitted"] + run["submitted"]
+            run["control_records"] = pre["control_records"] + run["control_records"]
+            run["forecast_publication"] = pre["forecast_publication"]
+            write(folder / "raw.json", run)
+            assert run["status"] == "reached", run["status"]
+            replay = replay_input(data, run["submitted"])
+            audit = audit_result(replay, run["result"])
+            write(folder / "replay_input.json", replay)
+            write(folder / "audit.json", audit)
+            metrics = outcome_cost(run["result"], data["jobs"], 40)
+            receipt["cases"][policy] = {"metrics": metrics, "requests": run["submitted"], "audit": audit}
+            write(args.output / "receipt.json", receipt)
+        for case in receipt["cases"].values():
+            case["service_preserved_vs_reactive"] = service_dominates(case["metrics"], receipt["cases"]["reactive"]["metrics"])
+
+        # The finite domain is declared from a public observation. Common real
+        # future is used only offline to evaluate the genuine native forks.
+        session, pre = prefix(native, data)
+        observation = session.observe("B")
+        point = transfer_candidates(observation, predictive=True, message_delay=1., request_prefix="finite-point")
+        window = transfer_candidates(observation, predictive=True, message_delay=1., respect_service_forecasts=True,
+                                     request_prefix="finite-window")
+        assert len(point["intents"]) == len(window["intents"]) == 1
+        immediate, safe = point["intents"][0], window["intents"][0]
+        actions = [Intervention("WAIT", "wait"), Intervention("point", "transfer", immediate),
+                   Intervention("public-window", "transfer", safe)]
+        # Offsets relative to the observed estimate are declared, not fitted to
+        # any result. Equal/negative/protected-harming outcomes are retained.
+        for offset in (-1., -.5, -.25, .25, .5, 1., 2.):
+            request = dict(safe, request_id=safe["request_id"] + f":offset:{offset}",
+                           earliest_departure=max(observation["now"], safe["earliest_departure"] + offset))
+            actions.append(Intervention(f"window-offset-{offset}", "transfer", request))
+        write(args.output / "finite_public_domain.json", {"observation": observation, "point": point,
+            "public_window": window, "actions": [{"action_id": a.action_id, "kind": a.kind, "request": a.request} for a in actions]})
+        parent_before = session.offline_state_sha256()
+
+        def continuation(branch, horizon):
+            follow = run_online_matching(branch, ["A", "B", "C"], horizon=horizon, predictive=False,
+                message_delay=1., demand_delay=.2, controller_state=copy.deepcopy(pre["controller_state"]))
+            result = follow["result"]
+            result["offline_continuation_submitted"] = follow["submitted"]
+            return result
+
+        def validate(result, action):
+            submissions = pre["submitted"] + result["offline_continuation_submitted"]
+            if action.kind == "transfer":
+                submissions = submissions + [{"request": action.request, "reply": {"status": "pending"}}]
+            return audit_result(replay_input(data, submissions), result)
+
+        reference = enumerate_interventions(session, actions, horizon=40, job_contracts=data["jobs"],
+            baseline_action_id="WAIT", max_seconds=60, continuation=continuation, validate=validate)
+        write(args.output / "finite_reference.json", reference)
+        assert session.offline_state_sha256() == parent_before, "fork_changed_parent"
+        receipt["finite_reference"] = {k: v for k, v in reference.items() if k != "rows"}
+        receipt["headroom"] = headroom(reference, ["point", "public-window"], "public-window", "public-window")
+        receipt["finite_candidates"] = [{k: v for k, v in row.items() if k not in ("result", "audit")}
+                                         for row in reference["rows"]]
+        receipt["status"] = "passed"  # records service failures separately; no forced improvement assertion
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["traceback"] = traceback.format_exc()
+        raise
+    finally:
+        receipt["source_after"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+        receipt["source_changed"] = [p for p in source_before if source_before[p] != receipt["source_after"][p]]
+        write(args.output / "receipt.json", receipt)
+    print(json.dumps({"status": receipt["status"], "headroom": receipt.get("headroom"),
+        "policies": {k: {"cost": v["metrics"]["cost"], "service_preserved": v["service_preserved_vs_reactive"]}
+                     for k, v in receipt["cases"].items()}}))
+
+
+if __name__ == "__main__":
+    main()
