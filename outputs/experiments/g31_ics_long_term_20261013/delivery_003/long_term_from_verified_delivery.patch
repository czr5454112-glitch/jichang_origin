+            else:
+                result = native.run(data)
+            receipt["native_wall_seconds"] = time.perf_counter()-compute
+            write_json(args.output/"summary.json", summarize_execution(data, result))
+            write_json(args.output/"event_audit.json", audit_result(data, result))
+            with gzip.open(args.output/"business_results.jsonl.gz", "wt", encoding="utf-8") as stream:
+                for spec, job in zip(data["jobs"], result["jobs"], strict=True):
+                    stream.write(json.dumps({"business_bag_id": spec["business_bag_id"], **job})+"\n")
+            with gzip.open(args.output/"physical_events.jsonl.gz", "wt", encoding="utf-8") as stream:
+                for event in result["receipts"]:
+                    stream.write(json.dumps(event)+"\n")
+            if args.retain_result:
+                with gzip.open(args.output/"result.json.gz", "wt", encoding="utf-8") as stream:
+                    json.dump(result, stream)
+            receipt["status"] = "executed_with_complete_offered_denominator"
+        else:
+            receipt["status"] = "prepared_not_executed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["wall_seconds"] = time.perf_counter()-start
+    receipt["adapter_changed"] = digest(Path(__file__)) != receipt["adapter_sha256"]
+    write_json(args.output/"receipt.json", receipt)
+    print(json.dumps(receipt, indent=2))
+    return int(receipt["status"] == "failed" or receipt["adapter_changed"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/experiments/g31_ics_circulation/p5_dependency_repair.py b/scripts/experiments/g31_ics_circulation/p5_dependency_repair.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/p5_dependency_repair.py
@@ -0,0 +1,208 @@
+"""Bounded repair of owned soft intents against newly observed occupancy.
+
+The windows below are *minimum* committed occupancy, not an upper bound on
+release. Unmodelled downstream blocking still requires native execution. This
+module owns no physical state and grants no right to cancel hard commitments.
+"""
+from __future__ import annotations
+
+import copy
+import math
+import time
+
+from .analytic_control import PublicTravel, conditional_service_windows, release_forecasts
+from .boundary_reference import ObligationWindow, capacity_violations
+from .joint_window_repair import _footprint, build_domain, digest, proposal_order, submit_action
+
+
+def local_inflight_minimum_windows(observation: dict) -> list[dict]:
+    """Use only this owner's visible trays and deterministic entry receipts.
+
+    An incoming node entitlement cannot be released before traversal arrival
+    plus its service. It can be held LONGER. No remote occupancy is invented.
+    """
+    travel = PublicTravel(observation)
+    windows = []
+    for tray in observation["trays"]:
+        u, v = int(tray.get("edge_from", -1)), int(tray.get("edge_to", -1))
+        if v < 0 or u < 0 or "edge_exit_at" not in tray:
+            continue
+        arrival = float(tray["edge_exit_at"])
+        if arrival < observation["now"]:
+            continue
+        proof = {"tray_id": tray["tray_id"], "traversal_id": tray["traversal_id"],
+                 "source_owner": observation["owner_id"], "owner_version": observation["version"],
+                 "edge_from": u, "edge_to": v, "edge_exit_at": arrival,
+                 "scope": "minimum_occupancy_only; downstream_blocking_can_extend"}
+        for resource, end in ((f"edge:{u}:{v}", arrival),
+                              (f"node:{v}", arrival + travel.service[v])):
+            if end > observation["now"]:
+                windows.append({"task": "committed:" + tray["tray_id"], "resource": resource,
+                                "start": observation["now"], "end": end, "amount": 1,
+                                "proof": proof})
+    return windows
+
+
+def publish_observed_loaded_dependencies(session, owners: list[str], delay: float = .02) -> list[dict]:
+    """Publish one actual local loaded next hop to its lawful resource owner.
+
+    Shortest path is a conditional proposal. The native endpoint rejects an
+    in-flight tray and does not permit forwarding its occupancy to any owner.
+    """
+    publications = []
+    for owner in owners:
+        observed = session.observe(owner)
+        travel = PublicTravel(observed)
+        jobs = {j["business_bag_id"]: j for j in observed["jobs"]}
+        node_owner = {n["node"]: n.get("resource_owner", n["zone"]) for n in observed["node_contracts"]}
+        for tray in observed["trays"]:
+            if tray["mode"] not in ("loading", "loaded") or tray.get("edge_to", -1) >= 0:
+                continue
+            job = jobs.get(tray["business_bag_id"])
+            if job is None:
+                continue
+            destination = job["storage_node"] if job.get("storage_node", -1) >= 0 and job.get("storage_released_at", -1) < 0 else job["destination"]
+            path = travel.path(tray["node"], destination)[1]
+            if len(path) < 2:
+                continue
+            nxt = path[1]
+            reply = session.publish_service_forecast(owner, node_owner[nxt], tray["tray_id"], nxt, delay)
+            publications.append({"source_owner": owner, "target_owner": node_owner[nxt],
+                                 "tray_id": tray["tray_id"], "next": nxt, "observed_at": observed["now"],
+                                 "delay": delay, "reply": reply,
+                                 "information_scope": "actual_local_loaded_service; conditional_next_hop"})
+    return publications
+
+
+def _overlaps(footprint, windows):
+    return [(a, b) for a in footprint for b in windows
+            if a["resource"] == b["resource"] and a["start"] < b["end"] and b["start"] < a["end"]]
+
+
+def retime_action_after_minimum_occupancy(action, observation, windows, message_delay=.1):
+    """Right shift past the union of conditional and committed intervals.
+
+    Two independent conditional predictions can overlap. That means their
+    point estimates are inconsistent, not that a legal native continuation is
+    impossible. Candidate movements conservatively avoid BOTH estimates;
+    external prediction conflicts remain explicit and are not certified away.
+    """
+    revised = copy.deepcopy(action)
+    travel = PublicTravel(observation)
+    frozen = [{"task": "service:" + m["message_id"], "resource": f"node:{m['next']}",
+               "start": m["entry_estimate"], "end": m["release_estimate"], "amount": 1}
+              for m in conditional_service_windows(observation)]
+    avoided = frozen + windows
+    for candidate in revised["candidates"]:
+        request = candidate["request"]
+        departure = max(observation["now"] + message_delay, request["earliest_departure"])
+        for _ in range(len(avoided) + 1):
+            footprint = _footprint(observation, candidate["path"], departure,
+                                   candidate["candidate_id"], travel)
+            conflicts = _overlaps(footprint, avoided)
+            if not conflicts:
+                break
+            departure = math.nextafter(max(b["end"] - (a["start"] - departure)
+                                           for a, b in conflicts), math.inf)
+        else:
+            return None
+        suffix = ":observed-occupancy:" + digest({"read": digest(observation), "departure": departure})[:20]
+        candidate["candidate_id"] += suffix
+        request["request_id"] += suffix
+        request["earliest_departure"] = departure
+        request["expiry"] = departure + travel.complete(request["source"], request["destination"]) + 60
+        candidate["predicted_arrival"] = departure + travel.complete(request["source"], request["destination"])
+        candidate["conditional_footprint"] = _footprint(observation, candidate["path"], departure,
+                                                        candidate["candidate_id"], travel)
+        candidate["read_set"].append({"kind": "observed_inflight_minimum_occupancy", "windows": windows})
+    revised["action_id"] = "|".join(c["candidate_id"] for c in revised["candidates"]) or "WAIT"
+    revised["predicted_arrival_sum"] = sum(c["predicted_arrival"] for c in revised["candidates"])
+    capacities = {f"node:{n['node']}": n["capacity"] for n in observation["node_contracts"]}
+    capacities.update({f"edge:{e['from']}:{e['to']}": e["capacity"] for e in observation["edge_contracts"]})
+    capacities.update({f"headway:{e['from']}:{e['to']}": 1 for e in observation["edge_contracts"]})
+    # Test each hard lower bound against proposals separately. Adding both a
+    # service prediction and the same tray's actual occupancy would double-count
+    # one physical tray. This still is not a full hard constraint model.
+    proposed = [w for c in revised["candidates"] for w in c["conditional_footprint"]]
+    revised["conditional_conflicts"] = capacity_violations([ObligationWindow(**w) for w in proposed], capacities)
+    revised["conditional_forecast_conflicts"] = _overlaps(proposed, frozen)
+    revised["inconsistent_fixed_predictions"] = capacity_violations([ObligationWindow(**w) for w in frozen], capacities)
+    revised["certification"] = "conditional_proposal_avoids_each_external_window; external_predictions_not_jointly_certified"
+    revised["observed_minimum_conflicts"] = [pair for c in revised["candidates"]
+                                              for pair in _overlaps(c["conditional_footprint"], windows)]
+    return revised
+
+
+def repair_observed_occupancy(session, owner: str, owned_bundle_ids: list[str], *, max_bundle=2,
+                             trigger="occupancy") -> dict:
+    """Revalidate a bounded soft bundle while preserving its assignments.
+
+    Trigger is an actually observed committed occupancy conflicting with the
+    incumbent schedule. No owner mismatch, active hard grant, or budget failure
+    is silently converted to feasible. Native cancel/submit remain non-atomic.
+    """
+    started = time.perf_counter()
+    if trigger not in ("occupancy", "source"):
+        raise ValueError("dependency_repair:unknown_trigger")
+    observed = session.observe(owner)
+    active = [r for r in observed["transfers"] if r["request_id"] in owned_bundle_ids
+              and r["status"] in ("pending", "undelivered")]
+    hard = [r for r in observed["transfers"] if r["request_id"] in owned_bundle_ids
+            and r["status"] not in ("pending", "undelivered", "cancelled", "rejected", "expired", "received")]
+    windows = local_inflight_minimum_windows(observed) if trigger == "occupancy" else []
+    travel = PublicTravel(observed)
+    forecasts = {f.tray_id: f for f in release_forecasts(observed)}
+    obsolete = {r["request_id"] for r in active if r["tray_id"] not in forecasts
+                or forecasts[r["tray_id"]].node != r["source"]} if trigger == "source" else set()
+    changed = []
+    for request in active:
+        path = travel.path(request["source"], request["destination"])[1]
+        footprint = _footprint(observed, path, max(observed["now"] + .1, request["earliest_departure"]),
+                               request["request_id"], travel)
+        conflicts = _overlaps(footprint, windows)
+        if conflicts or request["request_id"] in obsolete:
+            changed.append({"request_id": request["request_id"], "conflicts": conflicts,
+                            "source_changed": request["request_id"] in obsolete})
+    result = {"status": "no_observed_" + trigger + "_change", "observation": observed,
+              "windows": windows, "changed_dependencies": changed, "frozen_hard_requests": hard,
+              "cancellations": [], "submissions": [], "atomic": False,
+              "normal_service_guarantee": False, "global_optimality": "unknown"}
+    if len(active) > max_bundle:
+        result["status"] = "unknown_domain_budget"
+        return result
+    if not changed:
+        return result
+    retained = {(r["tray_id"], r["source"], r["destination"]) for r in active if r["request_id"] not in obsolete}
+    # This finite experiment closes at most two owned soft requests. It does
+    # not expand across other owners or cancel already committed exports.
+    for request in active:
+        reply = session.cancel_transfer_intent(request["request_id"], owner)
+        result["cancellations"].append({"request_id": request["request_id"], "reply": reply})
+        if reply["status"] != "cancelled":
+            result["status"] = "unknown_partial_repair"
+            return result
+    fresh = session.observe(owner)
+    domain = build_domain(fresh)
+    if domain["status"] != "complete_finite_public_domain":
+        result["status"] = "unknown_partial_repair"
+        result["reason"] = domain["status"]
+        return result
+    options = []
+    for action in domain["actions"]:
+        if {(c["request"]["tray_id"], c["request"]["source"], c["request"]["destination"])
+            for c in action["candidates"]} != retained:
+            continue
+        revised = retime_action_after_minimum_occupancy(action, fresh, windows)
+        if revised and not revised["conditional_conflicts"] and not revised["conditional_forecast_conflicts"] and not revised["observed_minimum_conflicts"]:
+            options.append(revised)
+    result["candidate_count"] = len(options)
+    if not options:
+        result["status"] = "unknown_partial_repair"
+        result["reason"] = "no_conditional_retiming; not_native_infeasibility"
+        return result
+    chosen = min(options, key=proposal_order)
+    reply = submit_action(session, chosen, fresh)
+    result.update({"status": "repair_submitted" if reply["status"] == "submitted" else "unknown_partial_repair",
+                   "selected_action": chosen, "submissions": reply["submissions"], "fresh_observation": fresh,
+                   "compute_ms": 1000 * (time.perf_counter() - started)})
+    return result
diff --git a/scripts/experiments/g31_ics_circulation/p5_receiving_cut_certificate.py b/scripts/experiments/g31_ics_circulation/p5_receiving_cut_certificate.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/p5_receiving_cut_certificate.py
@@ -0,0 +1,113 @@
+"""Offline, deliberately restricted necessary-bound certificate for factor001.
+
+This is a graph/capacity argument under declared circulation contracts, not a
+solver optimality claim. It uses future evaluation targets only OFFLINE and is
+never an online proposal feature. Unsupported models return unknown.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+from .validate_analytic_control import write
+
+
+def reachable(edges, start, target):
+    seen, frontier = {start}, [start]
+    while frontier:
+        node = frontier.pop()
+        if node == target:
+            return True
+        for u, v, *_ in edges:
+            if u == node and v not in seen:
+                seen.add(v)
+                frontier.append(v)
+    return False
+
+
+def certify(data, prefix_receipts, reference, *, boundary=.11, receiving_node=2, duration_threshold=400.):
+    result = {"status": "unknown", "scope": "fixed circulation_factor_006_001 directed graph and finite trays; two baseline target intersection only",
+              "online_use": False, "global_scheduling_optimality": "unknown", "checks": {},
+              "contract_assumptions": ["one business bag per tray", "no unloading before that job's declared destination",
+                  "no creation or teleportation of trays", "incoming reservation of capacity1 begins at edge entry and lasts at least until arrival",
+                  "preserve the already loaded protected prefix jobs; no business cancellation"]}
+    checks = result["checks"]
+    nodes = {n["node"]: n for n in data["node_contracts"]}
+    jobs = {j["business_bag_id"]: j for j in data["jobs"]}
+    trays = {t["tray_id"] for t in data["trays"]}
+    checks["capacity_one_shared_receiving"] = nodes[receiving_node]["capacity"] == 1
+    checks["positive_fixed_edges"] = all(e[2] > 0 and e[3] > 0 for e in data["edge_records"])
+    if not all(checks.values()):
+        return result
+    prefix = [r for r in prefix_receipts if r["time"] <= boundary]
+    current = {}
+    for event in prefix:
+        if event["event"] == "LOAD_START":
+            current[event["tray_id"]] = event["business_bag_id"]
+        elif event["event"] == "UNLOAD_COMPLETE":
+            current.pop(event["tray_id"], None)
+    checks["every_fixed_tray_in_active_prefix_service"] = set(current) == trays
+    checks["protected_direct_prefix_contracts"] = all(jobs[b]["protected_service"] and jobs[b].get("storage_node", -1) < 0 for b in current.values())
+    checks["target_demand_not_already_served_at_boundary"] = not any(r["business_bag_id"] in ("D1", "UNSEEN") and r["event"] == "LOAD_START" for r in prefix)
+    if not all(checks.values()):
+        return result
+    release_nodes = {tray: jobs[bag]["destination"] for tray, bag in current.items()}
+    cut = [e for e in data["edge_records"] if e[1] == receiving_node and e[2] / e[3] >= duration_threshold]
+    remainder = [e for e in data["edge_records"] if e not in cut]
+    checks["cut_exists"] = bool(cut)
+    checks["every_future_available_tray_needs_cut_to_D1_origin"] = all(not reachable(remainder, node, jobs["D1"]["origin"]) for node in release_nodes.values())
+    checks["UNSEEN_loaded_service_needs_cut"] = not reachable(remainder, jobs["UNSEEN"]["origin"], jobs["UNSEEN"]["destination"])
+    checks["direct_distinct_service_identities"] = jobs["UNSEEN"].get("storage_node", -1) < 0 and jobs["D1"].get("storage_node", -1) < 0 and jobs["UNSEEN"]["destination"] != jobs["D1"]["origin"]
+    # Distinct bag IDs/endpoints alone do NOT require distinct crossings: the
+    # tray could unload UNSEEN then reach D1 without recrossing. Exclude this
+    # sequential reuse explicitly, over every cut-free directed path.
+    checks["UNSEEN_release_cannot_supply_D1_without_second_cut"] = not reachable(
+        remainder, jobs["UNSEEN"]["destination"], jobs["D1"]["origin"])
+    checks["nonnegative_physical_origin"] = all(j["arrival"] >= 0 for j in data["jobs"])
+    result.update({"active_prefix_bags": current, "mandatory_next_release_nodes": release_nodes,
+                   "cut_edges": cut, "cut_free_reachability_scope": "all directed paths, not just current S4 or candidate shortest paths"})
+    if not all(checks.values()):
+        return result
+    per = lambda policy: {j["business_bag_id"]: j for j in reference["policies"][policy]["metrics"]["per_job"]}
+    ordinary, wait = per("ordinary_public_windows"), per("WAIT")
+    checks["target_reference_tasks_completed"] = ordinary["D1"]["completed"] and wait["UNSEEN"]["completed"]
+    if not all(checks.values()):
+        return result
+    targets = {"D1": ordinary["D1"]["completed_at"], "UNSEEN": wait["UNSEEN"]["completed_at"]}
+    minimum = min(e[2] / e[3] for e in cut)
+    bound, deadline = 2 * minimum, max(targets.values())
+    result.update({"required_distinct_crossings": ["empty supply before D1 loading", "loaded UNSEEN service"],
+                   "distinctness_reason": "after UNSEEN unloading its tray still needs another cut to D1 origin; if D1 is first, UNSEEN's loaded service separately needs its cut",
+                   "minimum_exclusive_time_per_crossing": minimum, "minimum_total_exclusive_time": bound,
+                   "paired_completion_targets": targets, "available_physical_time_until_both_targets": deadline,
+                   "strict_positive_deficit": bound-deadline,
+                   "status": "proved_target_intersection_impossible_under_declared_contract" if bound > deadline else "bound_inconclusive",
+                   "not_claimed": ["general circulation infeasibility", "impossibility of improving a specified single baseline",
+                       "permission to relax protection", "online access to future targets", "new algorithmic contribution"]})
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--campaign", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise FileExistsError(args.output)
+    directory = args.campaign / "long_2000m_unknown_source_demand"
+    data = json.loads((directory / "input.json").read_text(encoding="utf-8"))
+    reference = json.loads((directory / "summary.json").read_text(encoding="utf-8"))
+    raw_path = directory / reference["policies"]["ordinary_public_windows"]["raw_file"]
+    raw = json.load(gzip.open(raw_path, "rt", encoding="utf-8"))
+    result = certify(data, raw["controller_run"]["result"]["receipts"], reference)
+    result["source_sha256"] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    result["input_sha256"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in (directory / "input.json", directory / "summary.json", raw_path)}
+    write(args.output, result)
+    print(json.dumps({k: result.get(k) for k in ("status", "minimum_total_exclusive_time", "available_physical_time_until_both_targets", "strict_positive_deficit")}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/experiments/g31_ics_circulation/p5_validate_dependency_repair.py b/scripts/experiments/g31_ics_circulation/p5_validate_dependency_repair.py
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/p5_validate_dependency_repair.py
@@ -0,0 +1,202 @@
+"""Frozen causal intervention of two observed dependency boundaries on native006."""
+from __future__ import annotations
+
+import argparse
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import time
+import traceback
+
+from .analytic_control import run_online_matching
+from .assess_joint_window_protection import compare
+from .finite_reference import _horizon_completion, outcome_cost
+from .joint_window_feedback import repair_observed_source_change
+from .joint_window_repair import build_domain, submit_action
+from .native_host import audit_result, load_native
+from .p5_dependency_repair import publish_observed_loaded_dependencies, repair_observed_occupancy
+from .validate_analytic_control import replay_input, write
+from .validate_joint_circulation_factor import HORIZON, OWNERS, common_prefix, circulation_factor_input
+from .validate_joint_window_repair import SCENARIOS
+
+
+POLICIES = ("continuous_strong", "source_only_without_publication",
+            "source_only_with_publication", "two_boundary_dependency")
+
+
+def causal_events(result):
+    """Offline event extraction only, never returned to the online decisions."""
+    events = result["receipts"]
+    return {"shared_receiving_entry_order": [r for r in events if r["event"] == "EDGE_ENTER" and r["to"] == 2],
+            "shared_receiving_departures": [r for r in events if r["event"] == "EDGE_ENTER" and r["from"] == 2],
+            "terminal_departures": [r for r in events if r["event"] == "EDGE_ENTER" and r["from"] == 10],
+            "load_unload": [r for r in events if r["event"] in ("LOAD_START", "UNLOAD_COMPLETE")],
+            "waits": [r for r in events if r["event"] == "RESOURCE_WAIT"]}
+
+
+def execute_branch(native, data, initial_name, policy):
+    session, state, prefix = common_prefix(native, data)
+    observation = session.observe("A")
+    domain = build_domain(observation)
+    action = next(a for a in domain["actions"] if a["action_id"] == domain["selected"][initial_name])
+    initial = submit_action(session, action, observation)
+    session.advance_to(.91)
+    before = {owner: session.observe(owner) for owner in OWNERS}
+    publications = publish_observed_loaded_dependencies(session, OWNERS, .02) \
+        if policy != "source_only_without_publication" else []
+    session.advance_to(.91 + .02)
+    owned = [r["request"]["request_id"] for r in initial["submissions"]]
+    if policy == "source_only_without_publication":
+        source_repair = repair_observed_source_change(session, "A", owned)
+    elif policy in ("source_only_with_publication", "two_boundary_dependency"):
+        source_repair = repair_observed_occupancy(session, "A", owned, trigger="source")
+    else:
+        source_repair = {"status": "not_requested", "submissions": [], "cancellations": []}
+    owned += [r["request"]["request_id"] for r in source_repair["submissions"]]
+    session.advance_to(10.11)
+    second_before = {owner: session.observe(owner) for owner in OWNERS}
+    resource_repair = repair_observed_occupancy(session, "A", owned) \
+        if policy == "two_boundary_dependency" else {"status": "not_requested", "submissions": [], "cancellations": []}
+    follow = run_online_matching(session, OWNERS, horizon=HORIZON, predictive=True, control_period=10.,
+                                 message_delay=.1, demand_delay=.02, respect_service_forecasts=True,
+                                 controller_state=state, compact_projection=False)
+    result = follow["result"]
+    completion = _horizon_completion(result, session, HORIZON, follow["status"])
+    row = {"initial_policy": initial_name, "policy": policy, "completion": completion,
+           "source_repair_status": source_repair["status"], "resource_repair_status": resource_repair["status"],
+           "publications": publications, "source_repair_cancellations": source_repair.get("cancellations", []),
+           "resource_repair_cancellations": resource_repair.get("cancellations", []),
+           "status": "unknown", "causal_events": causal_events(result)}
+    all_submissions = initial["submissions"] + source_repair["submissions"] + resource_repair["submissions"] + follow["submitted"]
+    if completion["status"] == "reached":
+        row["metrics"] = outcome_cost(result, data["jobs"], HORIZON)
+        row["audit"] = audit_result(replay_input(data, all_submissions), result)
+        row["status"] = "verified_complete_execution"
+        row["transfers_by_status"] = {status: sum(t["status"] == status for t in result["transfers"])
+                                      for status in sorted({t["status"] for t in result["transfers"]})}
+        cancelled = {c["request_id"] for repair in (source_repair, resource_repair)
+                     for c in repair.get("cancellations", []) if c["reply"]["status"] == "cancelled"}
+        intervention = initial["submissions"] + source_repair["submissions"] + resource_repair["submissions"]
+        required = {s["request"]["request_id"] for s in intervention} - cancelled
+        resolved = [t for t in result["transfers"] if t["request_id"] in required]
+        row["required_intervention_transfers"] = resolved
+        row["request_protocol_status"] = "verified" if len(resolved) == len(required) and all(
+            t["status"] == "received" for t in resolved) and not any(
+            repair["status"].startswith("unknown") for repair in (source_repair, resource_repair)) else "not_verified"
+    raw = {"prefix": prefix, "initial": initial, "first_boundary_before": before,
+           "source_repair": source_repair, "second_boundary_before": second_before,
+           "resource_repair": resource_repair, "controller_run": follow, "assessment": row}
+    return row, raw
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--max-seconds", type=float, default=180.)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    paths = [Path(__file__), *(Path(__file__).with_name(name) for name in (
+        "p5_dependency_repair.py", "joint_window_repair.py", "joint_window_feedback.py",
+        "analytic_control.py", "native_host.py", "finite_reference.py", "boundary_reference.py",
+        "validate_joint_circulation_factor.py", "validate_joint_window_repair.py", "validate_analytic_control.py"))]
+    before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    archived = args.output / "source_archive"
+    archived.mkdir()
+    for path in paths:
+        (archived / path.name).write_bytes(path.read_bytes())
+    protocol = {"schema": "g31.p5_dependency_repair_protocol.v1", "scenarios": [SCENARIOS[1], SCENARIOS[3]],
+        "physical_contract": "EXACT existing independent circulation factor; no edge/task/capacity/tray changes",
+        "initial_policies": ["ordinary_public_windows", "joint_conditional_repair"], "policies": POLICIES,
+        "first_boundary": {"observed": .91, "publication_delay": .02, "decision": .91+.02,
+                           "scope": "actual local loaded service to lawful next resource owner; source change repair"},
+        "second_boundary": {"observed": 10.11, "scope": "already common control epoch; actual local in-flight minimum occupancy repair"},
+        "continuation": "same existing A/B/C strong public-window continuation, first decision10.11, period10",
+        "candidate_budget": "two owned soft dependencies; same incumbent assignments; no new native authority",
+        "conditional_prediction_semantics": "report inconsistent exterior point estimates separately; proposals conservatively avoid each forecast; never certify exterior feasibility",
+        "reference": "all four predetermined interventions per initial policy; same finite budget, offline only",
+        "information_ablation": "source_only_without_publication has less information; never claim it is the matched-info strongest comparator",
+        "matched_information": ["continuous_strong", "source_only_with_publication", "two_boundary_dependency"],
+        "horizon": HORIZON, "max_seconds": args.max_seconds, "max_events": 100000,
+        "planned_branches": 16, "protection": "all offered vs frozen factor ordinary and WAIT; precommitted P/U0/U1",
+        "global_optimality": "unknown", "novelty": "not_established; bounded dependency repair is a hypothesis"}
+    write(args.output / "protocol.json", protocol)
+    receipt = {"schema": "g31.p5_dependency_repair_receipt.v1", "status": "running", "source_before": before,
+               "binary_sha256": hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(), "cases": [],
+               "protocol_sha256": hashlib.sha256((args.output / "protocol.json").read_bytes()).hexdigest()}
+    write(args.output / "receipt.json", receipt)
+    native = load_native(args.binary)
+    started = time.perf_counter()
+    try:
+        for spec in protocol["scenarios"]:
+            data = circulation_factor_input(spec)
+            directory = args.output / spec["name"]
+            directory.mkdir()
+            old = Path("outputs/experiments/g31_ics_long_term_20261013/p5_joint_circulation_factor_006_001") / spec["name"]
+            reference = json.loads((old / "summary.json").read_text(encoding="utf-8"))
+            old_input = json.loads((old / "input.json").read_text(encoding="utf-8"))
+            assert json.loads(json.dumps(data)) == old_input, "original_factor_contract_changed"
+            write(directory / "input.json", data)
+            rows = []
+            for initial in protocol["initial_policies"]:
+                for policy in POLICIES:
+                    if time.perf_counter() - started >= args.max_seconds:
+                        raise TimeoutError("native_campaign_budget_unknown")
+                    row, raw = execute_branch(native, data, initial, policy)
+                    all_ids = sorted(j["business_bag_id"] for j in data["jobs"])
+                    if "metrics" in row:
+                        for name, baseline in (("ordinary", "ordinary_public_windows"), ("WAIT", "WAIT")):
+                            row["relative_to_frozen_" + name] = compare(row["metrics"], reference["policies"][baseline]["metrics"], all_ids)
+                        row["precommitted_vs_frozen_WAIT"] = compare(row["metrics"], reference["policies"]["WAIT"]["metrics"], ["P", "U0", "U1"])
+                    filename = f"branch_{len(rows):03d}.json.gz"
+                    with gzip.open(directory / filename, "wt", encoding="utf-8") as handle:
+                        json.dump(raw, handle, allow_nan=False)
+                    row["raw_file"] = filename
+                    row["raw_sha256"] = hashlib.sha256((directory / filename).read_bytes()).hexdigest()
+                    rows.append(row)
+            for initial in protocol["initial_policies"]:
+                subset = [r for r in rows if r["initial_policy"] == initial]
+                strong = next(r for r in subset if r["policy"] == "continuous_strong")
+                for row in subset:
+                    row["relative_to_matched_info_strong"] = compare(row["metrics"], strong["metrics"], all_ids)
+            finite_reference = []
+            for initial in protocol["initial_policies"]:
+                subset = [r for r in rows if r["initial_policy"] == initial and r["policy"] in protocol["matched_information"]]
+                strong = next(r for r in subset if r["policy"] == "continuous_strong")
+                qualified = [r for r in subset if r["request_protocol_status"] == "verified"
+                             and r["relative_to_matched_info_strong"]["preserved"]]
+                best = min(qualified, key=lambda r: r["metrics"]["cost"], default=None)
+                finite_reference.append({"initial_policy": initial, "evaluated": len(subset), "domain_size": 3,
+                    "qualified_policies": [r["policy"] for r in qualified], "best_policy": best["policy"] if best else None,
+                    "headroom_relative_to_strong": strong["metrics"]["cost"] - best["metrics"]["cost"] if best else None,
+                    "baseline_request_protocol_status": strong["request_protocol_status"],
+                    "scope": "only three matched-information, predetermined two-boundary interventions; no online future selection",
+                    "global_native_optimality": "unknown"})
+            case = {"scenario": spec, "rows": rows, "frozen_reference_sha256": hashlib.sha256((old / "summary.json").read_bytes()).hexdigest(),
+                    "complete_branches": sum(r["status"] == "verified_complete_execution" for r in rows),
+                    "finite_reference": finite_reference,
+                    "global_optimality": "unknown", "reference_scope": "four interventions, fixed two boundaries and continuation only"}
+            write(directory / "summary.json", case)
+            receipt["cases"].append(case)
+            write(args.output / "receipt.json", receipt)
