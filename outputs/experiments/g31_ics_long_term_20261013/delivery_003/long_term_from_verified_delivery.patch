diff --git a/cpp/ics_core/runtime/circulation_protocol_commands_impl.hpp b/cpp/ics_core/runtime/circulation_protocol_commands_impl.hpp
--- /dev/null
+++ b/cpp/ics_core/runtime/circulation_protocol_commands_impl.hpp
@@ -0,0 +1,182 @@
+#pragma once
+
+namespace czr005::ics {
+
+inline std::string EventDrivenJunctionRuntime::submit_circulation_protocol_command(CirculationProtocolCommandInput input) {
+  if(!circulation_.input.owner_protocol.enabled) return "rejected:owner_protocol_not_enabled";
+  require_checkpoint_safe_boundary();
+  if(runtime_phase_==EventDrivenJunctionRuntimePhase::kIdle || runtime_phase_==EventDrivenJunctionRuntimePhase::kFinalized)
+    throw std::logic_error("circulation:live_session_required");
+  const auto prefix="live:"+std::to_string(input.owner.size())+":"+input.owner+":";
+  if(input.request_id.rfind(prefix,0)!=0 || input.request_id.size()<=prefix.size()) return "rejected:owner_request_namespace_required";
+  bool known=false,target_known=false;
+  for(const auto& node:circulation_.input.nodes) {
+    known=known || circulation_.owner(node.node)==input.owner;
+    target_known=target_known || circulation_.owner(node.node)==input.target_owner;
+  }
+  if(!known) return "rejected:unknown_owner";
+  const bool publication=input.kind=="demand" || input.kind=="service_forecast";
+  if(input.kind!="route" && !publication && input.kind!="withdraw_service_forecast" && input.kind!="cancel_transfer")
+    return "rejected:unknown_command_kind";
+  if(publication && !target_known) return "rejected:unknown_target_owner";
+  if(!std::isfinite(input.message_delay) || input.message_delay<0 || !std::isfinite(input.publication_delay) ||
+     input.publication_delay<0 || !std::isfinite(input.expiry) || !std::isfinite(now_+input.message_delay) ||
+     !std::isfinite(now_+circulation_.input.owner_protocol.timeout)) return "rejected:invalid_command_time";
+  if(input.kind=="route" && circulation_.owner(input.from)!=input.owner) return "rejected:resource_owner_mismatch";
+  if(input.kind=="withdraw_service_forecast" && input.reference_id.empty()==input.reference_request_id.empty())
+    return "rejected:withdraw_requires_one_exact_reference";
+  if(input.kind=="cancel_transfer" && input.reference_id.empty()) return "rejected:missing_transfer_reference";
+  if(input.kind=="cancel_transfer" && input.reference_id.rfind(prefix,0)!=0)
+    return "rejected:reference_not_owned";
+  for(const auto& transfer:circulation_.protocol_requests)
+    if(circulation_.input.transfers[transfer.transfer].request_id==input.request_id)
+      return "rejected:request_identity_conflict";
+  const auto identity=[](const auto& p) {
+    return std::tie(p.request_id,p.owner,p.kind,p.target_owner,p.tray_id,p.business_bag_id,p.reference_id,
+                    p.reference_request_id,p.from,p.next,p.expected_generation,p.expected_traversal,
+                    p.message_delay,p.publication_delay,p.expiry);
+  };
+  for(std::size_t i=0;i<circulation_.protocol_commands.size();++i) {
+    auto& command=circulation_.protocol_commands[i];
+    if(command.input.request_id!=input.request_id) continue;
+    if(identity(command.input)!=identity(input)) return "rejected:request_identity_conflict";
+    ++command.attempt;command.client_status="pending";
+    circulation_schedule("protocol_command_wire",now_+input.message_delay,static_cast<int>(i),command.attempt);
+    circulation_schedule("protocol_command_timeout",now_+circulation_.input.owner_protocol.timeout,static_cast<int>(i),command.attempt);
+    runtime_phase_=EventDrivenJunctionRuntimePhase::kReady;return "pending:retry_enqueued";
+  }
+  CirculationProtocolCommand command;command.input=std::move(input);
+  command.remaining_ack_drops=circulation_.input.owner_protocol.drop_ack_packets;
+  const int index=static_cast<int>(circulation_.protocol_commands.size());
+  circulation_.protocol_commands.push_back(std::move(command));
+  circulation_schedule("protocol_command_wire",now_+circulation_.protocol_commands.back().input.message_delay,index,1);
+  circulation_schedule("protocol_command_timeout",now_+circulation_.input.owner_protocol.timeout,index,1);
+  runtime_phase_=EventDrivenJunctionRuntimePhase::kReady;return "pending:command_enqueued";
+}
+
+inline void EventDrivenJunctionRuntime::circulation_protocol_command_ack(int index,double time,std::uint64_t attempt) {
+  const auto& config=circulation_.input.owner_protocol;
+  const double delivered=time+config.ack_delay,duplicate=delivered+config.duplicate_ack_delay;
+  if(!std::isfinite(delivered) || !std::isfinite(duplicate)) throw std::invalid_argument("circulation:nonfinite_protocol_ack_time");
+  auto& command=circulation_.protocol_commands.at(index);
+  CirculationProtocolCommandAck ack;ack.command=index;ack.sequence=command.next_ack_sequence++;
+  ack.attempt=attempt;ack.observed_at=time;ack.executed_at=command.executed_at;ack.completed_at=command.completed_at;
+  ack.status=command.result_status;ack.reason=command.reason;ack.result_id=command.result_id;
+  const int ai=static_cast<int>(circulation_.protocol_command_acks.size());
+  circulation_.protocol_command_acks.push_back(std::move(ack));
+  circulation_schedule("protocol_command_ack",delivered,ai);
+  if(config.duplicate_acks) circulation_schedule("protocol_command_ack",duplicate,ai);
+}
+
+inline void EventDrivenJunctionRuntime::circulation_protocol_command_complete(const std::string& kind,int native_index,
+    const std::string& status,const std::string& reason,const std::string& result_id,double time) {
+  if(!circulation_.input.owner_protocol.enabled) return;
+  for(std::size_t i=0;i<circulation_.protocol_commands.size();++i) {
+    auto& command=circulation_.protocol_commands[i];
+    const bool same_kind=command.input.kind==kind || (kind=="service_forecast" && command.input.kind=="withdraw_service_forecast");
+    if(!same_kind || command.native_index!=native_index || command.execution_status!="processing") continue;
+    command.execution_status="completed";command.result_status=status;command.reason=reason;
+    command.result_id=result_id;command.completed_at=time;
+    circulation_protocol_command_ack(static_cast<int>(i),time,command.arrived_attempt);
+  }
+}
+
+inline bool EventDrivenJunctionRuntime::circulation_protocol_publication_available(const std::string& kind,int index) {
+  if(!circulation_.input.owner_protocol.enabled) return true;
+  const auto& target=kind=="route" ? circulation_.route_intents.at(index).owner_id :
+      (kind=="demand" ? circulation_.demand_messages.at(index).target_owner : circulation_.service_forecasts.at(index).target_owner);
+  if(circulation_protocol_owner_available(target)) return true;
+  for(auto& command:circulation_.protocol_commands) {
+    const bool same_kind=command.input.kind==kind || (kind=="service_forecast" && command.input.kind=="withdraw_service_forecast");
+    if(same_kind && command.native_index==index && command.execution_status=="processing") command.waiting_for_recipient=true;
+  }
+  return false;
+}
+
+inline bool EventDrivenJunctionRuntime::process_circulation_protocol_command_event(const RuntimeEvent& event) {
+  const double time=event.time;
+  if(event.reason=="protocol_command_timeout") {
+    auto& command=circulation_.protocol_commands.at(event.task_id);
+    if(command.attempt==event.wakeup_generation && command.delivered_attempt<command.attempt) command.client_status="timeout_unknown";
+    return true;
+  }
+  if(event.reason=="protocol_command_ack") {
+    auto& ack=circulation_.protocol_command_acks.at(event.task_id);
+    auto& command=circulation_.protocol_commands.at(ack.command);
+    CirculationReceipt receipt;receipt.time=time;receipt.reason=command.input.request_id+":"+std::to_string(ack.sequence);
+    if(command.remaining_ack_drops>0) {
+      --command.remaining_ack_drops;++ack.dropped_copies;receipt.event="PROTOCOL_COMMAND_ACK_DROPPED";
+    } else {
+      ++ack.delivered_copies;if(ack.delivered_at<0) ack.delivered_at=time;
+      receipt.event="PROTOCOL_COMMAND_ACK_DELIVERED";
+      if(ack.sequence>command.delivered_ack_sequence) {command.delivered_ack_sequence=ack.sequence;command.latest_ack=event.task_id;}
+      command.delivered_attempt=std::max(command.delivered_attempt,ack.attempt);
+      if(command.delivered_attempt>=command.attempt) command.client_status="acknowledged";
+    }
+    circulation_.receipts.push_back(std::move(receipt));return true;
+  }
+  if(event.reason!="protocol_command_wire") return false;
+  auto& command=circulation_.protocol_commands.at(event.task_id);
+  const auto& input=command.input;
+  command.arrived_attempt=std::max(command.arrived_attempt,event.wakeup_generation);
+  if(!circulation_protocol_owner_available(input.owner)) {
+    command.waiting_for_owner=true;command.waiting_attempt=std::max(command.waiting_attempt,event.wakeup_generation);return true;
+  }
+  if(command.execution_status!="enqueued") {
+    circulation_protocol_command_ack(event.task_id,time,event.wakeup_generation);return true;
+  }
+  command.execution_status="processing";command.executed_at=time;
+  std::string response;
+  if(input.kind=="route") {
+    CirculationRouteIntent route;route.request_id=input.request_id;route.owner_id=input.owner;route.tray_id=input.tray_id;
+    route.business_bag_id=input.business_bag_id;route.from=input.from;route.next=input.next;
+    route.expected_generation=input.expected_generation;route.expected_traversal=input.expected_traversal;route.expiry=input.expiry;
+    command.native_index=static_cast<int>(circulation_.route_intents.size());
+    response=submit_circulation_route(std::move(route),0,true);
+  } else if(input.kind=="demand") {
+    command.native_index=static_cast<int>(circulation_.demand_messages.size());
+    response=publish_circulation_demand(input.owner,input.target_owner,input.publication_delay,true);
+    if(response=="pending") command.result_id=circulation_.demand_messages.back().message_id;
+  } else if(input.kind=="service_forecast") {
+    command.native_index=static_cast<int>(circulation_.service_forecasts.size());
+    response=publish_circulation_service_forecast(input.owner,input.target_owner,input.tray_id,input.next,input.publication_delay,true);
+    if(response=="pending") command.result_id=circulation_.service_forecasts.back().message_id;
+  } else if(input.kind=="withdraw_service_forecast") {
+    std::string original=input.reference_id;
+    if(!input.reference_request_id.empty()) {
+      for(const auto& old:circulation_.protocol_commands)
+        if(old.input.request_id==input.reference_request_id && old.input.owner==input.owner && old.input.kind=="service_forecast" &&
+           old.native_index>=0 && old.execution_status!="enqueued" && old.result_status!="rejected") original=old.result_id;
+    }
+    if(original.empty()) response="rejected:original_forecast_not_executed";
+    else {
+      response=withdraw_circulation_service_forecast(input.owner,original,input.publication_delay,true);
+      for(std::size_t i=0;i<circulation_.service_forecasts.size();++i) {
+        const auto& message=circulation_.service_forecasts[i];
+        if(message.source_owner==input.owner && message.status=="withdrawn" && message.supersedes==original) {
+          command.native_index=static_cast<int>(i);command.result_id=message.message_id;
+          if(message.delivered) response="delivered";
+          else if(response.rfind("duplicate:",0)==0) response="pending";
+          break;
+        }
+      }
+    }
+  } else if(input.kind=="cancel_transfer") {
+    response=cancel_circulation_transfer(input.reference_id,input.owner,true);command.result_id=input.reference_id;
+    if(response=="duplicate:cancelled") response="cancelled";
+  }
+  if(response=="pending") {
+    command.result_status=input.kind=="route" ? "pending_execution" : "pending_delivery";
+    // The peer delivery or true route validation event will produce the final
+    // ACK. A stable retry while waiting may return this honest pending state.
+    return true;
+  }
+  const auto colon=response.find(':');
+  command.result_status=response.substr(0,colon);
+  command.reason=colon==std::string::npos ? "" : response.substr(colon+1);
+  command.execution_status="completed";command.completed_at=time;
+  circulation_protocol_command_ack(event.task_id,time,event.wakeup_generation);
+  return true;
+}
+
+} // namespace czr005::ics
diff --git a/cpp/ics_core/runtime/circulation_protocol_impl.hpp b/cpp/ics_core/runtime/circulation_protocol_impl.hpp
--- /dev/null
+++ b/cpp/ics_core/runtime/circulation_protocol_impl.hpp
@@ -0,0 +1,166 @@
+#pragma once
+
+namespace czr005::ics {
+
+inline bool EventDrivenJunctionRuntime::circulation_protocol_owner_available(const std::string& owner) const {
+  // Closing a half-open outage window is effective at its native timestamp,
+  // even if a same-time physical phase runs before the outage bookkeeping
+  // event. Opening still requires the actual recovery event to clear the
+  // down count. This prevents phase-order and adjacent-window grant gaps.
+  for(const auto& outage:circulation_.input.owner_protocol.outages)
+    if(outage.owner==owner && outage.start<=now_ && now_<outage.end) return false;
+  const auto found=circulation_.protocol_owner_down.find(owner);
+  return found==circulation_.protocol_owner_down.end() || found->second==0;
+}
+inline bool EventDrivenJunctionRuntime::circulation_protocol_transfer_available(int index) const {
+  if(!circulation_.input.owner_protocol.enabled) return true;
+  const auto& request=circulation_.input.transfers.at(index);
+  return circulation_protocol_owner_available(circulation_.owner(request.source)) &&
+         circulation_protocol_owner_available(circulation_.owner(request.destination));
+}
+
+inline std::string EventDrivenJunctionRuntime::submit_circulation_protocol_transfer(
+    CirculationTransfer request,const std::string& owner) {
+  if(!circulation_.input.owner_protocol.enabled) return "rejected:owner_protocol_not_enabled";
+  require_checkpoint_safe_boundary();
+  if(runtime_phase_==EventDrivenJunctionRuntimePhase::kIdle ||
+     runtime_phase_==EventDrivenJunctionRuntimePhase::kFinalized)
+    throw std::logic_error("circulation:live_session_required");
+  const std::string owner_prefix="live:"+std::to_string(owner.size())+":"+owner+":";
+  if(request.request_id.rfind(owner_prefix,0)!=0 || request.request_id.size()<=owner_prefix.size())
+    return "rejected:owner_request_namespace_required";
+  if(circulation_.owner(request.source)!=owner) return "rejected:resource_owner_mismatch";
+  for(const auto& command:circulation_.protocol_commands)
+    if(command.input.request_id==request.request_id) return "rejected:request_identity_conflict";
+  // Match a client-owned immutable payload before time/physical-tray checks:
+  // an exact retry after departure or expiry must not allocate another tray.
+  for(std::size_t i=0;i<circulation_.protocol_requests.size();++i) {
+    auto& known=circulation_.protocol_requests[i];
+    const auto& old=circulation_.input.transfers[known.transfer];
+    if(old.request_id!=request.request_id) continue;
+    if(known.owner!=owner) return "rejected:request_not_owned";
+    if(old.tray_id!=request.tray_id || old.source!=request.source || old.destination!=request.destination ||
+       old.earliest_departure!=request.earliest_departure || old.expiry!=request.expiry ||
+       old.message_delay!=request.message_delay) return "rejected:request_identity_conflict";
+    if(!std::isfinite(now_+old.message_delay) || !std::isfinite(now_+circulation_.input.owner_protocol.timeout))
+      return "rejected:invalid_protocol_time";
+    ++known.attempt;known.client_status="pending";
+    circulation_schedule("protocol_resend",now_+old.message_delay,static_cast<int>(i),known.attempt);
+    circulation_schedule("protocol_timeout",now_+circulation_.input.owner_protocol.timeout,static_cast<int>(i),known.attempt);
+    runtime_phase_=EventDrivenJunctionRuntimePhase::kReady;
+    return "pending:retry_enqueued";
+  }
+  if(!std::isfinite(now_+circulation_.input.owner_protocol.timeout)) return "rejected:invalid_protocol_time";
+  const auto visible=std::find_if(circulation_.trays.begin(),circulation_.trays.end(),[&](const auto& tray) {
+    return tray.tray_id==request.tray_id && circulation_.owner(tray.node)==owner;
+  });
+  if(visible==circulation_.trays.end()) return "rejected:tray_not_locally_visible";
+  const int physical=static_cast<int>(circulation_.transfers.size());
+  const auto reply=submit_circulation_transfer(std::move(request),owner,true);
+  if(reply!="pending") return reply;
+  CirculationProtocolRequest client;client.transfer=physical;client.owner=owner;
+  client.remaining_ack_drops=circulation_.input.owner_protocol.drop_ack_packets;
+  const int index=static_cast<int>(circulation_.protocol_requests.size());
+  circulation_.protocol_requests.push_back(std::move(client));
+  circulation_schedule("protocol_timeout",now_+circulation_.input.owner_protocol.timeout,index,1);
+  return "pending:request_enqueued";
+}
+
+inline void EventDrivenJunctionRuntime::circulation_protocol_send_ack(int index,double time,std::uint64_t attempt) {
+  const auto& config=circulation_.input.owner_protocol;
+  const double delivered=time+config.ack_delay;
+  const double duplicated=delivered+config.duplicate_ack_delay;
+  if(!std::isfinite(delivered) || !std::isfinite(duplicated))
+    throw std::invalid_argument("circulation:nonfinite_protocol_ack_time");
+  auto& client=circulation_.protocol_requests.at(index);
+  const auto& physical=circulation_.transfers.at(client.transfer);
+  CirculationProtocolAck ack;ack.request=index;ack.sequence=client.next_ack_sequence++;
+  ack.attempt=attempt ? attempt : client.attempt;
+  ack.observed_at=time;ack.status=physical.status;ack.reason=physical.reason;
+  if(physical.status=="received") ack.received_at=physical.received_at;
+  const int ai=static_cast<int>(circulation_.protocol_acks.size());
+  circulation_.protocol_acks.push_back(std::move(ack));
+  circulation_schedule("protocol_ack",delivered,ai);
+  if(config.duplicate_acks)
+    circulation_schedule("protocol_ack",duplicated,ai);
+}
+
+inline bool EventDrivenJunctionRuntime::process_circulation_protocol_event(const RuntimeEvent& event) {
+  const double time=event.time;
+  if(event.reason=="protocol_owner_down" || event.reason=="protocol_owner_up") {
+    const auto& outage=circulation_.input.owner_protocol.outages.at(event.task_id);
+    auto& count=circulation_.protocol_owner_down[outage.owner];
+    count+=event.reason=="protocol_owner_down" ? 1 : -1;
+    if(count<0) throw std::logic_error("circulation:owner_outage_generation_corrupt");
+    CirculationReceipt receipt;receipt.time=time;receipt.event=event.reason=="protocol_owner_down" ?
+        "PROTOCOL_OWNER_UNAVAILABLE" : "PROTOCOL_OWNER_RECOVERED";receipt.reason=outage.owner;
+    circulation_.receipts.push_back(std::move(receipt));
+    if(count==0) {
+      for(std::size_t i=0;i<circulation_.protocol_requests.size();++i) {
+        auto& request=circulation_.protocol_requests[i];
+        if(request.waiting_for_owner && circulation_protocol_transfer_available(request.transfer)) {
+          request.waiting_for_owner=false;
+          circulation_schedule("protocol_resend",time,static_cast<int>(i),request.waiting_attempt);
+        }
+      }
+      for(std::size_t i=0;i<circulation_.protocol_commands.size();++i) {
+        auto& command=circulation_.protocol_commands[i];
+        if(command.waiting_for_owner && circulation_protocol_owner_available(command.input.owner)) {
+          command.waiting_for_owner=false;
+          circulation_schedule("protocol_command_wire",time,static_cast<int>(i),command.waiting_attempt);
+        }
+        if(command.waiting_for_recipient) {
+          const std::string kind=command.input.kind=="withdraw_service_forecast" ? "service_forecast" : command.input.kind;
+          if(circulation_protocol_publication_available(kind,command.native_index)) {
+            command.waiting_for_recipient=false;
+            circulation_schedule("control_"+kind,time,command.native_index);
+          }
+        }
+      }
+      // Pending uncommitted requests can resume only at this actual recovery.
+      // Existing traversals/receiving leases never depended on module uptime.
+      circulation_progress(time);
+    }
+    return true;
+  }
+  if(event.reason=="protocol_timeout") {
+    auto& request=circulation_.protocol_requests.at(event.task_id);
+    if(event.wakeup_generation==request.attempt && request.delivered_attempt<request.attempt)
+      request.client_status="timeout_unknown";
+    return true;
+  }
+  if(event.reason=="protocol_resend") {
+    auto& client=circulation_.protocol_requests.at(event.task_id);
+    if(!circulation_protocol_transfer_available(client.transfer)) {
+      client.waiting_for_owner=true;
+      client.waiting_attempt=std::max(client.waiting_attempt,event.wakeup_generation);return true;
+    }
+    if(circulation_.transfers.at(client.transfer).status=="undelivered")
+      circulation_schedule("module_message",time,client.transfer,event.wakeup_generation);
+    else circulation_protocol_send_ack(event.task_id,time,event.wakeup_generation);
+    return true;
+  }
+  if(event.reason=="protocol_ack") {
+    auto& ack=circulation_.protocol_acks.at(event.task_id);
+    auto& client=circulation_.protocol_requests.at(ack.request);
+    CirculationReceipt row;row.time=time;
+    row.reason=circulation_.input.transfers.at(client.transfer).request_id+":"+std::to_string(ack.sequence);
+    if(client.remaining_ack_drops>0) {
+      --client.remaining_ack_drops;++ack.dropped_copies;row.event="PROTOCOL_ACK_DROPPED";
+    } else {
+      ++ack.delivered_copies;
+      if(ack.delivered_at<0) ack.delivered_at=time;
+      row.event="PROTOCOL_ACK_DELIVERED";
+      if(ack.sequence>client.delivered_ack_sequence) {
+        client.delivered_ack_sequence=ack.sequence;client.latest_ack=event.task_id;
+      }
+      client.delivered_attempt=std::max(client.delivered_attempt,ack.attempt);
+      if(client.delivered_attempt>=client.attempt) client.client_status="acknowledged";
+    }
+    circulation_.receipts.push_back(std::move(row));
+    return true;
+  }
+  return process_circulation_protocol_command_event(event);
+}
+
+} // namespace czr005::ics
diff --git a/cpp/ics_core/runtime/circulation_recovery_impl.hpp b/cpp/ics_core/runtime/circulation_recovery_impl.hpp
--- /dev/null
+++ b/cpp/ics_core/runtime/circulation_recovery_impl.hpp
@@ -0,0 +1,139 @@
+#pragma once
+
+namespace czr005::ics {
+
+inline void EventDrivenJunctionRuntime::circulation_forget_resource_wait(int id) {
+  const auto found = circulation_.resource_waits.find(id);
+  if (found == circulation_.resource_waits.end()) return;
+  const auto remove = [id](auto& index, const std::vector<int>& resources) {
+    for (const int resource : resources) {
+      const auto it = index.find(resource);
+      if (it == index.end()) continue;
+      it->second.erase(id);
+      if (it->second.empty()) index.erase(it);
+    }
+  };
+  remove(circulation_.edge_waiters, found->second.edge_indices);
+  remove(circulation_.receiving_waiters, found->second.receiving_nodes);
+  remove(circulation_.ranking_waiters, found->second.ranking_nodes);
+  circulation_.resource_waits.erase(found);
+}
+
+inline bool EventDrivenJunctionRuntime::circulation_wait_for_resources(
+    int id, int node, double time, const EventDecisionTraceRow* trace,
+    int preferred) {
+  if (!circulation_.enabled || id < 0 || id >= static_cast<int>(circulation_.legs.size())) return false;
+  circulation_forget_resource_wait(id);
+  const auto bag = bags_.find(id);
+  if (bag == bags_.end()) return false;
+  const auto& tray = circulation_.trays[circulation_.legs[id].tray];
+  if (tray.active_leg != id || tray.edge_to >= 0 || tray.node != node) return false;
+  CirculationResourceWait wait;
+  wait.runtime_id = id; wait.node = node;
+  double headway_ready = std::numeric_limits<double>::infinity();
+  bool has_static_suffix = false;
+  // Frozen S3/S4 without same-bag handoff may deliberately wait for its first
+  // candidate even when another physical route is free. Only park that policy
+  // when its time-dependent score terms have settled. Otherwise preserve the
+  // native calendar retry: predicting a score crossing needs a separate proof.
+  bool preferred_only = trace != nullptr && trace->candidates.size() > 1 &&
+      preferred >= 0 && !config_.enable_pibt_lite;
+  if (preferred_only) {
+    bool preferred_resource_blocked = false;
+    for (const auto& candidate : trace->candidates) {
+      if (candidate.corridor_next_available > time + event_runtime_detail::kEpsilon ||
+          candidate.target_next_available > time + candidate.travel_time + event_runtime_detail::kEpsilon)
+        preferred_only = false;
+      if (candidate.next_node == preferred)
+        preferred_resource_blocked = candidate.shield_reason == "circulation:entry_headway" ||
+            candidate.shield_reason == "circulation:edge_capacity" ||
+            candidate.shield_reason == "circulation:receiving_full";
+    }
+    preferred_only = preferred_only && preferred_resource_blocked;
+  }
+  if (preferred_only)
+    for (const auto& candidate : trace->candidates) wait.ranking_nodes.push_back(candidate.next_node);
+  for (const int target : graph_.outgoing(node)) {
+    if (preferred_only && target != preferred) continue;
+    const int edge = circulation_.edge_index(node, target);
+    if (edge < 0 || circulation_.input.edges[edge].capacity == 0 ||
+        !circulation_static_reachable(target, bag->second.request.goal)) continue;
+    has_static_suffix = true;
+    const auto reason = circulation_.can_enter(id, node, target, time);
+    if (reason == "circulation:entry_headway") {
+      wait.edge_indices.push_back(edge);
+      headway_ready = std::min(headway_ready, circulation_.next_entry[edge]);
+    } else if (reason == "circulation:edge_capacity") {
+      wait.edge_indices.push_back(edge);
+    } else if (reason == "circulation:receiving_full") {
+      wait.receiving_nodes.push_back(target);
+    } else {
+      // Some candidate is physically available, or a different native/owner
+      // contract is responsible. Keep mature scheduling for that situation.
+      return false;
+    }
+  }
+  wait.static_blocked = !has_static_suffix;
+  wait.generation = circulation_.next_resource_wait_generation++;
+  const auto generation = wait.generation;
+  for (const int edge : wait.edge_indices)
+    circulation_.edge_waiters[edge][id] = generation;
+  for (const int destination : wait.receiving_nodes)
+    circulation_.receiving_waiters[destination][id] = generation;
+  for (const int destination : wait.ranking_nodes)
+    circulation_.ranking_waiters[destination][id] = generation;
+  circulation_.resource_waits.emplace(id, std::move(wait));
+  circulation_receipt(time, "RESOURCE_WAIT", circulation_.legs[id].tray,
+      id, node, -1, has_static_suffix ? "committed_resource_change_required" : "no_static_legal_suffix");
+  if (std::isfinite(headway_ready))
+    circulation_schedule("resource_headway_ready", headway_ready, id, generation);
+  return true;
+}
+
+inline void EventDrivenJunctionRuntime::circulation_notify_ranking_state(int node, double time) {
+  if (!circulation_.enabled) return;
+  const auto found = circulation_.ranking_waiters.find(node);
+  if (found == circulation_.ranking_waiters.end()) return;
+  const auto affected = found->second;
+  for (const auto& waiter : affected)
+    circulation_wake_resource_wait(waiter.first, waiter.second, time,
+                                    "candidate_score_state_changed");
+}
+
+inline void EventDrivenJunctionRuntime::circulation_wake_resource_wait(
+    int id, std::uint64_t generation, double time, const std::string& reason) {
+  const auto found = circulation_.resource_waits.find(id);
+  if (found == circulation_.resource_waits.end() || found->second.generation != generation) return;
+  const int node = found->second.node;
+  circulation_forget_resource_wait(id);
+  if (id < 0 || id >= static_cast<int>(circulation_.legs.size())) return;
+  const auto& tray = circulation_.trays[circulation_.legs[id].tray];
+  if (tray.active_leg != id || tray.node != node || tray.edge_to >= 0 || tray.mode == "quarantined") return;
+  double ready = time;
+  const auto& local = g4irsf14_local_state(node);
+  if (local.has_last_junction_arbitration &&
+      event_runtime_detail::same_timestamp(local.last_junction_arbitration_time, time)) {
+    // Native E4 deliberately permits one arbitration per node/timestamp. A
+    // resource freed after that boundary receives one dispatch quantum, not
+    // an epsilon capacity loophole or a periodic resource poll.
+    ready += std::max(config_.minimum_service_seconds, config_.dispatch_headway_seconds);
+  }
+  circulation_receipt(time, "RESOURCE_WAKE", circulation_.legs[id].tray,
+                      id, node, -1, reason);
+  schedule_junction_wakeup(node, ready);
+}
+
+inline void EventDrivenJunctionRuntime::circulation_notify_resource(
+    bool receiving, int resource, double time, const std::string& reason) {
+  if (!circulation_.enabled) return;
+  const auto& index = receiving ? circulation_.receiving_waiters : circulation_.edge_waiters;
+  const auto found = index.find(resource);
+  if (found == index.end()) return;
+  // Copy only the affected dependency list: wake removes entries in both
+  // reverse indexes and invalidates old headway events by generation.
+  const auto affected = found->second;
+  for (const auto& waiter : affected)
+    circulation_wake_resource_wait(waiter.first, waiter.second, time, reason);
+}
+
+} // namespace czr005::ics
diff --git a/cpp/ics_core/runtime/circulation_runtime_impl.hpp b/cpp/ics_core/runtime/circulation_runtime_impl.hpp
--- a/cpp/ics_core/runtime/circulation_runtime_impl.hpp
+++ b/cpp/ics_core/runtime/circulation_runtime_impl.hpp
@@ -60,10 +60,24 @@
   }
   if (nodes.size() != graph_.node_count())
     throw std::invalid_argument("circulation:node_contract_coverage");
+  const auto& protocol=input.owner_protocol;
+  if(protocol.enabled) {
+    if(!input.transfers.empty()) throw std::invalid_argument("circulation:protocol_disallows_preloaded_transfers");
+    if(!nonnegative(protocol.ack_delay) || !nonnegative(protocol.duplicate_ack_delay) ||
+       !std::isfinite(protocol.timeout) || protocol.timeout<=0 || protocol.drop_ack_packets<0)
+      throw std::invalid_argument("circulation:invalid_owner_protocol");
+    (void)finite_sum({protocol.ack_delay,protocol.duplicate_ack_delay});
+    for(const auto& outage:protocol.outages) {
+      bool known=false;for(const auto& node:input.nodes)
+        known=known || (node.resource_owner.empty() ? node.zone : node.resource_owner)==outage.owner;
+      if(!known || !nonnegative(outage.start) || !std::isfinite(outage.end) || outage.end<=outage.start)
+        throw std::invalid_argument("circulation:invalid_owner_outage");
+    }
+  } else if(!protocol.outages.empty()) throw std::invalid_argument("circulation:owner_outage_requires_protocol");
