+++ b/scripts/experiments/g31_ics_circulation/native_host.py
@@ -0,0 +1,234 @@
+"""Run declared circulation contracts on the compiled G31 host.
+
+No Python simulation clock, routing executor, or inventory is advanced here.
+The potential calculation is the existing mature G31 preprocessing algorithm.
+"""
+from __future__ import annotations
+
+import importlib.util
+import math
+from pathlib import Path
+from typing import Any
+
+from scripts.eval.run_g4irsf28_service_potential import service_aware_potential
+
+
+def load_native(binary: str | Path):
+    path = Path(binary).resolve(strict=True)
+    spec = importlib.util.spec_from_file_location("czr005_circulation", path)
+    if spec is None or spec.loader is None:
+        raise ValueError(f"cannot load native module: {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def prepare_input(data: dict[str, Any]) -> dict[str, Any]:
+    result = dict(data)
+    potential, contract = service_aware_potential(
+        data["node_records"], data["edge_records"], minimum_service_seconds=0.001
+    )
+    result["heuristic_time"] = potential
+    result["potential_contract"] = contract
+    return result
+
+
+def tiny_cycle() -> dict[str, Any]:
+    edges = [(0, 1, 1.0, 1.0), (0, 6, 1.2, 1.0), (1, 2, 1.0, 1.0),
+             (6, 2, 1.0, 1.0), (6, 3, 1.0, 1.0), (2, 3, 1.0, 1.0),
+             (3, 4, 1.0, 1.0), (4, 5, 1.0, 1.0), (5, 0, 1.0, 1.0)]
+    return prepare_input({
+        "schema": "g31.circulation.input.v1",
+        "model_scope": "synthetic on-carrier Storage, per-berth unloading, fixed module ports",
+        "node_records": [(n, 3 if n == 2 else 1, 0.05, n, 0,
+                          [v for u, v, _, _ in edges if u == n]) for n in range(7)],
+        "edge_records": edges,
+        "node_contracts": [{"node": n, "zone": "B" if n in (3, 4) else "A",
+                            "capacity": 1} for n in range(7)],
+        "edge_contracts": [{"from": u, "to": v, "capacity": 1, "entry_headway": 0.2}
+                           for u, v, _, _ in edges],
+        "trays": [{"tray_id": "T0", "node": 0}],
+        "jobs": [
+            {"business_bag_id": "B1", "origin": 0, "destination": 4, "arrival": 0.0,
+             "deadline": 40.0, "storage_node": 2, "storage_release_at": 6.0,
+             "storage_min_dwell": 2.0, "load_seconds": 0.1,
+             "unload_seconds": 0.5, "hold_seconds": 1.25},
+            {"business_bag_id": "B2", "origin": 0, "destination": 4, "arrival": 0.2,
+             "deadline": 60.0, "storage_node": 2, "storage_release_at": 0.0,
+             "storage_min_dwell": 0.25, "load_seconds": 0.1,
+             "unload_seconds": 0.5, "hold_seconds": 1.25},
+        ],
+        "transfers": [{"request_id": "return-T0", "tray_id": "T0", "source": 4,
+                       "destination": 0, "issued_at": 0.1, "message_delay": 0.0,
+                       "earliest_departure": 0.0, "expiry": 50.0}],
+        "faults": [],
+        "options": {"max_simulation_time": 80.0},
+    })
+
+
+def audit_result(data: dict[str, Any], result: dict[str, Any]) -> dict[str, Any]:
+    """Independent consistency checks over executed receipts, not expected success.
+
+    Checks flow conservation, traversal pairs, travel duration, tail headway,
+    business/leg/tray identity separation and causal Storage/reuse bounds.
+    It does not prove optimality or every owner-internal invariant.
+    """
+    assert result["mode"] == "circulation"
+    expected_trays = {t["tray_id"] for t in data["trays"]}
+    assert {t["tray_id"] for t in result["trays"]} == expected_trays
+    assert len(result["trays"]) == len(expected_trays)
+    leg_map = {r["transport_leg_id"]: r for r in result["leg_identities"]}
+    assert len(leg_map) == len(result["leg_identities"])
+    business_ids = {j["business_bag_id"] for j in data["jobs"]}
+    assert not set(leg_map) & business_ids
+    assert not set(leg_map) & expected_trays
+    travel = {(u, v): max(length / speed, 0.001) for u, v, length, speed in data["edge_records"]}
+    edges = {(e["from"], e["to"]): e for e in data["edge_contracts"]}
+    last_entry: dict[tuple[int, int], float] = {}
+    active: dict[int, dict[str, Any]] = {}
+    completed: set[int] = set()
+    physical = {t["tray_id"]: t["node"] for t in data["trays"]}
+    edge_counts = {key: 0 for key in edges}
+    node_contracts = {n["node"]: n for n in data["node_contracts"]}
+    job_specs = {j["business_bag_id"]: j for j in data["jobs"]}
+    transfer_specs = {t["request_id"]: t for t in data["transfers"]}
+    phases = {t: "empty" for t in expected_trays}
+    phase_time = {t: 0.0 for t in expected_trays}
+    lease: dict[str, int] = {}
+    transit_target: dict[str, int] = {}
+    active_load: dict[str, str] = {}
+    actual_completed: dict[str, float] = {}
+
+    def check_berths():
+        counts = {n: 0 for n in node_contracts}
+        for tray_id in expected_trays:
+            # Remote reception is a real owner reservation, and an in-flight
+            # next hop is counted before arrival. Same tray/node is deduplicated.
+            for n in {physical.get(tray_id), transit_target.get(tray_id), lease.get(tray_id)} - {None}:
+                counts[n] += 1
+        for n, count in counts.items():
+            assert count <= node_contracts[n]["capacity"], ("berth or reception oversubscription", n, count)
+
+    check_berths()
+    time = -math.inf
+    for r in result["receipts"]:
+        assert r["time"] + 1e-8 >= time, ("receipt time reversed", r)
+        time = r["time"]
+        tray_id, event = r["tray_id"], r["event"]
+        if event == "LOAD_START":
+            spec = job_specs[r["business_bag_id"]]
+            assert phases[tray_id] == "empty" and tray_id not in active_load
+            assert physical[tray_id] == spec["origin"] and time + 1e-8 >= spec["arrival"]
+            phases[tray_id] = "loading"
+            phase_time[tray_id] = time
+            active_load[tray_id] = r["business_bag_id"]
+        elif event == "LOAD_COMPLETE":
+            spec = job_specs[active_load[tray_id]]
+            assert phases[tray_id] == "loading"
+            assert time + 1e-8 >= phase_time[tray_id] + spec.get("load_seconds", 0)
+            phases[tray_id] = "loaded"
+        elif event == "STORAGE_ENTER":
+            spec = job_specs[active_load[tray_id]]
+            assert phases[tray_id] == "loaded" and physical[tray_id] == spec["storage_node"]
+            phases[tray_id] = "storage"
+            phase_time[tray_id] = time
+        elif event == "STORAGE_RELEASE":
+            spec = job_specs[active_load[tray_id]]
+            assert phases[tray_id] == "storage"
+            assert time + 1e-8 >= max(spec.get("storage_release_at", 0), phase_time[tray_id] + spec.get("storage_min_dwell", 0))
+            phases[tray_id] = "loaded"
+        elif event == "UNLOAD_START":
+            spec = job_specs[active_load[tray_id]]
+            assert phases[tray_id] == "loaded" and physical[tray_id] == spec["destination"]
+            phases[tray_id] = "unloading"
+            phase_time[tray_id] = time
+        elif event == "UNLOAD_COMPLETE":
+            spec = job_specs[active_load[tray_id]]
+            assert phases[tray_id] == "unloading"
+            assert time + 1e-8 >= phase_time[tray_id] + spec["unload_seconds"]
+            actual_completed[active_load[tray_id]] = time
+            phases[tray_id] = "hold"
+            phase_time[tray_id] = time + spec["hold_seconds"]
+        elif event == "HOLD_COMPLETE":
+            assert phases[tray_id] == "hold" and time + 1e-8 >= phase_time[tray_id]
+            phases[tray_id] = "empty"
+            del active_load[tray_id]
+        elif event == "EXPORT_GRANTED":
+            spec = transfer_specs[r["reason"]]
+            assert phases[tray_id] == "empty" and physical[tray_id] == spec["source"]
+            assert node_contracts[spec["source"]]["zone"] != node_contracts[spec["destination"]]["zone"]
+            assert node_contracts[spec["source"]].get("allow_export", True)
+            assert node_contracts[spec["destination"]].get("allow_receive", True)
+            available = sum(phases[t] == "empty" and physical[t] == spec["source"] for t in expected_trays)
+            assert available > node_contracts[spec["source"]].get("export_min_stock", 0)
+            assert time + 1e-8 >= max(spec["issued_at"] + spec["message_delay"], spec["earliest_departure"])
+            assert time <= spec["expiry"] + 1e-8
+            lease[tray_id] = spec["destination"]
+            phases[tray_id] = "empty_transit"
+            check_berths()
+        elif event == "EMPTY_RECEIVED":
+            assert phases[tray_id] == "empty_transit" and physical[tray_id] == lease[tray_id]
+            del lease[tray_id]
+            phases[tray_id] = "empty"
+        elif event == "UNUSED_RECEIVING_RELEASED":
+            assert physical[tray_id] is not None and tray_id not in transit_target
+            lease.pop(tray_id)
+        elif event == "LEG_FAILED":
+            phases[tray_id] = "quarantined"
+        if r["event"] not in ("EDGE_ENTER", "EDGE_EXIT"):
+            continue
+        assert r["tray_id"] in expected_trays
+        assert r["transport_leg_id"] in leg_map
+        identity = leg_map[r["transport_leg_id"]]
+        assert data["trays"][identity["tray"]]["tray_id"] == r["tray_id"]
+        assert r["business_bag_id"] == ("" if identity["job"] < 0 else data["jobs"][identity["job"]]["business_bag_id"])
+        key = (r["from"], r["to"])
+        assert key in travel
+        tid = r["traversal_id"]
+        assert tid > 0
+        if r["event"] == "EDGE_ENTER":
+            assert tid not in active and tid not in completed
+            assert physical[r["tray_id"]] == r["from"]
+            assert phases[tray_id] in ("loaded", "empty_transit")
+            assert r["time"] + 1e-8 >= last_entry.get(key, -math.inf) + edges[key]["entry_headway"]
+            last_entry[key] = r["time"]
+            active[tid] = r
+            physical[r["tray_id"]] = None
+            transit_target[tray_id] = r["to"]
+            edge_counts[key] += 1
+            assert edge_counts[key] <= edges[key]["capacity"]
+        else:
+            assert tid in active, ("exit without unique entry", r)
+            entry = active.pop(tid)
+            assert (entry["tray_id"], entry["from"], entry["to"], entry["transport_leg_id"]) == (
+                r["tray_id"], r["from"], r["to"], r["transport_leg_id"])
+            assert abs(r["time"] - entry["time"] - travel[key]) < 1e-7
+            physical[r["tray_id"]] = r["to"]
+            del transit_target[tray_id]
+            completed.add(tid)
+            edge_counts[key] -= 1
+        check_berths()
+    for tray in result["trays"]:
+        if tray["edge_to"] < 0:
+            assert tray["node"] == physical[tray["tray_id"]]
+    for spec, job in zip(data["jobs"], result["jobs"], strict=True):
+        if job["loaded_at"] >= 0:
+            assert job["loaded_at"] + 1e-8 >= spec["arrival"]
+        if job["storage_released_at"] >= 0:
+            assert job["storage_entered_at"] >= 0
+            assert job["storage_released_at"] + 1e-8 >= max(
+                spec.get("storage_release_at", 0),
+                job["storage_entered_at"] + spec.get("storage_min_dwell", 0))
+        if job["completed_at"] >= 0:
+            assert actual_completed[spec["business_bag_id"]] == job["completed_at"]
+            assert job["loaded_at"] >= 0
+            assert job["completed_at"] >= job["loaded_at"]
+            if spec.get("storage_node", -1) >= 0:
+                assert job["storage_released_at"] >= 0
+            assert job["deadline_met"] == (spec["deadline"] < 0 or job["completed_at"] <= spec["deadline"] + 1e-8)
+    assert result["native_summary"]["reservation_conflicts"] == 0
+    assert result["native_summary"]["physical_fault_edge_entry_violation_count"] == 0
+    assert all(not d["full_astar_used"] for d in result["decisions"])
+    return {"status": "passed", "completed_traversals": len(completed),
+            "open_traversals": len(active), "tray_count": len(expected_trays),
+            "optimality": "unknown", "scope": "independent identity, lifecycle, edge/headway, parked/incoming/reception capacity replay"}
diff --git a/scripts/experiments/g31_ics_circulation/validate_native_cycle.py b/scripts/experiments/g31_ics_circulation/validate_native_cycle.py
new file mode 100644
index 00000000..29a1d295
--- /dev/null
+++ b/scripts/experiments/g31_ics_circulation/validate_native_cycle.py
@@ -0,0 +1,173 @@
+"""Execute and archive the first G31 circulation acceptance campaign.
+
+python -m scripts.experiments.g31_ics_circulation.validate_native_cycle \
+  --binary build_g31_circulation/python/czr005_circulation.cp311-win_amd64.pyd \
+  --output outputs/experiments/g31_ics_circulation_20261013/native_acceptance_001
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import platform
+import sys
+import time
+import traceback
+
+from .native_host import audit_result, load_native, tiny_cycle
+
+
+def scenarios():
+    base = tiny_cycle()
+    yield "same_tray_two_services", base
+    s = deepcopy(base)
+    s["transfers"] = []
+    yield "no_return_control", s
+    s = deepcopy(base)
+    s["jobs"][0]["storage_release_at"] = 20
+    yield "delayed_storage", s
+    s = deepcopy(base)
+    s["node_contracts"][4]["export_min_stock"] = 1
+    yield "source_protection_refusal", s
+    s = deepcopy(base)
+    s["node_contracts"][0]["allow_receive"] = False
+    yield "destination_module_refusal", s
+    s = deepcopy(base)
+    s["transfers"][0].update(message_delay=60, expiry=30)
+    yield "late_expired_message", s
+    s = deepcopy(base)
+    s["trays"].append({"tray_id": "parked-storage", "node": 2})
+    s["options"].update(max_simulation_time=15, max_decisions_per_bag=32)
+    yield "storage_receiving_full", s
+    s = deepcopy(base)
+    s["trays"].append({"tray_id": "reserve-at-source", "node": 5})
+    s["node_contracts"][5]["zone"] = "B"
+    s["jobs"][1]["arrival"] = 25
+    s["transfers"].append({"request_id": "occupy-receiving", "tray_id": "reserve-at-source",
+                           "source": 5, "destination": 0, "issued_at": 1.0,
+                           "message_delay": 0.0, "earliest_departure": 1.0, "expiry": 5.0})
+    yield "empty_receiving_full", s
+    s = deepcopy(base)
+    s["transfers"][0]["expiry"] = 11
+    s["faults"] = [{"from": 4, "to": 5, "start": 0.0, "end": 30.0,
+                     "message_delay": 4.0}]
+    s["options"]["max_simulation_time"] = 40
+    yield "fault_before_departure_lease", s
+    s = deepcopy(base)
+    for e in s["edge_contracts"]:
+        if e["from"] == 0:
+            e["entry_headway"] = 30.0
+    # Both outbound choices have long tail windows; use a single outbound edge
+    # to make the same-edge repeated-entry condition unavoidable in this witness.
+    s["edge_records"] = [e for e in s["edge_records"] if e[:2] != (0, 6)]
+    s["edge_contracts"] = [e for e in s["edge_contracts"] if (e["from"], e["to"]) != (0, 6)]
+    s["node_records"][0] = (0, 1, 0.05, 0, 0, [1])
+    from .native_host import prepare_input
+    yield "headway_survives_unload_and_return", prepare_input(s)
+    for control in (False, True):
+        s = deepcopy(base)
+        s["trays"].append({"tray_id": "T1", "node": 0})
+        # Same finite physical model for the two members of this comparison.
+        for n in s["node_contracts"]:
+            n["capacity"] = 2
+        s["jobs"][1]["storage_release_at"] = 6
+        s["jobs"][1]["unload_seconds"] = 0.5
+        if control:
+            s["transfers"] = []
+        yield "sufficient_trays_no_return" if control else "sufficient_trays_with_return", s
+    s = deepcopy(base)
+    s["options"]["scorer_mode"] = "S3_shortest_potential_only"
+    yield "same_model_S3_reference", s
+
+
+def check_campaign(rows):
+    r = rows["same_tray_two_services"]
+    assert all(j["status"] == "completed" and j["deadline_met"] for j in r["jobs"])
+    assert {j["tray"] for j in r["jobs"]} == {0}
+    assert r["jobs"][1]["loaded_at"] >= r["transfers"][0]["received_at"] > r["jobs"][0]["completed_at"]
+    assert any(d["scorer_effective_id"].startswith("S4") for d in r["decisions"])
+    assert len(r["leg_identities"]) == 5
+    assert len({e["traversal_id"] for e in r["receipts"] if e["event"] == "EDGE_ENTER"}) == 10
+    assert rows["no_return_control"]["jobs"][1]["loaded_at"] < 0
+    assert rows["no_return_control"]["trays"][0]["node"] == 4
+    assert rows["delayed_storage"]["jobs"][1]["loaded_at"] > r["jobs"][1]["loaded_at"] + 13.9
+    for name, reason in (("source_protection_refusal", "source_module_min_stock"),
+                         ("destination_module_refusal", "destination_module_refused"),
+                         ("empty_receiving_full", "receiving_full"),
+                         ("late_expired_message", "departure_lease_expired")):
+        assert rows[name]["transfers"][0]["status"] == "rejected", name
+        assert rows[name]["transfers"][0]["reason"] == reason, name
+    full = rows["storage_receiving_full"]
+    assert full["jobs"][0]["completed_at"] < 0
+    assert full["jobs"][0]["storage_entered_at"] < 0
+    assert full["trays"][1]["node"] == 2
+    failure = rows["fault_before_departure_lease"]
+    assert failure["transfers"][0]["status"] == "failed"
+    assert failure["transfers"][0]["departed_at"] < 0
+    assert failure["trays"][0]["node"] == 4
+    assert failure["trays"][0]["mode"] == "quarantined"
+    assert failure["trays"][0]["reception_node"] == -1
+    assert not any(e["event"] == "EDGE_ENTER" and e["from"] == 4 for e in failure["receipts"])
+    tail = rows["headway_survives_unload_and_return"]
+    entries = [e["time"] for e in tail["receipts"] if e["event"] == "EDGE_ENTER" and e["from"] == 0]
+    assert len(entries) == 2 and entries[1] >= entries[0] + 30 - 1e-8
+    assert all(j["status"] == "completed" for j in tail["jobs"])
+    no_benefit = [[j["completed_at"] for j in rows[key]["jobs"]]
+                  for key in ("sufficient_trays_no_return", "sufficient_trays_with_return")]
+    assert all(t >= 0 for t in no_benefit[0] + no_benefit[1])
+    assert no_benefit[0] == no_benefit[1]
+    assert all(j["status"] == "completed" for j in rows["same_model_S3_reference"]["jobs"])
+    return {"status": "passed", "scenario_count": len(rows),
+            "same_tray_two_service_completion": [j["completed_at"] for j in r["jobs"]],
+            "no_benefit_completion_times": no_benefit[0],
+            "same_model_reference": "S3 feasible executed witness; optimality unknown",
+            "method_claim": "engineering_only; no predictive controller or learning claim"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    out = args.output.absolute()
+    out.mkdir(parents=True, exist_ok=False)
+    receipt = {"command": sys.argv, "python": sys.version, "platform": platform.platform(),
+               "binary": str(args.binary.absolute()), "binary_sha256": hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+               "status": "running", "scenarios": []}
+    source_paths = [Path("cpp/ics_core/runtime/event_driven_junction.hpp"),
+                    Path("cpp/ics_core/runtime/circulation.hpp"),
+                    Path("cpp/ics_core/runtime/circulation_runtime_impl.hpp"),
+                    Path("cpp/ics_core/bindings/circulation.cpp"),
+                    Path(__file__), Path(__file__).with_name("native_host.py")]
+    receipt["source_sha256"] = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in source_paths}
+    start = time.perf_counter()
+    try:
+        native = load_native(args.binary)
+        rows = {}
+        for name, data in scenarios():
+            case_dir = out / name
+            case_dir.mkdir()
+            (case_dir / "input.json").write_text(json.dumps(data, indent=2), encoding="utf-8")
+            result = native.run(data)
+            (case_dir / "result.json").write_text(json.dumps(result, indent=2, allow_nan=False), encoding="utf-8")
+            audit = audit_result(data, result)
+            (case_dir / "audit.json").write_text(json.dumps(audit, indent=2), encoding="utf-8")
+            (case_dir / "events.jsonl").write_text("".join(json.dumps(e)+"\n" for e in result["receipts"]), encoding="utf-8")
+            receipt["scenarios"].append({"name": name, "audit": audit})
+            rows[name] = result
+        receipt["acceptance"] = check_campaign(rows)
+        receipt["status"] = "passed"
+    except Exception:
+        receipt["status"] = "failed"
+        receipt["exception"] = traceback.format_exc()
+    receipt["wall_seconds"] = time.perf_counter() - start
+    receipt["source_changed"] = [str(p) for p in source_paths if hashlib.sha256(p.read_bytes()).hexdigest() != receipt["source_sha256"][str(p)]]
+    (out / "receipt.json").write_text(json.dumps(receipt, indent=2), encoding="utf-8")
+    print(json.dumps(receipt.get("acceptance", receipt), indent=2))
+    return 0 if receipt["status"] == "passed" and not receipt["source_changed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_g31_circulation_input_boundaries.py b/tests/test_g31_circulation_input_boundaries.py
new file mode 100644
index 00000000..4a7b488d
--- /dev/null
+++ b/tests/test_g31_circulation_input_boundaries.py
@@ -0,0 +1,118 @@
+"""Reject malformed physical numbers before advancing the circulation host."""
+from copy import deepcopy
+import math
+import os
+from pathlib import Path
+
+import pytest
+
+from scripts.experiments.g31_ics_circulation.native_host import audit_result, load_native, tiny_cycle
+
+
+@pytest.fixture(scope='module')
+def native():
+    configured = os.environ.get('G31_CIRCULATION_BINARY')
+    if configured:
+        return load_native(configured)
+    folder = Path(__file__).resolve().parents[1] / 'build_g31_circulation' / 'python'
+    binaries = [*folder.glob('czr005_circulation*.pyd'), *folder.glob('czr005_circulation*.so')]
+    assert len(binaries) == 1, 'Build czr005_circulation or set G31_CIRCULATION_BINARY'
+    return load_native(binaries[0])
+
+
+@pytest.mark.parametrize('service', [-1.0, float('nan'), float('inf')])
+def test_invalid_node_service_is_not_silently_clamped(native, service):
+    data = tiny_cycle()
+    row = list(data['node_records'][0]); row[2] = service
+    data['node_records'][0] = row
+    with pytest.raises(ValueError, match='^circulation:invalid_node_service$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('length,speed', [(-1.0, 1.0), (float('nan'), 1.0),
+    (float('inf'), 1.0), (1.0, 0.0), (1.0, -1.0), (1.0, float('nan')), (1.0, float('inf'))])
+def test_invalid_edge_geometry_is_not_silently_clamped_or_scored_infinite(native, length, speed):
+    data = tiny_cycle()
+    data['edge_records'][0] = (0, 1, length, speed)
+    with pytest.raises(ValueError, match='^circulation:invalid_edge_geometry$'):
+        native.run(data)
+
+
+def test_finite_edge_components_cannot_overflow_travel_time(native):
+    data = tiny_cycle()
+    data['edge_records'][0] = (0, 1, 1e308, 1e-308)
+    with pytest.raises(ValueError, match='^circulation:invalid_edge_travel$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('component', ['message', 'load', 'unload_hold', 'fault_notification'])
+def test_finite_times_cannot_overflow_derived_events(native, component):
+    data = tiny_cycle()
+    data['options']['max_simulation_time'] = -1
+    if component == 'message':
+        data['transfers'][0].update(issued_at=1e308, message_delay=1e308)
+    elif component == 'load':
+        data['jobs'][0].update(arrival=1e308, load_seconds=1e308)
+    elif component == 'unload_hold':
+        data['jobs'][0].update(unload_seconds=1e308, hold_seconds=1e308)
+    else:
+        data['faults'] = [dict(**{'from': 0, 'to': 1}, start=1e308,
+                              end=1e308, message_delay=1e308)]
+    with pytest.raises(ValueError, match='^circulation:nonfinite_derived_time$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('shape', ['few_rows', 'few_columns', 'extra_columns'])
+def test_heuristic_shape_is_rejected_at_binding_boundary(native, shape):
+    data = tiny_cycle()
+    if shape == 'few_rows':
+        data['heuristic_time'] = [[0.0]]
+    elif shape == 'few_columns':
+        data['heuristic_time'][0].pop()
+    else:
+        data['heuristic_time'][0].append(0.0)
+    with pytest.raises(ValueError, match='^circulation:invalid_heuristic_shape$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('value', [float('nan'), float('inf'), -1.0])
+def test_unqueried_heuristic_values_also_obey_the_physical_input_contract(native, value):
+    data = tiny_cycle()
+    # The old implementation never queried this cell and accepted NaN here.
+    data['heuristic_time'][0][2] = value
+    with pytest.raises(ValueError, match='^circulation:invalid_heuristic_value$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('kind', ['node', 'edge'])
+def test_duplicate_graph_rows_cannot_be_silently_ignored(native, kind):
+    data = tiny_cycle()
+    data[kind+'_records'].append(deepcopy(data[kind+'_records'][0]))
+    with pytest.raises(ValueError, match='^circulation:invalid_graph_'+kind+'_record$'):
+        native.run(data)
+
+
+@pytest.mark.parametrize('kind', ['node', 'edge'])
+def test_malformed_graph_record_lengths_have_explicit_boundary_reason(native, kind):
+    data = tiny_cycle()
+    data[kind+'_records'][0] = list(data[kind+'_records'][0])[:-1]
+    with pytest.raises(ValueError, match='^circulation:invalid_graph_'+kind+'_record$'):
+        native.run(data)
+
+
+def test_zero_service_and_zero_length_retain_native_minimum_service_contract(native):
+    data = tiny_cycle()
+    row = list(data['node_records'][0]); row[2] = 0.0
+    data['node_records'][0] = row
+    data['edge_records'][0] = (0, 1, 0.0, 1.0)
+    result = native.run(data)
+    audit_result(data, result)
+    assert all(job['status'] == 'completed' for job in result['jobs'])
+    assert math.isfinite(result['physical_clock'])
+    entries = {e['traversal_id']: e for e in result['receipts'] if e['event'] == 'EDGE_ENTER'}
+    used = 0
+    for event in result['receipts']:
+        if event['event'] == 'EDGE_EXIT' and (event['from'], event['to']) == (0, 1):
+            assert event['time']-entries[event['traversal_id']]['time'] == pytest.approx(0.001)
+            used += 1
+    assert used == 2
