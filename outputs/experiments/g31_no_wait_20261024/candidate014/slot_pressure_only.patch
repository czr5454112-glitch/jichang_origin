+    double slot_loss_seconds(int node,double arrival,int ignore_owner) const {
+        const auto start=tick(arrival),until=tick(add_time(arrival,cfg.pressure_window));
+        constexpr std::int64_t duration=2000000;
+        std::int64_t cursor=start,slots=0;
+        const auto& calendar=calendars[node];
+        auto it=calendar.lower_bound(seconds(std::max<std::int64_t>(0,start-duration)));
+        for (;it!=calendar.end() && tick(it->first)<until;++it) {
+            if (it->second.task==ignore_owner) continue;
+            const auto left=std::max(start,tick(it->first));
+            const auto end=std::min(until,tick(it->second.end));
+            if (end<=left) continue;
+            if (left>cursor) {slots+=(left-cursor)/duration;cursor=left;}
+            if (end>cursor) cursor=end;
+        }
+        if (cursor<until) slots+=(until-cursor)/duration;
+        return seconds(duration*(15-slots));
+    }
