+
+    // Inspect only the two existing neighbors of a free 3-second union.
+    // Full mask bits already certify both overlapping 2-second windows.
+    GapWitness inspect_alignment_gap(const Calendar& calendar,std::int64_t arrival,
+                                     int kind,int from,int to,int index,GapDecision& decision) {
+        constexpr std::int64_t duration=2000000,delta=1000000;
+        GapWitness w;w.kind=kind;w.from=from;w.to=to;w.index=index;w.arrival=arrival;
+        ++gap_resource_queries;++decision.queries;
+        auto right=calendar.lower_bound(seconds(arrival));
+        if (right!=calendar.end()) {
+            ++gap_neighbor_visits;++decision.neighbors;
+            w.has_right=true;w.right=tick(right->first);w.right_id=right->second.id;
+            if (w.right<arrival+duration+delta) throw std::logic_error("alignment mask contradicts right neighbor");
+        }
+        if (right!=calendar.begin()) {
+            const auto left=std::prev(right);
+            ++gap_neighbor_visits;++decision.neighbors;
+            w.has_left=true;w.left=tick(left->second.end);w.left_id=left->second.id;
+            if (w.left>arrival) throw std::logic_error("alignment mask contradicts left neighbor");
+        }
+        if (w.has_left && w.has_right) {
+            const auto capacity=(w.right-w.left)/duration;
+            w.before=static_cast<int>(capacity-(arrival-w.left)/duration-(w.right-arrival-duration)/duration-1);
+            const auto later=arrival+delta;
+            w.after=static_cast<int>(capacity-(later-w.left)/duration-(w.right-later-duration)/duration-1);
+            if (w.before<0 || w.before>1 || w.after<0 || w.after>1)
+                throw std::logic_error("invalid integer gap packing loss");
+        }
+        return w;
+    }
